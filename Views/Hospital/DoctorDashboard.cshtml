<script>
     var CurDate = '';
    var labReadyMap = {};
    var prevTotal = 0;

    (function () {
        var d = new Date();
        var dd = String(d.getDate()).padStart(2, '0');
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var yy = d.getFullYear();
        CurDate = dd + '/' + mm + '/' + yy;
        var hdrDate = document.getElementById('hdr-date');
        if (hdrDate) {
            var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
            hdrDate.textContent = mm + '/' + dd + '/' + yy + ' (' + days[d.getDay()] + ')';
        }
    })();

     var chartCase = null, chartFlow = null, chartLab = null;

    function drawCaseChart(done, pending, total) {
        var ctx = document.getElementById('c-case').getContext('2d');
        if (chartCase) chartCase.destroy();
        chartCase = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Done', 'Pending'],
                datasets: [{
                    data: total ? [done, pending] : [1],
                    backgroundColor: total ? ['#10b981', '#f59e0b'] : ['#e5e7eb'],
                    borderWidth: 2, borderColor: '#fff'
                }]
            },
            options: {
                cutout: '62%', responsive: false,
                plugins: {
                    legend: {
                        display: true, position: 'bottom',
                        labels: { font: { size: 12, weight: '600' }, color: '#374151', usePointStyle: true, pointStyleWidth: 10, padding: 14 }
                    },
                    tooltip: { callbacks: { label: function (ctx) { return ' ' + ctx.label + ': ' + ctx.raw; } } }
                }
            }
        });
    }

    function drawFlowChart(newPt, revisit) {
        var ctx = document.getElementById('c-flow').getContext('2d');
        if (chartFlow) chartFlow.destroy();
        chartFlow = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['New Patients', 'Revisit Patients'],
                datasets: [
                    { label: 'New Patients',    data: [newPt, 0],    backgroundColor: 'rgba(236,72,153,0.8)',  borderColor: '#ec4899', borderWidth: 2, borderRadius: 8, borderSkipped: false, barThickness: 60 },
                    { label: 'Revisit Patients', data: [0, revisit], backgroundColor: 'rgba(139,92,246,0.8)',  borderColor: '#8b5cf6', borderWidth: 2, borderRadius: 8, borderSkipped: false, barThickness: 60 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'bottom', labels: { font: { size: 12, weight: '600' }, color: '#374151', usePointStyle: true, pointStyleWidth: 10, boxHeight: 6, padding: 16, filter: function (item) { return item.text !== ''; } } },
                    tooltip: { backgroundColor: '#fff', borderColor: '#e5e7eb', borderWidth: 1, titleColor: '#111827', bodyColor: '#374151', padding: 10, callbacks: { label: function (ctx) { var val = ctx.datasetIndex === 0 ? newPt : revisit; return '  ' + ctx.dataset.label + ': ' + val; } } }
                },
                scales: {
                    x: { grid: { display: false, drawBorder: false }, border: { display: false }, ticks: { font: { size: 12, weight: '600' }, color: '#374151' } },
                    y: { beginAtZero: true, grid: { display: false, drawBorder: false, drawOnChartArea: false }, border: { display: false }, ticks: { stepSize: 1, precision: 0, font: { size: 11 }, color: '#6b7280', callback: function (value) { if (Number.isInteger(value)) return value; } } }
                }
            }
        });
    }

    function drawLabChart(ready, pending) {
        var ctx = document.getElementById('c-lab').getContext('2d');
        if (chartLab) chartLab.destroy();
        chartLab = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Lab Ready', 'Lab Pending'],
                datasets: [
                    { label: 'Lab Ready',   data: [ready, 0],    backgroundColor: 'rgba(26,115,232,0.8)',  borderColor: '#1a73e8', borderWidth: 2, borderRadius: 8, borderSkipped: false, barThickness: 60 },
                    { label: 'Lab Pending', data: [0, pending],  backgroundColor: 'rgba(16,185,129,0.8)',  borderColor: '#10b981', borderWidth: 2, borderRadius: 8, borderSkipped: false, barThickness: 60 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'bottom', labels: { font: { size: 12, weight: '600' }, color: '#374151', usePointStyle: true, pointStyleWidth: 10, boxHeight: 6, padding: 16, filter: function (item) { return item.text !== ''; } } },
                    tooltip: { backgroundColor: '#fff', borderColor: '#e5e7eb', borderWidth: 1, titleColor: '#111827', bodyColor: '#374151', padding: 10, callbacks: { label: function (ctx) { var val = ctx.datasetIndex === 0 ? ready : pending; return '  ' + ctx.dataset.label + ': ' + val; } } }
                },
                scales: {
                    x: { grid: { display: false, drawBorder: false }, border: { display: false }, ticks: { font: { size: 12, weight: '600' }, color: '#374151' } },
                    y: { beginAtZero: true, grid: { display: false, drawBorder: false, drawOnChartArea: false }, border: { display: false }, ticks: { stepSize: 1, precision: 0, font: { size: 11 }, color: '#6b7280', callback: function (value) { if (Number.isInteger(value)) return value; } } }
                }
            }
        });
    }

    function pct(v, t) { return t ? Math.round(v / t * 100) + '%' : '0%'; }

     function refreshAll() {
        document.getElementById('dd-notif').style.display = 'none';
        loadWorksheet();
        loadAdviceData();
        loadCompletedCaseSheets();
    }

     function loadWorksheet() {
        $.ajax({
            type: 'POST', url: '../Revisit/HMS_OPWorkSheetDoctor',
            data: {
                FromDate: CurDate, ToDate: CurDate,
                DoctorId: $('#DoctorId').val() || 0,
                PatientId: $('#PatientId').val() || 0,
                DeptId: (typeof ERPDeptId !== 'undefined' ? ERPDeptId : 0),
                UserId: (typeof ERPUserId !== 'undefined' ? ERPUserId : 0)
            },
            success: function (r) { buildQueue(r || []); },
            error:   function () { $('#dd-loader').hide(); }
        });
    }

    function buildQueue(data) {
        var total = data.length, done = 0, pending = 0, newPt = 0, revisit = 0;
        var today = new Date(), yyyy = today.getFullYear();
        var qHTML = '', pendHTML = '', compHTML = '', pendCnt = 0, compCnt = 0;

        for (var i = 0; i < data.length; i++) {
            var r = data[i];
            var badge = '';
            if (r.IPNumber && r.IPNumber != 0) {
                badge = r.DelFlag == 0
                    ? '<span class="badge b-admit">Admitted</span>'
                    : '<span class="badge b-dis">Discharged</span>';
            } else if (r.Status == 'New') {
                badge = '<span class="badge b-new">New-Reg</span>'; newPt++;
            } else {
                badge = '<span class="badge b-revisit">Re-Visit</span>'; revisit++;
            }

            var age = '—';
            try { age = yyyy - parseInt((r.DOB || '').substring(6, 15) || 0); } catch (e) { }

            var isDone = r.CSFlag && r.CSFlag != 0;
            if (isDone) done++; else pending++;

            var labdot = labReadyMap[r.RevisitId] ? '<span class="lab-dot" title="Lab Result Ready"></span>' : '';
            var rowCls = isDone ? ' class="done-row"' : '';

            qHTML += '<tr' + rowCls + ' ondblclick="goCS(' + r.PatientId + ',' + r.RevisitId + ')">'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (i + 1) + '</td>'
                + '<td style="color:#000;font-size:14px">' + (r.OPNumber || '') + '</td>'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (r.RevisitId || '') + '</td>'
                + '<td style="color:#000;white-space:nowrap;font-size:14px">' + (r.RevisitDate || '') + '</td>'
                + '<td style="color:#000;font-weight:600;font-size:14px">' + (r.PatientName || '') + '</td>'
                + '<td style="color:#000;font-size:14px">' + labdot + (r.Gender || '') + '</td>'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (r.Contact || '') + '</td>'
                + '<td style="color:#000;font-size:14px">' + ((r.ShiftName || '').substring(0, 4)) + '</td>'
                + '<td><span class="token-num">' + (r.TokenNumber || '') + '</span></td>'
                + '<td>' + badge + '</td>'
                + '<td>'
                + (isDone
                    ? '<span class="badge b-done" style="font-size:12px;padding:4px 12px;">Done</span>'
                    : '<span class="badge b-pending action-blink" style="font-size:12px;padding:4px 12px;">Pending</span>')
                + '</td>'
                + '</tr>';

            if (!isDone) {
                pendCnt++;
                pendHTML += '<tr>'
                    + '<td style="color:#000;font-size:14px">' + pendCnt + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.PatientId || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.OPNumber || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.RevisitDate || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.PatientName || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + age + ' / ' + (r.Gender || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.Contact || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.DoctorName || '') + '</td>'
                    + '<td><span class="badge b-pending">Pending</span></td>'
                    + '</tr>';
            }

            if (isDone) {
                compCnt++;
                compHTML += '<tr>'
                    + '<td style="color:#000;font-size:14px">' + compCnt + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.PatientId || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.OPNumber || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.RevisitDate || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.PatientName || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + age + ' / ' + (r.Gender || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.Contact || '') + '</td>'
                    + '<td style="color:#000;font-size:14px">' + (r.DoctorName || '') + '</td>'
                    + '<td><span class="badge b-done">Completed</span></td>'
                    + '</tr>';
            }
        }

        $('#queue-tbody').html(qHTML || '<tr><td colspan="11" class="empty-msg">No patients.</td></tr>');
        $('#qp-total').text('cases: ' + total);
        $('#qp-done').text('▶ Done: ' + done);
        $('#qp-pending').text('▶ Pending: ' + pending);
        $('#sc-total').text(total);
        $('#sc-pending').text(pending);
        $('#sc-done').text(done);
        $('#sc-new').text(newPt);
        $('#sc-revisit').text(revisit);
        drawCaseChart(done, pending, total);
        drawFlowChart(newPt, revisit);

        $('#tb-pendcs').html(pendHTML || '<tr><td colspan="9" class="empty-msg">No pending case sheets.</td></tr>');
        $('#tb-compcs').html(compHTML || '<tr><td colspan="9" class="empty-msg">No completed case sheets yet.</td></tr>');

        if (prevTotal > 0 && total > prevTotal) {
            $('#dd-notif').css('display', 'flex');
            setTimeout(function () { $('#dd-notif').hide(); }, 8000);
        }
        prevTotal = total;
        $('#dd-loader').hide();
    }

     function loadCompletedCaseSheets() {
        $.ajax({
            type: 'POST', url: '../Revisit/HMS_GetCompletedCaseSheets',
            data: {
                FromDate: CurDate, ToDate: CurDate,
                DoctorId: (typeof ERPUserId !== 'undefined' ? ERPUserId : 0),
                DeptId:   (typeof ERPDeptId !== 'undefined' ? ERPDeptId : 0)
            },
            success: function (r) { buildCompleted(r || []); },
            error:   function () { }
        });
    }

    function buildCompleted(data) {
        if (!data.length) return;
        var html = '', cnt = data.length;
        for (var i = 0; i < data.length; i++) {
            var d = data[i];
            html += '<tr>'
                + '<td style="font-weight:600">' + (d.PatientName || d.Patient || '') + '</td>'
                + '<td style="font-size:11px">'  + (d.CompletedTime || d.VisitTime || '') + '</td>'
                + '<td style="font-size:11px">'  + (d.DoctorName || d.Doctor || '') + '</td>'
                + '<td><span class="badge b-done">Completed</span></td>'
                + '</tr>';
        }
        $('#tb-compcs').html(html);
    }

     function loadAdviceData() {
        $.ajax({
            type: 'POST', url: '../Revisit/HMS_DoctorDashboardAdvice',
            data: {
                FromDate: CurDate, ToDate: CurDate,
                DoctorId: $('#DoctorId').val() || 0,
                DeptId: (typeof ERPDeptId !== 'undefined' ? ERPDeptId : 0)
            },
            success: function (res) {
                if (res && res.med !== undefined) {
                    buildMedAdvice(res.med || []);
                    buildLabAdvice(res.lab || []);
                    buildLabResults(res.ready || [], res.pending || []);
                }
            },
            error: function () {
                buildMedAdvice([]); buildLabAdvice([]); buildLabResults([], []);
            }
        });
    }

    function buildMedAdvice(data) {
        var html = '', grouped = {}, order = [];
        for (var i = 0; i < data.length; i++) {
            var d = data[i];
            var key = d.RevisitId ? String(d.RevisitId) : d.PatientName;
            if (!grouped[key]) {
                grouped[key] = {
                    PatientName: d.PatientName || '', RegNo: d.OPNumber || d.RegNo || '—',
                    OPNo: d.RevisitId || d.OPNo || '—', VisitDate: d.RevisitDate || d.VisitDate || '—',
                    Age: d.Age || '—', Sex: d.Gender || d.Sex || '—',
                    Contact: d.Contact || d.Mobile || '—', Doctor: d.DoctorName || d.Doctor || '—',
                    Medicines: [], TotalCount: 0
                };
                order.push(key);
            }
            grouped[key].TotalCount += parseInt(d.Count || d.Qty || 1);
            var medName = (d.MedicineName || '').trim();
            if (medName) grouped[key].Medicines.push(medName);
        }
        for (var j = 0; j < order.length; j++) {
            var g = grouped[order[j]];
            var uniqueMeds = g.Medicines.filter(function (v, i, a) { return a.indexOf(v) === i; });
            html += '<tr>'
                + '<td style="color:#000;font-size:14px">' + (j + 1) + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.RegNo + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.OPNo + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.VisitDate + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.PatientName + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.Age + ' / ' + g.Sex + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.Contact + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.Doctor + '</td>'
                + '<td style="color:#000;font-size:14px">' + (uniqueMeds.length ? uniqueMeds.join(', ') : '—') + '</td>'
                + '</tr>';
        }
        $('#tb-med').html(html || '<tr><td colspan="9" class="empty-msg">No medicine advice.</td></tr>');
        $('#sc-medadvice').text(order.length);
    }

    function buildLabAdvice(data) {
        var html = '', grouped = {}, order = [];
        for (var i = 0; i < data.length; i++) {
            var d = data[i];
            var key = d.RevisitId || d.PatientName;
            if (!grouped[key]) {
                grouped[key] = {
                    PatientName: d.PatientName || '', RegNo: d.OPNumber || d.RegNo || '—',
                    OPNo: d.RevisitId || d.OPNo || '—', VisitDate: d.RevisitDate || d.VisitDate || '—',
                    Age: d.Age || '—', Sex: d.Gender || d.Sex || '—',
                    Contact: d.Contact || d.Mobile || '—', Doctor: d.DoctorName || d.Doctor || '—',
                    Tests: [], Status: d.Status
                };
                order.push(key);
            }
            grouped[key].Tests.push(d.TestName || '');
            if ((d.Status || '').toUpperCase() !== 'DONE') grouped[key].Status = 'PENDING';
        }
        for (var j = 0; j < order.length; j++) {
            var g = grouped[order[j]];
            var isDone = (g.Status || '').toUpperCase() === 'DONE';
            html += '<tr>'
                + '<td style="color:#000;font-size:14px">' + (j + 1) + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.RegNo + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.OPNo + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.VisitDate + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.PatientName + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.Age + ' / ' + g.Sex + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.Contact + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.Doctor + '</td>'
                + '<td style="color:#000;font-size:14px">' + g.Tests.join(', ') + '</td>'
                + '<td><span class="badge ' + (isDone ? 'b-done">Done' : 'b-pending">Pending') + '</span></td>'
                + '</tr>';
        }
        $('#tb-lab').html(html || '<tr><td colspan="10" class="empty-msg">No lab advice.</td></tr>');
        $('#sc-labadvice').text(order.length);
    }

    function buildLabResults(readyList, pendList) {
        labReadyMap = {};
        var readyHTML = '';
        for (var i = 0; i < readyList.length; i++) {
            var r = readyList[i];
            var rdParts = (r.ResultDate || '').toString().split(' ');
            if (r.SubResultId) labReadyMap[r.SubResultId] = true;
            readyHTML += '<tr>'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (i + 1) + '</td>'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (r.OPNumber || '—') + '</td>'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (r.RevisitId || '—') + '</td>'
                + '<td style="color:#000;white-space:nowrap;font-size:14px">' + (rdParts[0] || '—') + '</td>'
                + '<td style="color:#000;font-size:14px">' + (rdParts[1] || '—') + '</td>'
                + '<td style="color:#000;font-weight:600;font-size:14px">' + (r.PatientName || '') + '</td>'
                + '<td style="color:#000;font-size:14px">' + (r.Age || '—') + ' / ' + (r.Gender || '—') + '</td>'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (r.Contact || '—') + '</td>'
                + '<td style="color:#000;font-size:14px">' + (r.DoctorName || '') + '</td>'
                + '<td style="color:#000;font-size:14px">' + (r.SubResultId || '') + '</td>'
                + '<td><span class="badge b-ready">Ready</span></td>'
                + '</tr>';
        }
        $('#tb-lready').html(readyHTML || '<tr><td colspan="11" class="empty-msg">No results ready.</td></tr>');
        $('#sc-labready').text(readyList.length);

        var pendHTML = '';
        for (var k = 0; k < pendList.length; k++) {
            var p = pendList[k];
            var sdParts = (p.SampleDate || '').toString().split(' ');
            pendHTML += '<tr>'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (k + 1) + '</td>'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (p.OPNumber || '—') + '</td>'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (p.RevisitId || '—') + '</td>'
                + '<td style="color:#000;white-space:nowrap;font-size:14px">' + (sdParts[0] || '—') + '</td>'
                + '<td style="color:#000;font-size:14px">' + (sdParts[1] || '—') + '</td>'
                + '<td style="color:#000;font-weight:600;font-size:14px">' + (p.PatientName || '') + '</td>'
                + '<td style="color:#000;font-size:14px">' + (p.Age || '—') + ' / ' + (p.Gender || '—') + '</td>'
                + '<td style="color:#000;font-family:var(--mono);font-size:14px">' + (p.Contact || '—') + '</td>'
                + '<td style="color:#000;font-size:14px">' + (p.DoctorName || '') + '</td>'
                + '<td style="color:#000;font-size:14px">' + (p.SubResultId || '') + '</td>'
                + '<td><span class="badge b-pending">Pending</span></td>'
                + '</tr>';
        }
        $('#tb-lpending').html(pendHTML || '<tr><td colspan="11" class="empty-msg">No pending results.</td></tr>');
        $('#sc-labpending').text(pendList.length);

        var labTotal = readyList.length + pendList.length;
        drawLabChart(readyList.length, pendList.length);
    }

     var _maxAdv = 1;
    function updateAdvBar(barId, val) {
        _maxAdv = Math.max(_maxAdv, val, 1);
        $('#' + barId).css('width', Math.round(val / _maxAdv * 100) + '%');
    }

     function filterTable(input, tbodyId) {
        var term = input.value.toLowerCase().trim();
        var rows = document.getElementById(tbodyId).getElementsByTagName('tr');
        for (var i = 0; i < rows.length; i++) {
            var txt = rows[i].textContent.toLowerCase();
            rows[i].style.display = (!term || txt.indexOf(term) > -1) ? '' : 'none';
        }
    }

     function goCS(pid, vid) {
        sessionStorage.setItem('PatientId', pid);
        sessionStorage.setItem('VisitId', vid);
        window.location = '@Url.Action("CaseSheet","Hospital", new { from = "DoctorDashboard" })';
    }

     $(function () {
        refreshAll();
        setInterval(loadAdviceData, 15000);
        setInterval(loadWorksheet, 60000);
    });
</script>