@{
    ViewBag.Title = "DoctorDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/app_demo/assets/js/Chart.js"></script>
<style>
    :root {
        --blue: #1a73e8;
        --orange: #f59e0b;
        --green: #10b981;
        --red: #ef4444;
        --purple: #8b5cf6;
        --teal: #06b6d4;
        --pink: #ec4899;
        --indigo: #6366f1;
        --font: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        --mono: Consolas, "Courier New", monospace;
        --bg: #f3f4f6;
        --card: #ffffff;
        --border: #e5e7eb;
        --txt: #111827;
        --muted: #6b7280;
        --radius: 10px;
        --shadow: 0 1px 4px rgba(0,0,0,.08);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: var(--font);
        background: var(--bg);
        color: var(--txt);
        font-size: 13px;
    }

    .dd-wrap {
        padding: 20px 24px 48px;
    }

    .stat-row {
        display: grid;
        grid-template-columns: repeat(9, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

    .stat-card {
        border-radius: var(--radius);
        padding: 18px 14px;
        box-shadow: 0 4px 12px rgba(0,0,0,.10);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        gap: 6px;
        border: none;
    }

        .stat-card .sc-label {
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: rgba(255,255,255,0.85);
        }

        .stat-card .sc-val {
            font-size: 32px;
            font-weight: 900;
            font-family: var(--mono);
            line-height: 1;
            color: #fff;
        }

    .analytics-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }

    .a-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .a-card-title {
        font-size: 18px;
        font-weight: 700;
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        border-radius: 8px 8px 0 0;
    }

    .a-card-body {
        padding: 16px 24px;
        min-height: 280px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .donut-wrap {
        display: flex;
        align-items: center;
        gap: 16px;
        min-height: 160px;
    }

    .donut-canvas {
        flex-shrink: 0;
    }

    .donut-legend {
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex: 1;
    }

    .dl-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
    }

    .dl-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dl-label {
        flex: 1;
    }

    .dl-val {
        font-weight: 700;
        font-family: var(--mono);
    }

    .dl-pct {
        font-size: 11px;
        color: var(--muted);
    }

    .adv-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #f3f4f6;
    }

        .adv-row:last-child {
            border-bottom: none;
        }

    .adv-label {
        font-size: 12px;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .adv-bar-wrap {
        flex: 1;
        margin: 0 10px;
        height: 7px;
        background: #f3f4f6;
        border-radius: 99px;
        overflow: hidden;
    }

    .adv-bar {
        height: 100%;
        border-radius: 99px;
    }

    .adv-val {
        font-weight: 700;
        font-size: 13px;
        font-family: var(--mono);
        min-width: 36px;
        text-align: right;
    }

    .queue-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .queue-head {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        border-radius: 8px 8px 0 0;
    }

        .queue-head h3 {
            font-size: 18px;
            font-weight: 700;
        }

    .q-pills {
        display: flex;
        gap: 8px;
    }

    .q-pill {
        padding: 4px 12px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 700;
    }

    .q-pill-blue {
        background: #dbeafe;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

    .q-pill-green {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .q-pill-orange {
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #fed7aa;
    }

    

    .tbl-search {
        padding: 6px 14px 6px 32px;
        border-radius: 99px;
        border: 1px solid var(--border);
        font: 13px var(--font);
        color: var(--txt);
        width: 200px;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
    }

        .tbl-search:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 3px rgba(147,197,253,.3);
            background-color: #fff;
        }

        .tbl-search::placeholder {
            color: var(--muted);
        }

    .tbl-scroll {
        overflow-x: auto;
        padding: 0 16px;
        box-sizing: border-box;
    }

    .data-table {
        width: 100%;
        min-width: 600px;
        border-collapse: collapse;
        font-size: 14px;
        color: #000;
        border: 1px solid var(--border);
    }

        .data-table thead th {
            padding: 10px 14px;
            text-align: left;
            background: #f9fafb;
            border-bottom: 2px solid var(--border);
            border-right: 1px solid var(--border);
            font-size: 14px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--muted);
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 1;
        }

            .data-table thead th:first-child {
                padding-left: 16px;
            }

            .data-table thead th:last-child {
                padding-right: 16px;
                border-right: none;
            }

        .data-table tbody tr {
            border-bottom: 1px solid #e5e7eb;
        }

            .data-table tbody tr:hover {
                background: #f0f9ff;
                cursor: pointer;
            }

            .data-table tbody tr:last-child td {
                border-bottom: 1px solid var(--border);
            }

            .data-table tbody tr.done-row {
                background: #f0fdf4;
            }

                .data-table tbody tr.done-row:hover {
                    background: #dcfce7;
                }

        .data-table td {
            padding: 10px 14px;
            vertical-align: middle;
            border-right: 1px solid var(--border);
            border-bottom: 1px solid #e5e7eb;
        }

            .data-table td:first-child {
                padding-left: 16px;
            }

            .data-table td:last-child {
                padding-right: 16px;
                border-right: none;
            }

        .data-table tfoot td {
            padding: 7px 14px;
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
            background: #f9fafb;
            border-top: 2px solid var(--border);
            border-right: 1px solid var(--border);
        }

            .data-table tfoot td:first-child {
                padding-left: 16px;
            }

            .data-table tfoot td:last-child {
                padding-right: 16px;
                border-right: none;
            }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 99px;
        font-size: 11px;
        font-weight: 700;
    }

    .b-new {
        background: #fff7ed;
        color: #c2410c;
        border: 1px solid #fed7aa;
    }

    .b-revisit {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }

    .b-admit {
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fca5a5;
    }

    .b-dis {
        background: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }

    .b-ready {
        background: #d1fae5;
        color: #065f46;
    }

    .b-done {
        background: #d1fae5;
        color: #065f46;
    }

    .four-row {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px;
        margin-bottom: 20px;
    }

    .p-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        margin-bottom: 0;
    }

    .p-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 24px;
        border-bottom: 1px solid var(--border);
        font-size: 18px;
        font-weight: 700;
        color: #333;
        border-radius: 10px 10px 0 0;
        box-shadow: 0 2px 6px rgba(0,0,0,.08);
    }

        .p-card-head .ph-icon {
            margin-right: 5px;
        }

    .p-count {
        padding: 2px 10px;
        border-radius: 99px;
        font-size: 11px;
        font-weight: 700;
    }

    .pc-blue {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .pc-green {
        background: #d1fae5;
        color: #065f46;
    }

    .pc-orange {
        background: #fff7ed;
        color: #c2410c;
    }

    .pc-red {
        background: #fee2e2;
        color: #b91c1c;
    }

    .mini-tbl {
        width: 100%;
        min-width: 400px;
        border-collapse: collapse;
        font-size: 14px;
        color: #000;
        border: 1px solid var(--border);
    }

        .mini-tbl thead th {
            padding: 8px 12px;
            text-align: left;
            background: #f9fafb;
            border-bottom: 2px solid var(--border);
            border-right: 1px solid var(--border);
            font-size: 14px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--muted);
            position: sticky;
            top: 0;
            z-index: 1;
        }

            .mini-tbl thead th:first-child {
                padding-left: 16px;
            }

            .mini-tbl thead th:last-child {
                padding-right: 16px;
                border-right: none;
            }

        .mini-tbl tbody tr {
            border-bottom: 1px solid #e5e7eb;
        }

            .mini-tbl tbody tr:last-child td {
                border-bottom: 1px solid var(--border);
            }

            .mini-tbl tbody tr:hover {
                background: #f8fafc;
                cursor: pointer;
            }

        .mini-tbl td {
            padding: 8px 12px;
            vertical-align: middle;
            border-right: 1px solid var(--border);
            border-bottom: 1px solid #e5e7eb;
        }

            .mini-tbl td:first-child {
                padding-left: 16px;
            }

            .mini-tbl td:last-child {
                padding-right: 16px;
                border-right: none;
            }

        .mini-tbl tfoot td {
            padding: 7px 12px;
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
            background: #f9fafb;
            border-top: 2px solid var(--border);
            border-right: 1px solid var(--border);
        }

            .mini-tbl tfoot td:first-child {
                padding-left: 16px;
            }

            .mini-tbl tfoot td:last-child {
                padding-right: 16px;
                border-right: none;
            }

    .txt-green {
        color: #10b981;
        font-weight: 700;
    }

    .txt-orange {
        color: #f59e0b;
        font-weight: 700;
    }

    .txt-red {
        color: #ef4444;
        font-weight: 700;
    }

    .empty-msg {
        padding: 20px;
        text-align: center;
        color: var(--muted);
        font-size: 12px;
    }

    .three-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
        margin-top: 16px;
    }

    .qa-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 14px;
        border-bottom: 1px solid #f3f4f6;
    }

        .qa-item:last-child {
            border-bottom: none;
        }

    .qa-icon {
        font-size: 16px;
        flex-shrink: 0;
    }

    .qa-label {
        flex: 1;
        font-size: 12.5px;
        font-weight: 500;
    }

    .qa-num {
        font-weight: 800;
        font-family: var(--mono);
        font-size: 14px;
        padding: 2px 9px;
        border-radius: 99px;
        min-width: 32px;
        text-align: center;
    }

    .token-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        padding: 3px 8px;
        border-radius: 6px;
        font-weight: 700;
        font-family: var(--mono);
        font-size: 12px;
        background: #dbeafe;
        color: #1d4ed8;
    }

    .done-row .token-num {
        background: #d1fae5;
        color: #065f46;
    }

    .lab-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--blue);
        margin-right: 4px;
        animation: pdot 1.4s infinite;
    }

    #dd-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(243,244,246,.8);
        backdrop-filter: blur(2px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .spin {
        width: 36px;
        height: 36px;
        border: 3px solid var(--border);
        border-top-color: var(--blue);
        border-radius: 50%;
        animation: spin .65s linear infinite;
    }

    #dd-notif {
        position: fixed;
        top: 70px;
        right: 20px;
        z-index: 9998;
        display: none;
        align-items: center;
        gap: 12px;
        background: var(--card);
        padding: 14px 18px;
        border-radius: var(--radius);
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
        border-left: 4px solid var(--blue);
        min-width: 320px;
    }

        #dd-notif .n-icon {
            font-size: 24px;
            color: var(--blue);
        }

        #dd-notif .n-body h4 {
            font-size: 13px;
            font-weight: 700;
        }

        #dd-notif .n-body p {
            font-size: 11px;
            color: var(--muted);
            margin-top: 2px;
        }

    .n-btn {
        margin-left: auto;
        padding: 7px 14px;
        border-radius: 6px;
        background: var(--blue);
        color: #fff;
        border: none;
        font: 600 12px var(--font);
        cursor: pointer;
        white-space: nowrap;
    }

    @@media (max-width: 1200px) {
        .stat-row {
            grid-template-columns: repeat(5,1fr);
        }

        .analytics-row {
            grid-template-columns: 1fr 1fr;
        }

        .four-row {
            grid-template-columns: 1fr 1fr;
        }

        .three-row {
            grid-template-columns: 1fr 1fr;
        }

        .two-advice-row, .two-lab-row {
            grid-template-columns: 1fr !important;
        }
    }

    .queue-card .tbl-scroll {
        height: 350px;
        overflow-y: auto;
        overflow-x: auto;
        padding: 0 16px;
    }

    .p-card .tbl-scroll {
        height: 300px;
        overflow-y: auto;
        overflow-x: auto;
        padding: 0 16px;
    }

    .p-card .quick-actions-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        padding: 12px;
    }

    #quick-actions-card {
        height: 100%;
    }

 
    @@keyframes pdot {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .3;
            transform: scale(.6);
        }
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes blinkCard {
        0%, 100% {
            box-shadow: 0 0 8px rgba(255,255,255,.3);
        }

        50% {
            box-shadow: 0 0 20px rgba(255,255,255,.9);
        }
    }

    .blink-card {
        animation: blinkCard 0.8s infinite;
    }

    @@keyframes pendingBlink {
        0%, 100% {
            background: #fff7ed;
            color: #c2410c;
            box-shadow: 0 0 5px rgba(245,158,11,.3);
        }

        50% {
            background: #ef4444;
            color: #ffffff;
            box-shadow: 0 0 12px rgba(239,68,68,.8);
        }
    }

    .b-pending {
        background: #fff7ed;
        color: #c2410c;
        animation: pendingBlink 1s infinite;
        font-weight: 700;
    }

    @@keyframes actionBlink {
        0%, 100% {
            background: #fff7ed;
            color: #c2410c;
            box-shadow: 0 0 5px rgba(245,158,11,.3);
        }

        50% {
            background: #ef4444;
            color: #ffffff;
            box-shadow: 0 0 14px rgba(239,68,68,.85);
        }
    }

    .action-blink {
        animation: actionBlink 1s infinite;
        font-weight: 700;
    }

    @@keyframes blinkGreen {
        0%, 100% {
            background: #D8F3DC;
            border-left-color: #2D6A4F;
        }

        50% {
            background: #bbf7d0;
            border-left-color: #ef4444;
            box-shadow: 0 0 14px rgba(239,68,68,.45);
        }
    }

    @@keyframes blinkRed {
        0%, 100% {
            background: #FFCCD5;
            border-left-color: #E63946;
        }

        50% {
            background: #fca5a5;
            border-left-color: #f59e0b;
            box-shadow: 0 0 14px rgba(239,68,68,.55);
        }
    }

    @@keyframes blinkOrange {
        0%, 100% {
            background: #FFF1C1;
            border-left-color: #F4A261;
        }

        50% {
            background: #fde68a;
            border-left-color: #ef4444;
            box-shadow: 0 0 14px rgba(239,68,68,.45);
        }
    }

    .blink-header-green {
        animation: blinkGreen 1s infinite;
    }

    .blink-header-red {
        animation: blinkRed 1s infinite;
    }

    .blink-header-orange {
        animation: blinkOrange 1s infinite;
    }
</style>


<div id="dd-loader"><div class="spin"></div></div>


<div id="dd-notif">
    <span class="n-icon">👤</span>
    <div class="n-body">
        <h4>New Patient Added</h4>
        <p>A new patient has joined the queue.</p>
    </div>
    <button class="n-btn" onclick="refreshAll()">Refresh Queue</button>
</div>


<input type="hidden" id="DoctorId" value="0" />
<input type="hidden" id="PatientId" value="0" />


<div style="background:#0d9488;padding:18px 24px;border-left:6px solid #065f46;">
    <h2 style="color:#ffffff;font-size:28px;font-weight:900;text-transform:uppercase;
               letter-spacing:.08em;margin:0;">
         Doctor Dashboard
    </h2>
</div>

<div class="dd-wrap">


    <div class="stat-row">
        <div class="stat-card" style="background:linear-gradient(135deg,#1a73e8,#4f9cf9);">
            <div class="sc-label">Total Cases</div>
            <div class="sc-val" id="sc-total">—</div>
        </div>
        <div class="stat-card blink-card" style="background:linear-gradient(135deg,#f59e0b,#fbbf24);">
            <div class="sc-label">Pending Cases</div>
            <div class="sc-val" id="sc-pending">—</div>
        </div>
        <div class="stat-card" style="background:linear-gradient(135deg,#10b981,#34d399);">
            <div class="sc-label">Done Cases</div>
            <div class="sc-val" id="sc-done">—</div>
        </div>
        <div class="stat-card blink-card" style="background:linear-gradient(135deg,#8b5cf6,#a78bfa);">
            <div class="sc-label">New Patients</div>
            <div class="sc-val" id="sc-new">—</div>
        </div>
        <div class="stat-card" style="background:linear-gradient(135deg,#06b6d4,#22d3ee);">
            <div class="sc-label">Revisit Patients</div>
            <div class="sc-val" id="sc-revisit">—</div>
        </div>
        <div class="stat-card blink-card" style="background:linear-gradient(135deg,#d97706,#fbbf24);">
            <div class="sc-label">Lab Advice</div>
            <div class="sc-val" id="sc-labadvice">—</div>
        </div>
        <div class="stat-card" style="background:linear-gradient(135deg,#ec4899,#f472b6);">
            <div class="sc-label">Medicine Advice</div>
            <div class="sc-val" id="sc-medadvice">—</div>
        </div>
        <div class="stat-card" style="background:linear-gradient(135deg,#059669,#10b981);">
            <div class="sc-label">Lab Result Ready</div>
            <div class="sc-val" id="sc-labready">—</div>
        </div>
        <div class="stat-card blink-card" style="background:linear-gradient(135deg,#ef4444,#f87171);">
            <div class="sc-label">Lab Result Pending</div>
            <div class="sc-val" id="sc-labpending">—</div>
        </div>
    </div>

  
    <div class="analytics-row">
        <div class="a-card">
            <div class="a-card-title" style="background:#FFE5B4;border-left:5px solid #F59E0B;color:#92400E;">
                📊 Case Status Breakdown
            </div>
            <div class="a-card-body">
                <div class="donut-wrap" style="justify-content:center;">
                    <canvas id="c-case" width="220" height="220" class="donut-canvas"></canvas>
                </div>
            </div>
        </div>
        <div class="a-card">
            <div class="a-card-title" style="background:#DDD6FE;border-left:5px solid #8B5CF6;color:#5B21B6;">
                👥 Patient Flow
