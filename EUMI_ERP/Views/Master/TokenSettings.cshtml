@{
    ViewBag.Title = "TokenDisplay";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<title>Medoo</title>

<link rel="shortcut icon" type="image/x-icon" href="../app-assets/img/ico/favicon.png">
<link rel="shortcut icon" type="image/png" href="../app-assets/img/ico/favicon.png">


<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>


<div id="Entry" style="width: 60%; margin-left: 20%; height: 100%; display: none;">

    <div class="row">
        <div class="col-md-12" style="margin-top:10%;">
            <div class="card">
                <div class="card-header" style="border-bottom:1px solid #e6e6e6">
                    <h4 class="card-title mb-0" style="text-align:center;font-weight:bold;">Token</h4>
                </div>
                <div class="card-body">
                    <div class="px-3">
                        <div class="card-content collapse show">
                            <div class="card-body">
                                <div style="height:15px;"></div>
                                <form action="#">
                                    <div class="form-body">


                                        <div class="row">
                                            <div class="col-md-2"></div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label style="font-weight:bold;">Token</label>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <input type="text" id="txtname" class="form-control" autocomplete="off" onkeyup="changetoupper(this.id)">
                                            </div>
                                            <div class="col-md-2"></div>
                                        </div>





                                        <div class="form-actions">
                                            <div class="text-right">

                                                <button type="button" style="width:100px" id="btnlist" onclick="GetRows(0)" class="btn btn-primary btn-min-width mr-1 mb-1">List <i class="ft-align-justify"></i></button>

                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="board-wrap" id="boardWrap">


    <div class="board-list-outer">
        <div class="table-responsive" id="table-responsive">
            <div id="tblAppointment" class="token-cards"></div>
        </div>
    </div>

</div>

<button onclick="openFullscreen();" class="fs-btn">Full Screen</button>
<a id="MainDashboardref" style="display:none;">Go Home</a>

<script>

    $('#MainDashboardref').attr("href", '../' + localStorage.getItem('defaultdashboard'));
    var elem = document.getElementById("table-responsive");
    function openFullscreen() {
        var target = document.getElementById("boardWrap");
        if (target.requestFullscreen) {
            target.requestFullscreen();
        } else if (target.webkitRequestFullscreen) {
            target.webkitRequestFullscreen();
        } else if (target.msRequestFullscreen) {
            target.msRequestFullscreen();
        }
    }
</script>

<div style="display:none">

    <input type="text" id="TokNo" class="form-control" />

</div>

<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        background: #0b1642;
        overflow-x: hidden;
    }

    .board-wrap {
        display: flex;
        width: 100vw;
        height: 100vh;
        background: #0b1642;
        font-family: 'helvetica', Arial, sans-serif;
        overflow: hidden;
        box-sizing: border-box;
        padding: 0;
        margin: 0;
        position: relative;
        left: 50%;
        transform: translateX(-50%);
    }

    .board-list-outer {
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        padding: 0;
    }

    .table-responsive {
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        border: none;
    }

    .token-cards {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 16px;
    }

    .token-card {
        display: flex;
        align-items: stretch;
        border-radius: 8px;
        padding: 10px 28px;
        gap: 20px;
        min-height: 60px;
    }

        .token-card .slno {
            display: none;
        }

        .token-card .doc-name {
            flex: 1;
            background: #fff;
            color: #0b1642;
            font-size: 24pt;
            font-weight: bold;
            border-radius: 6px;
            padding: 16px 22px;
            display: flex;
            align-items: center;
        }

        .token-card .tok-nav-btn {
            border: none;
            background: #99f6e4;
            color: #0b1642;
            width: 72px;
            height: auto;
            border-radius: 10px;
            font-size: 28pt;
            line-height: 1;
            cursor: pointer;
            flex-shrink: 0;
        }

            .token-card .tok-nav-btn:hover {
                background: #5eead4;
            }

            .token-card .tok-nav-btn:active {
                transform: scale(0.92);
            }

        .token-card .cur-token-input {
            background: #FEDD31;
            color: #0b1642;
            font-size: 30pt;
            font-weight: 800;
            border-radius: 10px;
            padding: 0 16px;
            width: 150px;
            height: auto;
            text-align: center;
            border: none;
            outline: none;
        }

        .token-card .show-btn,
        .token-card .hide-btn {
            border: none;
            border-radius: 50%;
            width: 68px;
            height: auto;
            aspect-ratio: 1 / 1;
            cursor: pointer;
            font-size: 28pt;
            font-weight: bold;
            line-height: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: transform .15s ease, opacity .15s ease;
        }

            .token-card .show-btn:active,
            .token-card .hide-btn:active {
                transform: scale(0.9);
            }

        .token-card .show-btn {
            background: #2ecc71;
            color: #fff;
        }

        .token-card .hide-btn {
            background: #e74c3c;
            color: #fff;
        }

        .token-card.collapsed .show-btn {
            opacity: 1;
        }

        .token-card.collapsed .hide-btn {
            opacity: .4;
        }

        .token-card:not(.collapsed) .show-btn {
            opacity: .4;
        }

        .token-card:not(.collapsed) .hide-btn {
            opacity: 1;
        }

        .token-card.collapsed .tok-nav-btn,
        .token-card.collapsed .cur-token-input {
            display: none;
        }

    .fs-btn {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 50;
        opacity: .25;
    }

        .fs-btn:hover {
            opacity: 1;
        }

    .token-toast {
        display: none;
        position: fixed;
        top: 30px;
        left: 50%;
        transform: translateX(-50%);
        background: #2ecc71;
        color: #fff;
        font-size: 14pt;
        font-weight: bold;
        padding: 12px 28px;
        border-radius: 8px;
        z-index: 999;
        box-shadow: 0 4px 12px rgba(0,0,0,.3);
    }
</style>

<script>

    var $el = $(".table-responsive");
    function anim() {
        var st = $el.scrollTop();
        var sb = $el.prop("scrollHeight") - $el.innerHeight();
        $el.animate({ scrollTop: st < sb / 2 ? sb : 0 }, 5000, anim);
    }
    function stop() {
        $el.stop();
    }
    anim();
    $el.hover(stop, anim);

</script>


<script>

    setInterval(function () {
        GetRows(0)
    }, 2000);


    function setHidden(docId, hidden) {
        $('.token-card[data-docid="' + docId + '"]').toggleClass('collapsed', hidden);
        $.ajax({
            type: "POST",
            url: "../Master/TokenSettingss",
            data: { TokNo: 0, DoctorId: docId, IsHidden: hidden }
        });
    }



    var tokenOverrides = {};


    var tokenPrefixes = {};


    function splitToken(value) {
        var match = String(value).match(/^(.*)-(\d+)\s*$/);
        if (match) {
            return { prefix: match[1], suffix: match[2] };
        }
        return { prefix: '', suffix: String(value) };
    }


    var tokenInputFocused = false;


    function onTokenKeypress(evt) {
        var charCode = evt.which ? evt.which : evt.keyCode;

        if (charCode === 13) {
            evt.preventDefault();
            onTokenTyped(evt.target);
            evt.target.blur();
            return false;
        }

        if (charCode < 48 || charCode > 57) {
            return false;
        }
        return true;
    }


    function showToast(msg) {
        var $toast = $('#tokenToast');
        if ($toast.length === 0) {
            $('body').append('<div id="tokenToast" class="token-toast"></div>');
            $toast = $('#tokenToast');
        }
        $toast.stop(true, true).text(msg).fadeIn(150).delay(1200).fadeOut(300);
    }



    function persistTokenValue(docId, fullValue, showMsg) {
        $.ajax({
            type: "POST",
            url: "../Master/TokenSettingss",
            data: { TokNo: 0, DoctorId: docId, TokenValue: fullValue },
            success: function (result) {
                if (!tokenInputFocused) ShowTermlist(result.oList);
                if (showMsg) showToast('Token updated');
            }
        });
    }

    function changeToken(docId, direction) {
        var $input = $('.token-card[data-docid="' + docId + '"] .cur-token-input');
        var num = parseInt($input.val(), 10);
        if (isNaN(num)) num = 0;
        num = direction === 'next' ? num + 1 : Math.max(0, num - 1);
        var newSuffix = String(num);
        $input.val(newSuffix);

        var prefix = tokenPrefixes[docId] || '';
        var fullValue = prefix ? (prefix + '-' + newSuffix) : newSuffix;
        tokenOverrides[docId] = fullValue;

        persistTokenValue(docId, fullValue, false);  
    }

    function onTokenTyped(inputEl) {
        var $card = $(inputEl).closest('.token-card');
        var docId = $card.attr('data-docid');
        var newSuffix = $(inputEl).val();

        var prefix = tokenPrefixes[docId] || '';
        var fullValue = prefix ? (prefix + '-' + newSuffix) : newSuffix;
        tokenOverrides[docId] = fullValue;

        persistTokenValue(docId, fullValue, true);   
    }

    function GetRows(TokNo) {
        if (TokNo == 0 && tokenInputFocused) return;
        $('#TokNo').val(TokNo)
        var data = {};
        data.TokNo = TokNo;
        $.ajax({
            type: "POST",
            url: "../Master/TokenSettingss",
            data: data,
            success: function (result) {
                if (TokNo == 0)
                    ShowTermlist(result.oList);
            }
        });
    }

    function ShowTermlist(result) {
        var responseText = "";
        for (var i = 0; i < result.length; i++) {
            var slno = parseInt(i + 1);
            var docId = result[i].DoctorId ? result[i].DoctorId : ('row_' + i);
            var rawValue = tokenOverrides.hasOwnProperty(docId) ? tokenOverrides[docId] : result[i].currenttoken;
            var parts = splitToken(rawValue);
            tokenPrefixes[docId] = parts.prefix;
            var tokenValue = parts.suffix;
            var isHidden = !!result[i].IsHidden;

            responseText += '' +
                '<div class="token-card' + (isHidden ? ' collapsed' : '') + '" data-docid="' + docId + '">' +
                '<div class="slno">' + slno + '</div>' +
                '<div class="doc-name">Dr. ' + result[i].Name + '</div>' +
                '<button type="button" class="tok-nav-btn" onclick="changeToken(\'' + docId + '\',\'prev\')">&#8249;</button>' +
                '<input type="text" inputmode="numeric" pattern="[0-9]*" class="cur-token-input" value="' + tokenValue + '" onkeypress="return onTokenKeypress(event)" onfocus="tokenInputFocused=true" onblur="tokenInputFocused=false" onchange="onTokenTyped(this)" />' +
                '<button type="button" class="tok-nav-btn" onclick="changeToken(\'' + docId + '\',\'next\')">&#8250;</button>' +
                '<button type="button" class="show-btn" title="Show" onclick="setHidden(\'' + docId + '\', false)">&#10003;</button>' +
                '<button type="button" class="hide-btn" title="Hide" onclick="setHidden(\'' + docId + '\', true)">&#10005;</button>' +
                '</div>';
        }
        $('#tblAppointment').html(responseText);
    }

    function closelist() {
        $('#Entry').show();
        $('#listing').hide();
        formrefresher();
    }
</script>
