@{
    ViewBag.Title = "TokenDisplay";
    Layout = null;
}

<title>Medoo</title>

<link rel="shortcut icon" type="image/x-icon" href="../app-assets/img/ico/favicon.png">
<link rel="shortcut icon" type="image/png" href="../app-assets/img/ico/favicon.png">


<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>


<div id="Entry" style="width: 60%; margin-left: 20%; height: 100%; display: none;">

    <div class="row">
        <div class="col-md-12" style="margin-top:10%;">
            <div class="card">
                <div class="card-header" style="border-bottom:1px solid #e6e6e6">
                    <h4 class="card-title mb-0" style="text-align:center;font-weight:bold;">Token</h4>
                </div>
                <div class="card-body">
                    <div class="px-3">
                        <div class="card-content collapse show">
                            <div class="card-body">
                                <div style="height:15px;"></div>
                                <form action="#">
                                    <div class="form-body">


                                        <div class="row">
                                            <div class="col-md-2"></div>
                                            <div class="col-md-4">
                                                <div class="form-group">
                                                    <label style="font-weight:bold;">Token</label>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <input type="text" id="txtname" class="form-control" autocomplete="off" onkeyup="changetoupper(this.id)">
                                            </div>
                                            <div class="col-md-2"></div>
                                        </div>





                                        <div class="form-actions">
                                            <div class="text-right">

                                                <button type="button" style="width:100px" id="btnlist" onclick="GetRows(0)" class="btn btn-primary btn-min-width mr-1 mb-1">List <i class="ft-align-justify"></i></button>

                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="board-wrap" id="boardWrap">

 
    <div class="board-banner">
        <div class="banner-slides" id="bannerSlides">
            <img class="banner-slide active" src="../app-assets/img/gallery/1.jpg" alt="">
            <img class="banner-slide" src="../app-assets/img/gallery/2.jpg" alt="">
            <img class="banner-slide" src="../app-assets/img/gallery/3.jpg" alt="">
            <img class="banner-slide" src="../app-assets/img/gallery/4.jpg" alt="">
        </div>
    </div>

  
    <div class="board-list-outer">
        <div class="table-responsive" id="table-responsive">
            <div id="tblAppointment" class="token-cards"></div>
        </div>
    </div>

</div>

<button onclick="openFullscreen();" class="fs-btn">Full Screen</button>
<a id="MainDashboardref" style="display:none;">Go Home</a>

<script>

    $('#MainDashboardref').attr("href", '../' + localStorage.getItem('defaultdashboard'));
    var elem = document.getElementById("table-responsive");
    function openFullscreen() {
        var target = document.getElementById("boardWrap");
        if (target.requestFullscreen) {
            target.requestFullscreen();
        } else if (target.webkitRequestFullscreen) { 
            target.webkitRequestFullscreen();
        } else if (target.msRequestFullscreen) {
            target.msRequestFullscreen();
        }
    }
</script>

<div style="display:none">

    <input type="text" id="TokNo" class="form-control" />

</div>

<style>

    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: #0b1642;
    }

    .board-wrap {
        display: flex;
        width: 100%;
        height: 100vh;
        background: #0b1642;
        font-family: 'helvetica', Arial, sans-serif;
        overflow: hidden;
        box-sizing: border-box;
        padding: 16px;
        gap: 16px;
    }


    .board-banner {
        width: 60%;
        height: 100%;
        position: relative;
        background: #0b1642;
        border: 4px solid #FEDD31;
        border-radius: 6px;
        overflow: hidden;
        box-sizing: border-box;
    }

    .hospital-name {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 5;
        background: #142561;
        color: #fff;
        font-weight: bold;
        font-size: 14pt;
        text-align: center;
        padding: 10px 6px;
        letter-spacing: .5px;
    }

    .banner-slides {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .banner-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 1s ease-in-out;
    }

        .banner-slide.active {
            opacity: 1;
        }


    .board-list-outer {
        width: 60%;
        height: 100%;
        box-sizing: border-box;
    }

    .table-responsive {
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        border: none;
    }

    .token-cards {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .token-card {
        display: flex;
        align-items: stretch;
        background: #142561;
        border-radius: 6px;
        overflow: hidden;
        min-height: 110px;
    }

        .token-card .slno {
            display: none; 
        }

        .token-card .cur-token {
            background: #FEDD31;
            color: #0b1642;
            font-size: 44pt;
            font-weight: 800;
            width: 22%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .token-card .doc-info {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 10px 22px;
            color: #fff;
        }

            .token-card .doc-info .doc-name {
                font-size: 22pt;
                font-weight: bold;
            }

            .token-card .doc-info .doc-dept {
                font-size: 12pt;
                font-weight: normal;
                opacity: .85;
                margin-top: 4px;
            }

        .token-card .next-token {
            width: 20%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #FEDD31;
            color: #000;
            border-left: 2px solid rgba(255,255,255,.15);
        }

            .token-card .next-token .label {
                font-size: 10pt;
                opacity: .75;
                margin-bottom: 6px;
                letter-spacing: .5px;
            }

            .token-card .next-token .value {
                font-size: 34pt;
                font-weight: 800;
            }

    .fs-btn {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 50;
        opacity: .25;
    }

        .fs-btn:hover {
            opacity: 1;
        }
</style>


<script>

   
    (function () {
        var slides = document.querySelectorAll('#bannerSlides .banner-slide');
        var idx = 0;
        if (slides.length > 1) {
            setInterval(function () {
                slides[idx].classList.remove('active');
                idx = (idx + 1) % slides.length;
                slides[idx].classList.add('active');
            }, 5000);
        }
    })();

    var $el = $(".table-responsive");
    function anim() {
        var st = $el.scrollTop();
        var sb = $el.prop("scrollHeight") - $el.innerHeight();
        $el.animate({ scrollTop: st < sb / 2 ? sb : 0 }, 5000, anim);
    }
    function stop() {
        $el.stop();
    }
    anim();
    $el.hover(stop, anim);

</script>


<script>

    setInterval(function () {
        GetRows(0)
    }, 2000);


    function GetRows(TokNo) {
        $('#TokNo').val(TokNo)
        var data = {};
        data.TokNo = TokNo;
        $.ajax({
            type: "POST",
            url: "../Master/Token123GetandGets",
            data: data,
            success: function (result) {
                if (TokNo == 0)
                    ShowTermlist(result.oList);
            }
        });
    }

    function ShowTermlist(result) {

        var responseText = "";
        for (var i = 0; i < result.length; i++) {
            var slno = parseInt(i + 1);
            responseText += '' +
                '<div class="token-card">' +
                '<div class="slno">' + slno + '</div>' +
                '<div class="cur-token">' + result[i].currenttoken + '</div>' +
                '<div class="doc-info">' +
                '<div class="doc-name">' + result[i].Name + '</div>' +
                '<div class="doc-dept">' + (result[i].Department || '') + '</div>' +
                '</div>' +
                //'<div class="next-token">' +
                //'<div class="label">NEXT TOKEN</div>' +
                //'<div class="value">' + result[i].NextToken + '</div>' +
                //'</div>' +
                '</div>';
        }
        $('#tblAppointment').html(responseText);

    }

    function closelist() {
        $('#Entry').show();
        $('#listing').hide();
        formrefresher();
    }
</script>
