<button onclick="openFullscreen();" class="fs-btn">Full Screen</button>
<a id="MainDashboardref" style="display:none;">Go Home</a>

<script>

    $('#MainDashboardref').attr("href", '../' + localStorage.getItem('defaultdashboard'));
    var elem = document.getElementById("table-responsive");
    function openFullscreen() {
        var target = document.getElementById("boardWrap");
        if (target.requestFullscreen) {
            target.requestFullscreen();
        } else if (target.webkitRequestFullscreen) {
            target.webkitRequestFullscreen();
        } else if (target.msRequestFullscreen) {
            target.msRequestFullscreen();
        }
    }
</script>

<div style="display:none">

    <input type="text" id="TokNo" class="form-control" />

</div>
<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: #0b1642;
    }

    .board-wrap {
        display: flex;
        width: 100%;
        height: 100vh;
        background: #0b1642;
        font-family: 'helvetica', Arial, sans-serif;
        overflow: hidden;
        box-sizing: border-box;
        padding: 16px;
        gap: 24px;
    }

    .token-card .doc-box .doc-divider-op {
        width: 60%;
        height: 2px;
        background: #ffffff;
        margin: 8px 0;
        opacity: .4;
        flex-shrink: 0;
    }

    .board-banner {
        width: 60%;
        height: 100%;
        position: relative;
        background: #0b1642;
        border: 4px solid #FEDD31;
        border-radius: 6px;
        overflow: hidden;
        box-sizing: border-box;
    }

    .banner-slides {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .banner-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: fill;
        opacity: 0;
        transition: opacity 1s ease-in-out;
    }

        .banner-slide.active {
            opacity: 1;
        }

    .board-list-outer {
        width: 60%;
        height: 100%;
        box-sizing: border-box;
        padding-right: 0;
    }

    .token-card .doc-box .doc-dept {
        font-size: clamp(14px, 3vh, 80pt);
        font-weight: 600;
        opacity: .85;
        margin-top: 6px;
        line-height: 1.1;
    }

    .table-responsive {
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        border: none;
        padding-top: 6px;
    }

    .token-cards {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .token-card {
        display: flex;
        align-items: stretch;
        gap: 8px;
        height: calc((100vh - 32px - 32px) / 3);
        flex-shrink: 0;
        overflow: hidden;
    }

        .token-card .slno {
            display: none;
        }

        .token-card .cur-token-box {
            background: white;
            color: #0b1642;
            border-radius: 6px;
            width: 30%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            overflow: hidden;
        }

            .token-card .cur-token-box .token-label {
                font-size: clamp(10px, 2.2vh, 15pt);
                font-weight: 1000;
                letter-spacing: .3px;
                opacity: .8;
                margin-bottom: 8px;
            }

            .token-card .cur-token-box .token-value {
                font-size: clamp(40px, 13vh, 95pt);
                font-weight: 800;
                color: red;
                line-height: 1;
                text-align: center;
            }

        .token-card .doc-box {
            flex: 1;
            background: #2a2fb8;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 4px 12px;
            color: #fff;
            min-width: 0;
            overflow: hidden;
        }

            .token-card .doc-box .doc-name {
                font-size: clamp(18px, 4.6vh, 35pt);
                font-weight: 900;
                line-height: 1.1;
            }

            .token-card .doc-box .doc-room {
                font-size: clamp(16px, 3.9vh, 30pt);
                font-weight: 850;
                color: white;
                margin-top: 3px;
                line-height: 1.1;
            }

            .token-card .doc-box .doc-op {
                font-size: clamp(18px, 5.2vh, 30pt);
                font-weight: 600;
                margin-top: 3px;
                opacity: .9;
                line-height: 1.1;
            }

                .token-card .doc-box .doc-op .op-value {
                    font-weight: 800;
                    color: #FEDD31;
                }

    .fs-btn {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 50;
        opacity: .25;
    }

        .fs-btn:hover {
            opacity: 1;
        }

    .table-responsive {
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-responsive::-webkit-scrollbar {
            display: none;
        }
</style>
<script>


    (function () {
        var slides = document.querySelectorAll('#bannerSlides .banner-slide');
        var idx = 0;
        var timer = null;

        function sizeRotatedVideo(v) {
            var wrap = document.getElementById('bannerSlides');
            var w = wrap.clientWidth;
            var h = wrap.clientHeight;
            v.style.position = 'absolute';
            v.style.top = '50%';
            v.style.left = '50%';
            v.style.width = h + 'px';
            v.style.height = w + 'px';
            v.style.objectFit = 'fill';
            v.style.transform = 'translate(-50%, -50%) rotate(-90deg)';
        }

        function goNext() {
            slides[idx].classList.remove('active');
            if (slides[idx].tagName === 'VIDEO') slides[idx].pause();

            idx = (idx + 1) % slides.length;
            showSlide();
        }

        function showSlide() {
            slides[idx].classList.add('active');

            if (slides[idx].tagName === 'VIDEO') {
                sizeRotatedVideo(slides[idx]);
                slides[idx].currentTime = 0;
                slides[idx].play();
                slides[idx].onended = goNext;
            } else {
                timer = setTimeout(goNext, 5000);
            }
        }

        if (slides.length > 1) {
            showSlide();
        }
    })();
    var $el = $(".table-responsive");
    function anim() {
        var st = $el.scrollTop();
        var sb = $el.prop("scrollHeight") - $el.innerHeight();
        $el.animate({ scrollTop: st < sb / 2 ? sb : 0 }, 30000, anim);
    }
    function stop() {
        $el.stop();
    }
    anim();
    $el.hover(stop, anim);

</script>


<script>

    $(document).ready(function () {
        var urlParams = new URLSearchParams(window.location.search);
        var flor = urlParams.get('Flor');

        if (flor !== null) {
            alert('Flor = ' + flor);
        }
    });

    setInterval(function () {
        GetRows(0)
    }, 2000);


    function GetRows(TokNo) {
        $('#TokNo').val(TokNo)
        var data = {};
        data.TokNo = TokNo;
        $.ajax({
            type: "POST",
            url: "../Master/Token123GetandGets",
            data: data,
            success: function (result) {
                if (TokNo == 0)
                    ShowTermlist(result.oList);
            }
        });
    }

    function ShowTermlist(result) {

        var responseText = "";

        for (var i = 0; i < result.length; i++) {
            var slno = parseInt(i + 1);

            var parts = (result[i].Name || '').split('|');
            var docName = parts[0] || '';
            var deptName = parts[1] || '';
            var room = parts[2] || '';
            // var opNo = parts[3] || '';


            var curToken = result[i].currenttoken;
            if (curToken === null || curToken === undefined) {
                curToken = '';
            }

            curToken = String(curToken).trim();
            if (curToken === '') {
                curToken = '-';
            }

            responseText += '' +

                '<div class="token-card">' +
                '<div class="slno">' + slno + '</div>' +
                '<div class="cur-token-box">' +
                '<div class="token-label">TOKEN NUMBER</div>' +
                '<div class="token-value">' + curToken + '</div>' +
                '</div>' +
                '<div class="doc-box">' +
                '<div class="doc-name">' + docName + '</div>' +
                (deptName ? '<div class="doc-dept">' + deptName + '</div>' : '') +
                '<div class="doc-divider-op"></div>' +
                '<div class="doc-op">Room Number : <span class="op-value">' + room + '</span></div>' +
                // '<div class="doc-op">OP Number : <span class="op-value">' + opNo + '</span></div>' +
                '</div>' +
                '</div>';
        }
        $('#tblAppointment').html(responseText);
    }

  

    function closelist() {
        $('#Entry').show();
        $('#listing').hide();
        formrefresher();
    }
</script>
