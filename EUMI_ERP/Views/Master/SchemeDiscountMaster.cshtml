@{
    ViewBag.Title = "SchemeDiscountMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="Entry" style="width:70%;margin-left:15%;height:100%;">
    <div class="row">
        <div class="col-md-12" style="margin-top:5%;">
            <div class="card">
                <div class="card-header" style="border-bottom:1px solid #e6e6e6">
                    <h4 class="card-title mb-0" style="text-align:center;font-weight:bold;">Scheme Discount Master</h4>
                </div>
                <div class="card-body">
                    <div class="px-3">
                        <div class="card-content collapse show">
                            <div class="card-body">
                                <form action="#">
                                    <div class="form-body">
                                        <div class="row">

                                            <!-- LEFT SIDE -->
                                            <div class="col-md-6">
                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Discount Code<span class="danger">*</span></label></div>
                                                    <div class="col-md-7"><input type="text" id="txtcode" class="form-control" autocomplete="off" /></div>
                                                </div>

                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Discount Name<span class="danger">*</span></label></div>
                                                    <div class="col-md-7"><input type="text" id="txtname" class="form-control" autocomplete="off" /></div>
                                                </div>

                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Remarks</label></div>
                                                    <div class="col-md-7"><textarea id="txtremark" class="form-control" rows="3" style="height:90px; resize:vertical;" autocomplete="off"></textarea></div>
                                                </div>

                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Pharma Discount %</label></div>
                                                    <div class="col-md-7"><input type="text" id="txtpharma" class="form-control numonly" autocomplete="off" /></div>
                                                </div>

                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Lab Discount %</label></div>
                                                    <div class="col-md-7"><input type="text" id="txtlab" class="form-control numonly" autocomplete="off" /></div>
                                                </div>

                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Procedure Discount %</label></div>
                                                    <div class="col-md-7"><input type="text" id="txtprocedure" class="form-control numonly" autocomplete="off" /></div>
                                                </div>
                                            </div>

                                            <!-- RIGHT SIDE -->
                                            <div class="col-md-6">
                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">IP Discount %</label></div>
                                                    <div class="col-md-7"><input type="text" id="txtip" class="form-control numonly" autocomplete="off" /></div>
                                                </div>

                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Registration Discount %</label></div>
                                                    <div class="col-md-7"><input type="text" id="txtreg" class="form-control numonly" autocomplete="off" /></div>
                                                </div>

                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Revisit Discount %</label></div>
                                                    <div class="col-md-7"><input type="text" id="txtrevisit" class="form-control numonly" autocomplete="off" /></div>
                                                </div>

                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Other 1 Discount %</label></div>
                                                    <div class="col-md-7"><input type="text" id="txtother1" class="form-control numonly" autocomplete="off" /></div>
                                                </div>

                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Other 2 Discount %</label></div>
                                                    <div class="col-md-7"><input type="text" id="txtother2" class="form-control numonly" autocomplete="off" /></div>
                                                </div>

                                                <div class="row mb-1">
                                                    <div class="col-md-5"><label style="font-weight:bold;">Other 3 Discount %</label></div>
                                                    <div class="col-md-7"><input type="text" id="txtother3" class="form-control numonly" autocomplete="off" /></div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="form-actions center" style="margin-left:2%;">
                                        <button type="button" style="width:100px" id="btnsubmit" class="btn btn-primary btn-min-width mr-1 mb-1">
                                            <u>S</u>ave <i class="fa fa-check-square-o"></i>
                                        </button>
                                        <button type="button" style="width:100px" id="btnlist" onclick="GetRows(0)" class="btn btn-primary btn-min-width mr-1 mb-1">
                                            List <i class="ft-align-justify"></i>
                                        </button>
                                        <button type="button" style="width:100px" id="btnnew" onclick="formrefresh()" class="btn btn-primary btn-min-width mr-1 mb-1">
                                            New <i class="ft-refresh-cw position-right"></i>
                                        </button>
                                        <button style="display:none" type="button" id="btndelete" class="btn btn-primary btn-min-width mr-1 mb-1">
                                            Delete <i class="fa fa-times"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- List -->
<div style="margin-top:0%;margin-left:3%;display:none;width:94%;" id="listing">
    <section>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <table width="100%">
                            <tr>
                                <td><h4 class="card-title mb-0" style="font-weight:bold;">Scheme Discount List</h4></td>
                                <td align="right">
                                    <button type="button" onclick="closelist()" class="btn btn-outline-primary btn-sm">
                                        <i class="ft-edit"></i> Add New
                                    </button>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div class="card-content collapse show">
                        <div class="card-body card-dashboard" style="overflow:auto;">
                            <table id="tblMstData" class="table table-striped table-bordered base-style dataTable" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Sl#</th>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Remarks</th>
                                        <th>Pharma %</th>
                                        <th>Lab %</th>
                                        <th>Procedure %</th>
                                        <th>IP %</th>
                                        <th>Registration %</th>
                                        <th>Revisit %</th>
                                        <th>Other 1 %</th>
                                        <th>Other 2 %</th>
                                        <th>Other 3 %</th>
                                        <th>Edit</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th><input type="text" placeholder="Search Code" class="form-control" /></th>
                                        <th><input type="text" placeholder="Search Name" class="form-control" /></th>
                                        <th><input type="text" placeholder="Search Remarks" class="form-control" /></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                            <br />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<div style="display:none"><input type="text" value="0" id="MstId" /></div>

<script type="text/javascript">
    var Editbutton = '<i class="ft-edit"></i>';
    var mstTable = null;

    // numeric fields: id -> JSON property name
    var discFields = {
        txtpharma: 'PharmaDisc', txtlab: 'LabDisc', txtprocedure: 'ProcedureDisc',
        txtip: 'IPDisc', txtreg: 'RegistrationDisc', txtrevisit: 'RevisitDisc',
        txtother1: 'Other1Disc', txtother2: 'Other2Disc', txtother3: 'Other3Disc'
    };

    $(document).ready(function () {
        document.title = "Scheme Discount Master";
        $('#txtcode').focus();
        $('.form-control').attr('autocomplete', 'off');
        $('#btnsubmit').click(function () { SaveAndUpdate(1); });
        $('#btndelete').click(function () {
            swal({
                title: "Do you want to delete?",
                text: "",
                icon: "warning",
                buttons: ["No", "Yes"],
                dangerMode: true
            }).then(function (willDelete) {
                if (willDelete) {
                    SaveAndUpdate(0);
                }
            });
        });

        // Allow digits (and a single decimal point) only - keystrokes, paste, drag-drop
        // Digits (and a single decimal point) only. Warn when anything else is entered
        $(document).on('input', '.numonly', function () {
            var original = this.value;
            var v = original.replace(/[^0-9.]/g, '');

            if (v !== original) {
                warningshow('Enter only digits');
            }

            // only one decimal point, max 2 decimal places
            var parts = v.split('.');
            if (parts.length > 2) v = parts[0] + '.' + parts.slice(1).join('');
            if (v.indexOf('.') > -1) {
                var p = v.split('.');
                v = p[0] + '.' + p[1].substring(0, 2);
            }
            this.value = v;
        });
        // For whole numbers only, replace the regex above with: /[^0-9]/g and drop the decimal handling.
    });

    function esc(s) {
        return $('<div>').text(s == null ? '' : s).html();
    }

    function SaveAndUpdate(Flag) {
        if (Flag === 1) {
            if ($.trim($('#txtcode').val()) === '') { warningshow('Please Enter Discount Code', 'txtcode'); return; }
            if ($.trim($('#txtname').val()) === '') { warningshow('Please Enter Discount Name', 'txtname'); return; }

            // validate each discount (0 - 100)
            for (var id in discFields) {
                var val = parseFloat($('#' + id).val() || 0);
                if (isNaN(val) || val < 0 || val > 100) {
                    warningshow('Discount % must be between 0 and 100', id);
                    return;
                }
            }
        }

        $('#btnsubmit').prop('disabled', true);

        var data = {
            SchemeId: $('#MstId').val(),
            DiscountCode: $.trim($('#txtcode').val()),
            DiscountName: $.trim($('#txtname').val()),
            Remarks: $.trim($('#txtremark').val()),
            DelFlag: Flag
        };
        for (var id in discFields) {
            var v = $.trim($('#' + id).val());
            if (v !== '') {                       // blank => property not sent => saved as NULL
                data[discFields[id]] = parseFloat(v);
            }
        }

        $.ajax({
            type: 'POST',
            url: '../Master/SchemeDiscountMasterInsertandUpdate',
            data: data,
            success: function (result) {
                $('#btnsubmit').prop('disabled', false);

                if (result && result.oList && result.oList.length > 0) {
                    var status = parseInt(result.oList[0].Status);

                    if (status == 1) {
                        swal("Data Saved Successfully!", "", "success").then(function () {
                            formrefresh();
                        });
                    } else if (status == 2) {
                        swal("Data Updated Successfully!", "", "success").then(function () {
                            formrefresh();
                        });
                    } else if (status == 3) {
                        swal("Deleted Successfully!", "", "warning").then(function () {
                            formrefresh();
                            GetRows(0);
                        });
                    } else if (status == 0) {
                        warningshow('Discount Code or Name already exists!');
                    } else {
                        warningshow('Operation failed!');
                    }
                } else {
                    warningshow('Unexpected response from server');
                }
            },
            error: function () {
                $('#btnsubmit').prop('disabled', false);
                warningshow('An error occurred. Please try again.');
            }
        });
    }
    function nv(x) { return (x === null || x === undefined) ? '' : x; }

    function GetRows(MstId) {
        $('#MstId').val(MstId);
        $.ajax({
            type: 'POST',
            url: '../Master/SchemeDiscountMasterGetandGets',
            data: { SchemeId: MstId },
            success: function (result) {
                if (MstId == 0) ShowEmrList(result);
                else ShowEmrGet(result);
            },
            error: function () { warningshow('Error loading data'); }
        });
    }

    function ShowEmrList(result) {
        $('#Entry').hide();
        $('#listing').show();

        if ($.fn.DataTable.isDataTable('#tblMstData')) {
            $('#tblMstData').DataTable().clear().destroy();
        }

        var tbody = $('#tblMstData tbody');
        tbody.empty();

        for (var i = 0; i < result.length; i++) {
            var r = result[i];
            tbody.append(
                '<tr>' +
                '<td align="center">' + (i + 1) + '</td>' +
                '<td>' + esc(r.DiscountCode) + '</td>' +
                '<td>' + esc(r.DiscountName) + '</td>' +
                '<td>' + esc(r.Remarks) + '</td>' +
                '<td align="right">' + nv(r.PharmaDisc) + '</td>' +
                '<td align="right">' + nv(r.LabDisc) + '</td>' +
                '<td align="right">' + nv(r.ProcedureDisc) + '</td>' +
                '<td align="right">' + nv(r.IPDisc) + '</td>' +
                '<td align="right">' + nv(r.RegistrationDisc) + '</td>' +
                '<td align="right">' + nv(r.RevisitDisc) + '</td>' +
                '<td align="right">' + nv(r.Other1Disc) + '</td>' +
                '<td align="right">' + nv(r.Other2Disc) + '</td>' +
                '<td align="right">' + nv(r.Other3Disc) + '</td>' +
                '<td style="background-color:#00ffff; text-align:center; vertical-align:middle; width:80px;">' +
                '<a onclick="GetRows(' + r.SchemeId + ')" style="color:black; font-size:16px; cursor:pointer;">' + Editbutton + '</a>' +
                '</td>' +
                '</tr>'
            );
        }

        mstTable = $('#tblMstData').DataTable({
            dom: '<"top d-flex justify-content-between align-items-center"l f>rtip',
            paging: true,
            searching: true,
            ordering: true,
            pageLength: 10,
            orderCellsTop: true,
            columnDefs: [
                { orderable: false, targets: 0 },
                { orderable: false, targets: 13 }
            ]
        });

        $('#tblMstData tfoot th').each(function (i) {
            var input = $(this).find('input');
            if (input.length) {
                input.on('keyup change', function () {
                    mstTable.column(i).search(this.value).draw();
                });
            }
        });
    }

    function ShowEmrGet(result) {
        if (result.length > 0) {
            var r = result[0];
            $('#MstId').val(r.SchemeId);
            $('#txtcode').val(r.DiscountCode);
            $('#txtname').val(r.DiscountName);
            $('#txtremark').val(r.Remarks);
            for (var id in discFields) {
                $('#' + id).val(r[discFields[id]]);
            }
        }
        $('#Entry').show();
        $('#listing').hide();
        $('#btndelete').show();
        $('#txtcode').focus();
    }

    function warningshow(message, Id) {
        $('#popupmessage').text(message);
        $('#Warningpopup').stop(true, true).show();
        if (Id) { $('#' + Id).focus().select(); }
        clearTimeout(window._warningTimer);
        window._warningTimer = setTimeout(function () {
            $('#Warningpopup').fadeOut();
        }, 3000);
    }

    function formrefresh() {
        $('#MstId').val(0);
        $('#txtcode').val('');
        $('#txtname').val('');
        $('#txtremark').val('');
        for (var id in discFields) { $('#' + id).val(''); }
        $('#btndelete').hide();
        $('#Warningpopup').stop(true, true).hide();
        $('#txtcode').focus();
    }

    function closelist() {
        $('#Entry').show();
        $('#listing').hide();
        formrefresh();
    }
</script>
