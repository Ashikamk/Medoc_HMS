<script type="text/javascript">
    var PRID = 0;

    // True only while an existing OT record is loaded in Edit mode.
    var isEditMode = false;

    // Ask before leaving an edited record through New or View List.
    function ConfirmLeaveEdit(callback) {
        if (!isEditMode) {
            callback();
            return;
        }

        swal({
            title: "Do you want to lose the data?",
            icon: "warning",
            buttons: {
                cancel: "Cancel",
                confirm: {
                    text: "Yes, Continue",
                    className: "btn-danger"
                }
            }
        }).then(function (result) {
            if (result) {
