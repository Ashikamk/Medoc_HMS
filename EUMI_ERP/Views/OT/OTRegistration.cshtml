    function RenderProcChips() {
        var $box = $('#ProcedureBox');
        $box.find('.ms-chip, .ms-placeholder').remove();
        if (!procSelected.length) {
            $box.prepend('<span class="ms-placeholder">Select Procedure(s)</span>');
        } else {
            var chips = '';
            $.each(procSelected, function (i, id) {
                var p = procData.filter(function (x) { return x.id === id; })[0];
                chips += '<span class="ms-chip">' + $('<div>').text(p ? p.name : id).html() +
                         '<b data-id="' + id + '">&times;</b></span>';
            });
            $box.prepend(chips);
