    function RenderProcList() {
        var q = ($('#ProcedureSearch').val() || '').toLowerCase();
        var h = '';
        $.each(procData, function (i, p) {
            if (q && p.name.toLowerCase().indexOf(q) === -1) return;
            var sel = procSelected.indexOf(p.id) > -1;
            h += '<li data-id="' + p.id + '" class="' + (sel ? 'sel' : '') + '">' +
                 '<span class="ck">' + (sel ? '<i class="fa fa-check"></i>' : '') + '</span>' +
                 $('<div>').text(p.name).html() + '</li>';
        });
        $('#ProcedureList').html(h || '<div class="ms-none">No procedures found</div>');
