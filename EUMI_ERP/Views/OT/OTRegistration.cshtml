    // Status change from the list: re-uses the EXISTING get-by-id and save (update) calls
    function ChangeOTStatus(sel, id) {
        var $s = $(sel);
        var newVal = $s.val();
        var oldVal = $s.attr('data-prev');
        var newText = $s.find('option:selected').text();

        function fail(msg) {
            $("#Loadingsave").hide();
            $s.val(oldVal);
            swal("Warning", msg || "Unable to update status", "warning");
        }

        swal({
            title: "Do you want to change the status to " + newText + "?",
            icon: "info",
            buttons: { cancel: "Cancel", confirm: "Yes" }
        }).then(function (ok) {
            if (!ok) { $s.val(oldVal); return; }

            $("#Loadingsave").show();

            // 1) load the full record
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetOTRegistrationById","OT")',
                data: { OTRegistrationId: id },
                success: function (d) {

                    var procIds = d.ProcedureIds || d.ProcedureId || '';

                    // 2) save it again with the new status
                    $.ajax({
                        type: "POST",
                        url: "../OT/OTRegistrationInsert",
                        data: {
                            OTRegistrationId: d.OTRegistrationId,
                            PatientId: d.PatientId,
                            RegNo: d.RegNo,
                            RegSeries: d.RegSeries || '',
                            OpNo: d.OpNo,
                            RevisitId: d.RevisitId,
                            IpNo: d.IpNo,
                            PatientName: d.PatientName,
                            Age: d.Age,
                            Gender: d.Gender,
                            ContactNo: d.ContactNo,
                            IpYear: 0,
                            OpDate: d.OpDate,
                            OpTime: d.OpTime,
                            DurationMinutes: parseInt(d.DurationMinutes) || 120,
                            OperationTheatre: parseInt(d.OperationTheatre),
                            DoctorConsultant: parseInt(d.DoctorConsultant),
                            ProcedureId: parseInt(String(procIds).split(',')[0]) || 0,   // first one (backward compatible)
                            ProcedureIds: procIds,                                       // "3,7,12"
                            Status: parseInt(newVal),
                            Notes: d.Notes,
                            UserId: ERPUserId,
                            DeptId: ERPDeptId
                        },
                        success: function (r) {
                            $("#Loadingsave").hide();
                            if (r.Status > 0) {
                                var row = $('#tblOTList').DataTable().row($s.closest('tr'));
                                var rd = row.data();
                                if (rd) { rd.Status = newVal; row.data(rd); }
                                if ($('#OTRegistrationId').val() == id) $('#Status').val(newVal);
                                swal({
                                    title: "Status changed successfully!",
                                    icon: "success",
                                    button: "OK"
                                });
                            } else if (r.ConflictType === 'OT_THEATRE_CONFLICT') {
                                fail("Operation theatre is already booked by " + (r.PatientName || '-') + " at " + schTime12(r.OpTime));
                            } else if (r.ConflictType === 'DOCTOR_CONFLICT') {
                                fail("Doctor is already booked with " + (r.PatientName || '-') + " at " + schTime12(r.OpTime));
                            } else {
                                fail(r.Message);
                            }
                        },
                        error: function () { fail("Server error while updating status"); }
                    });
                },
                error: function () { fail("Unable to load the record"); }
            });
        });
    }

