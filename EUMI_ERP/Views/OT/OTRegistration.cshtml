@{
    ViewBag.Title = "OTRegistration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .ui-autocomplete {
        z-index: 9999999 !important;
    }

    /* ================= PAGE SHELL ================= */
    .ot-page {
        font-family: inherit; /* same font as the rest of the site (Re-Visit page) */
        color: #1e293b;
    }

    .ot-shell {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(15,23,42,.12);
    }

    .ot-titlebar {
        background: #0f766e;
        color: #fff;
        padding: 12px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .ot-titlebar h1 {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .ot-titlebar h1 i {
                color: #99f6e4;
                font-size: 17px;
            }

    .ot-titledate {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #ccfbf1;
        font-size: 16px;
    }

        .ot-titledate #CurrentDate {
            border: none;
            background: transparent !important;
            color: #ccfbf1;
            font-size: 16px;
            font-weight: 500;
            width: 104px;
            padding: 0;
            height: auto;
            font-family: ui-monospace, Consolas, monospace;
        }

    .ot-body {
        padding: 12px;
    }

    .ot-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        align-items: stretch;
    }

    /* ================= CARDS ================= */
    .ot-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(15,23,42,.06);
        display: flex;
        flex-direction: column;
        overflow: visible; /* CHANGED: so the procedure dropdown is not clipped */
    }

    .ot-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 16px;
        background: #f0fdfa;
        border-bottom: 1px solid #e2e8f0;
        border-radius: 8px 8px 0 0; /* ADDED: replaces the clipping the card used to do */
    }

        .ot-card-head h2 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
            color: #115e59;
            letter-spacing: .07em;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .ot-card-head h2 i {
                color: #0d9488;
                font-size: 16px;
            }

    .ot-hint {
        font-size: 12px;
        font-weight: 500;
        color: #94a3b8;
    }

    .ot-tag {
        font-size: 12px;
        font-weight: 600;
        color: #0f766e;
        background: #ccfbf1;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .ot-card-body {
        flex: 1;
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .ot-row {
        display: grid;
        gap: 14px;
    }

        .ot-row.c2 {
            grid-template-columns: 1fr 1fr;
        }

        .ot-row.c3 {
            grid-template-columns: 1fr 1fr 1fr;
        }

        .ot-row.reg {
            grid-template-columns: 5fr 7fr;
        }

    .ot-field {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

        .ot-field.grow {
            flex: 1;
        }

        .ot-field label {
            margin: 0 0 5px;
            font-size: 16px;
            font-weight: 700;
            color: #000;
            text-transform: none;
            letter-spacing: normal;
        }

    .req {
        color: #f43f5e;
    }

    /* ================= INPUTS ================= */
    .ot-page .form-control {
        height: 42px;
        padding: 8px 12px;
        font-size: 14px;
        font-weight: 400;
        color: #1e293b;
        background: #f8fafc !important;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        box-shadow: none;
    }

        .ot-page .form-control::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        .ot-page .form-control:focus {
            background: #fff !important;
            border-color: #14b8a6;
            box-shadow: 0 0 0 2px rgba(20,184,166,.25);
            outline: none;
        }

        .ot-page .form-control[readonly] {
            background: #f1f5f9 !important;
            color: #334155;
            opacity: 1;
            cursor: default;
        }

    .ot-page select.form-control {
        padding-left: 10px;
        padding-right: 6px;
    }

    .ot-page textarea#Notes {
        flex: 1;
        min-height: 90px;
        height: auto;
        resize: none;
        padding: 10px 12px;
    }

    .ot-page #Status {
        color: #115e59;
        font-weight: 600;
    }

    .ot-regwrap {
        display: flex;
        gap: 6px;
    }

        .ot-regwrap #Opseriesname {
            flex: 0 0 34%;
            width: 34%;
            text-align: center;
        }

    .ot-ico {
        position: relative;
        flex: 1;
        min-width: 0;
    }

        .ot-ico .form-control {
            padding-right: 32px;
        }

        .ot-ico i {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 14px;
            color: #94a3b8;
            pointer-events: none;
        }

    /* Blue option list only (Operation Theatre, Consultant) */
    select#OperationTheatre option,
    select#DoctorConsultant option {
        background-color: #5fd8ea;
        color: #333;
    }

        select#OperationTheatre option:hover,
        select#OperationTheatre option:checked,
        select#DoctorConsultant option:hover,
        select#DoctorConsultant option:checked {
            background-color: #1a63d1;
            color: #fff;
        }

    /* ================= PROCEDURE MULTI-SELECT ================= */
    .ms-wrap {
        position: relative;
    }

    .ot-page .ms-box {
        height: auto;
        min-height: 42px;
        cursor: pointer;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px;
        padding: 4px 28px 4px 8px;
        position: relative;
    }

    .ms-box > i {
        position: absolute;
        right: 10px;
        top: 14px;
        color: #94a3b8;
        pointer-events: none;
    }

    .ms-placeholder {
        color: #94a3b8;
        font-weight: 400;
    }

    .ms-chip {
        background: #ccfbf1;
        color: #115e59;
        font-size: 13px;
        font-weight: 600;
        padding: 2px 4px 2px 8px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .ms-chip b {
            cursor: pointer;
            font-size: 16px;
            line-height: 1;
            padding: 0 3px;
            color: #0f766e;
        }

            .ms-chip b:hover {
                color: #e11d48;
            }

    .ms-panel {
        display: none;
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        margin-top: 2px;
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        box-shadow: 0 6px 18px rgba(15,23,42,.18);
        z-index: 1000;
        padding: 6px;
    }

    .ms-wrap.open .ms-panel {
        display: block;
    }

    .ot-page .ms-search {
        height: 34px;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .ms-list {
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: 180px;
        overflow-y: auto;
    }

        .ms-list li {
            padding: 7px 10px;
            font-size: 15px;
            cursor: pointer;
            border-radius: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .ms-list li:hover {
                background: #f0fdfa;
            }

            .ms-list li.sel {
                background: #ccfbf1;
                font-weight: 600;
                color: #115e59;
            }

            .ms-list li .ck {
                width: 16px;
                color: #0d9488;
            }

    .ms-none {
        padding: 10px;
        color: #94a3b8;
        font-size: 14px;
        text-align: center;
    }

    /* ================= ACTION BAR ================= */
    .ot-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 18px;
        background: #fff;
        border-top: 1px solid #e2e8f0;
    }

    .ot-foot-note {
        font-size: 13px;
        font-weight: 500;
        color: #94a3b8;
    }

    .ot-actions {
        display: flex;
        gap: 10px;
        margin-left: auto;
    }

    .ot-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 40px;
        padding: 0 22px;
        font-size: 15px;
        font-weight: 600;
        color: #fff;
        border: 1px solid transparent;
        border-radius: 6px;
        cursor: pointer;
        box-shadow: 0 1px 2px rgba(0,0,0,.08);
        transition: background .15s;
    }

    .ot-btn-save {
        background: #0d9488;
    }

        .ot-btn-save:hover {
            background: #0f766e;
        }

    .ot-btn-new {
        background: #0891b2;
    }

        .ot-btn-new:hover {
            background: #0e7490;
        }

    .ot-btn-del {
        background: #e11d48;
    }

        .ot-btn-del:hover {
            background: #be123c;
        }

    .ot-btn-list {
        background: #eb9832;
        color: #fff;
        border-color: #cbd5e1;
    }

        .ot-btn-list:hover {
            background: #d9a11b;
        }

        .ot-btn-list i {
            color: #64748b;
        }

    @@media (max-width: 991px) {
        .ot-grid {
            grid-template-columns: 1fr;
        }
    }

    #Loadingsave {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255,255,255,0.7);
        z-index: 99999;
        display: none;
    }

        #Loadingsave > div {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

    .top-alert {
        position: fixed;
        top: 90px;
        left: 50%;
        transform: translateX(-50%);
        background: #ff5c70;
        color: white;
        padding: 14px 35px;
        font-weight: 600;
        font-size: 15px;
        border-radius: 6px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.2);
        display: none;
        z-index: 999999;
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 15px;
        color: white;
        font-size: 12px;
        display: inline-block;
        min-width: 80px;
        text-align: center;
    }

    .scheduled {
        background: #3498db;
    }

    .badge-progress {
        background: #f39c12;
    }

    .completed {
        background: #27ae60;
    }

    .cancelled {
        background: #e74c3c;
    }

    .postponed {
        background: #7f8c8d;
    }

    body.ot-modal-open {
        overflow: hidden !important;
    }

    #OTModalOverlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 9000;
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        background-color: rgba(0, 0, 0, 0.4);
    }

    #OTListModal {
        display: none;
        position: fixed;
        top: 24px; /* gap on the top */
        left: 28px; /* gap on the left */
        right: 28px; /* gap on the right */
        bottom: 0;
        transform: none;
        z-index: 9990; /* above the site navbar, below SweetAlert popups (10000) */
        width: auto;
        height: auto;
        max-width: none;
        max-height: none;
        flex-direction: column;
        background: #ffffff;
        border-radius: 10px 10px 0 0;
        box-shadow: 0 0 24px rgba(0,0,0,0.25);
        overflow: hidden;
    }

    .ot-modal-header {
        flex-shrink: 0;
        background: #ffffff;
        color: #115e59;
        padding: 12px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e2e8f0;
        border-radius: 0;
    }

        .ot-modal-header h4 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            color: #115e59;
        }

    .ot-close-btn {
        background: none;
        border: none;
        color: white;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
        padding: 0 4px;
        opacity: 0.85;
        transition: opacity 0.15s;
    }

        .ot-close-btn:hover {
            opacity: 1;
        }

    .ot-modal-filters {
        flex-shrink: 0;
        padding: 12px 22px 10px;
        background: #f3fafa;
        border-bottom: 1px solid #cce8e8;
        display: flex;
        align-items: flex-end;
        gap: 16px;
        flex-wrap: wrap;
    }

    .ot-filter-group {
        display: flex;
        flex-direction: column;
    }

        .ot-filter-group label {
            font-weight: 600;
            font-size: 12px;
            color: #444;
            margin-bottom: 4px;
        }

    .ot-modal-filters .form-control {
        height: 34px !important;
        font-size: 13px !important;
        padding: 4px 10px !important;
        border-radius: 6px !important;
        width: 160px;
    }

    .ot-modal-filters select.form-control {
        width: 160px;
    }

    .btn-go {
        height: 34px;
        padding: 0 24px;
        font-size: 13px;
        font-weight: 700;
        background: #0d9488;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
        margin-bottom: 0;
        align-self: flex-end;
    }

        .btn-go:hover {
            background: #0f766e;
        }

    /* Add New + Export (right end of the filter bar) */
    .ot-filter-actions {
        margin-left: auto;
        align-self: flex-end;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    #otExportPlace {
        display: inline-flex;
        align-items: center;
    }

        #otExportPlace .dt-buttons {
            float: none;
            display: inline-flex;
            margin: 0;
            padding: 0;
        }

        .btn-add-new,
        #otExportPlace .buttons-collection {
            box-sizing: border-box;
            height: 34px;
            min-width: 96px;
            margin: 0;
            padding: 0 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 600;
            line-height: 1;
            color: #0f766e;
            background: #fff;
            border: 1px solid #0f766e;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.15s;
        }

            .btn-add-new:hover,
            #otExportPlace .buttons-collection:hover {
                background: #0f766e;
                color: #fff;
            }

    /* keep the export dropdown and date pickers above the full-page list */
    div.dt-button-collection {
        z-index: 9995 !important;
    }

    .daterangepicker {
        z-index: 9995 !important;
    }

    .ot-modal-table-wrap {
        flex: 1;
        overflow-y: auto;
        overflow-x: auto;
        padding: 0 22px 90px; /* extra bottom space so Previous / Next can scroll fully into view */
        background: #fff;
        min-height: 0;
    }

    #tblOTList {
        width: 100% !important;
        border-collapse: collapse;
        font-size: 14px;
    }

        #tblOTList thead th {
            position: sticky;
            top: 0;
            z-index: 3;
            background: #ffffff !important;
            color: #000 !important;
            padding: 5px 10px !important;
            font-size: 14px;
            font-weight: 700;
            text-align: center;
            border: 1px solid #e0e0e0;
            border-bottom: 2px solid #0f766e;
            white-space: nowrap;
        }

        #tblOTList td {
            padding: 1px 8px !important;
            line-height: 1.2 !important;
            font-size: 14px;
            font-weight: 400 !important;
            text-align: center;
            vertical-align: middle;
            border: 1px solid #e0e0e0;
            white-space: nowrap;
        }

            #tblOTList td:nth-child(7) {
                white-space: normal;
                min-width: 260px;
                text-align: left;
            }

        #tblOTList tbody tr:nth-child(even) {
            background: #f5fbfb;
        }

        #tblOTList tbody tr:hover {
            background: #d4eeee;
            cursor: pointer;
        }

    .ot-modal-table-wrap .dataTables_wrapper {
        font-size: 15px;
    }

    /* status dropdown inside the list */
    .status-select {
        border: none;
        border-radius: 12px;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        height: 22px;
        min-width: 100px;
        padding: 0 6px;
        text-align: center;
        cursor: pointer;
    }

        .status-select option {
            background: #fff;
            color: #000;
        }

    .btn-edit-row {
        height: 22px;
        width: 26px;
        border-radius: 50%;
        padding: 0;
        font-size: 11px;
        line-height: 1;
    }

    .ot-empty-row td {
        text-align: center;
        color: #aaa;
        padding: 28px !important;
        font-size: 13px;
    }

    /* ---- popup (SweetAlert) alignment: everything centered ---- */
    .swal-modal {
        text-align: center;
        padding-bottom: 8px;
    }

    .swal-title {
        font-size: 24px;
        font-weight: 700;
        color: #333;
        margin: 6px 0 4px;
        padding: 0 20px;
    }

    .swal-text {
        display: block;
        text-align: center !important;
        font-size: 16px;
        font-weight: 500;
        line-height: 1.5;
        color: #555;
        max-width: 100%;
        margin: 0 auto;
        padding: 0 28px;
    }

    .swal-footer {
        text-align: center !important;
        margin-top: 22px;
        padding: 0 16px 18px;
    }

    .swal-button-container {
        float: none;
        display: inline-block;
        margin: 0 6px;
    }

    .swal-button {
        min-width: 110px;
        height: 40px;
        padding: 0 22px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 6px;
        background-color: #0f766e;
        color: #fff;
    }

        .swal-button:not([disabled]):hover {
            background-color: #115e59;
        }

    .swal-button--cancel {
        background-color: #8e9aa0;
    }

        .swal-button--cancel:not([disabled]):hover {
            background-color: #76838a;
        }

    .swal-button--danger {
        background-color: #e74c3c;
    }

        .swal-button--danger:not([disabled]):hover {
            background-color: #c0392b;
        }

    /* ================= OT SCHEDULE (modal) ================= */
    .ot-btn-sch {
        background: #7c3aed;
    }

        .ot-btn-sch:hover {
            background: #6d28d9;
        }

    #OTScheduleModal {
        display: none;
        position: fixed;
        top: 24px;
        left: 28px;
        right: 28px;
        bottom: 0;
        z-index: 9990;
        flex-direction: column;
        background: #f1f5f9;
        border-radius: 10px 10px 0 0;
        box-shadow: 0 0 24px rgba(0,0,0,0.25);
        overflow: hidden;
    }

    .sch-head-bar {
        flex-shrink: 0;
        background: #fff;
        padding: 10px 22px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

        .sch-head-bar h4 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            letter-spacing: .6px;
            text-transform: uppercase;
            color: #115e59;
        }

    .sch-tools {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sch-nav-btn {
        width: 34px;
        height: 34px;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #0f766e;
        cursor: pointer;
    }

        .sch-nav-btn:hover {
            background: #f0fdfa;
        }

    .sch-tools .sch-date {
        height: 34px;
        width: 130px;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        background: #fff !important;
        color: #115e59;
        cursor: pointer;
    }

    .sch-today-btn, .sch-close-btn {
        height: 34px;
        padding: 0 16px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .sch-today-btn {
        background: #fff;
        color: #0f766e;
        border: 1px solid #0f766e;
    }

        .sch-today-btn:hover {
            background: #0f766e;
            color: #fff;
        }

    .sch-close-btn {
        background: #e11d48;
        color: #fff;
        border: 1px solid #e11d48;
    }

        .sch-close-btn:hover {
            background: #be123c;
        }

    .sch-scroll-body {
        flex: 1;
        overflow: auto;
        padding: 12px 22px 90px;
        min-height: 0;
    }

    .sch-stats {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 10px;
        margin-bottom: 12px;
    }

    .sch-stat {
        border-radius: 8px;
        padding: 12px 16px;
        display: flex;
        flex-direction: row-reverse;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        border: 1px solid rgba(15,23,42,.05);
    }

        .sch-stat i {
            font-size: 32px;
        }

        .sch-stat .lbl {
            font-size: 16px;
            font-weight: 700;
            color: #1e293b;
        }

        .sch-stat .num {
            font-size: 30px;
            font-weight: 800;
            line-height: 1.15;
            color: #0f172a;
