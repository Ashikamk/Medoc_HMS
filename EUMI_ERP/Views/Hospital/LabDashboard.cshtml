    function OpenLabResultPopupFromDashboard(billNo, regNo, patientName, doctorName, mode) {
        if (!billNo || billNo === '—' || billNo === '0') {
            alert('No bill number available for this patient.');
            return;
        }

        window._currentPatientId = 0;
        window._currentRegNo = regNo;

        document.getElementById('LRD_PatientName').textContent = patientName;
        document.getElementById('LRD_RegNo').textContent = regNo;
        document.getElementById('LRD_Age').textContent = '';
        document.getElementById('LRD_Doctor').textContent = doctorName;
        document.getElementById('LRD_Contact').textContent = '';
        document.getElementById('LRD_SampleId').textContent = billNo;
        document.getElementById('LRD_CollDate').textContent = '';
        document.getElementById('LRD_Notes').innerHTML = '';
        document.getElementById('LRD_TestBody').innerHTML = '';

        $('#LabResultDetailModal').modal('show');
        $('#LabResultDetailModal').appendTo('body');

        document.querySelector('#LabResultDetailModal .modal-header').style.display = 'none';
        var allBodyDivs = document.querySelectorAll('#LabResultDetailModal .modal-body > *');
        for (var xi = 0; xi < allBodyDivs.length; xi++) {
            allBodyDivs[xi].style.display = 'none';
        }

        var signOff = document.querySelector('#LabResultDetailModal .modal-body > div:last-child');
        if (signOff) signOff.style.display = 'flex';

        document.getElementById('verifiedby').style.display = (mode === 'approve') ? 'none' : '';
        document.getElementById('approvedby').style.display = (mode === 'verify') ? 'none' : '';

        var deptId = typeof ERPDeptId !== 'undefined' ? ERPDeptId : 0;


        var best = null;
        for (var i = 0; i < g_billRows.length; i++) {
            if (String(g_billRows[i].BillNo) === String(billNo)) { best = g_billRows[i]; break; }
        }


        var matchedWS = null;
        for (var w = 0; w < g_worksheetRows.length; w++) {
            if (String(g_worksheetRows[w].TokenNumber) === String(billNo)) {
                matchedWS = g_worksheetRows[w]; break;
            }
        }

        if (!best && matchedWS) {
            best = {
                BillNo: billNo,
                BillYear: 0,
                PatientId: matchedWS.PatientId || 0,
                OPNumber: matchedWS.RevisitId || '',
                DoctorName: matchedWS.DoctorName || doctorName,
                Date: matchedWS.RevisitDate || '',
                Doctor: ''
            };
        }

        if (!best) {
            document.getElementById('LRD_TestBody').innerHTML =
                '<tr><td colspan="4" style="text-align:center;color:red;">Bill not found.</td></tr>';
            return;
        }

        window._currentBill = best;
        window._currentPatientId = best.PatientId || 0;
        window._currentRegNo = best.OPNumber || regNo;

        document.getElementById('LRD_CollDate').textContent =
            best.Date || best.BillDate || best.RevisitDate || '';
        document.getElementById('LRD_Doctor').textContent =
            best.DoctorName || doctorName;

        var docParts = (best.Doctor || '').split('#');
        var contactNo = (docParts[6] || '').trim();
        if (/\d{6,}/.test(contactNo)) {
            document.getElementById('LRD_Contact').textContent = contactNo.substring(0, 10);
        }

        $.ajax({
            type: 'POST',
            url: '../Revisit/HMS_ResultGetandGets',
            data: {
                ResultId: 1, DeptId: deptId, BillNo: best.BillNo,
                BillYear: best.BillYear, Flag: 1,
                FromDate: '', ToDate: '', DoctorId: 0, PatientId: 0
            },
            success: function (resultRes) {
                var resultList = resultRes.oList || [];
                var allNotes = '';
                for (var n = 0; n < resultList.length; n++) {
                    var rn = (resultList[n].Notes || '').toString().replace(/undefined|null/g, '').trim();
                    var rr = (resultList[n].Remarks || '').toString().replace(/undefined|null/g, '').trim();
                    var tr = (resultList[n].TestRemarks || '').toString().replace(/undefined|null/g, '').trim();
                    var nt = (resultList[n].NoteText || '').toString().replace(/undefined|null/g, '').trim();
                    if (rn && allNotes.indexOf(rn) === -1) allNotes += rn + ' ';
                    if (rr && rr.indexOf('##') === -1 && allNotes.indexOf(rr) === -1) allNotes += rr + ' ';
                    if (tr && allNotes.indexOf(tr) === -1) allNotes += tr + ' ';
                    if (nt && allNotes.indexOf(nt) === -1) allNotes += nt + ' ';
                }
                best.TrueNotes = allNotes.trim();

                $.ajax({
                    type: 'POST',
                    url: '../Revisit/HMS_LabBillTestGets',
                    data: { BillNo: best.BillNo, BillYear: best.BillYear, Flag: 0, DeptId: deptId },
                    success: function (r2) {
                        LoadUserDropdowns(best.BillNo);
                        LoadLabResultPopup(r2.oList || [], best);
                    },
                    error: function () {
                        document.getElementById('LRD_TestBody').innerHTML =
                            '<tr><td colspan="4" style="text-align:center;color:red;">Error loading tests.</td></tr>';
                    }
                });
            },
            error: function () {
                best.TrueNotes = '';
                $.ajax({
                    type: 'POST',
                    url: '../Revisit/HMS_LabBillTestGets',
                    data: { BillNo: best.BillNo, BillYear: best.BillYear, Flag: 0, DeptId: deptId },
                    success: function (r2) {
                        LoadUserDropdowns(best.BillNo);
                        LoadLabResultPopup(r2.oList || [], best);
                    },
                    error: function () {
                        document.getElementById('LRD_TestBody').innerHTML =
                            '<tr><td colspan="4" style="text-align:center;color:red;">Error loading tests.</td></tr>';
                    }
                });
            }
        });
    }

            function LoadLabResultPopup(tests, bill) {
            $("#LRD_TestBody").html('');
            $("#LRD_Notes").html('');

            if (!tests || tests.length === 0) {
                $("#LRD_TestBody").html(
                    '<tr><td colspan="4" class="text-center text-muted p-3">No test details available.</td></tr>'
                );
                return;
            }

            var html = '';
            var finalNotes = '';
            var currentDeptId = '';

            for (var i = 0; i < tests.length; i++) {
                var t = tests[i];

                var noteVal = '';
                if (t.Notes && t.Notes.toString().replace(/undefined/g, '').replace(/null/g, '').trim() !== '') {
                    noteVal = t.Notes.toString().replace(/undefined/g, '').replace(/null/g, '').trim();
                } else if (t.Remarks && t.Remarks.toString().replace(/undefined/g, '').replace(/null/g, '').trim() !== '') {
                    var tempR = t.Remarks.toString().replace(/undefined/g, '').replace(/null/g, '').trim();
                    if (tempR.indexOf('##') === -1) { noteVal = tempR; }
                } else if (t.TestRemarks && t.TestRemarks.toString().replace(/undefined/g, '').replace(/null/g, '').trim() !== '') {
                    noteVal = t.TestRemarks.toString().replace(/undefined/g, '').replace(/null/g, '').trim();
                }
                if (noteVal !== '' && finalNotes.indexOf(noteVal) === -1) {
                    finalNotes += noteVal + ' ';
                }

                if (t.Flag == 1) {

                    currentDeptId = (t.MedDeptId || '').toString();
                    html += '<tr class="lab-dept-header" style="background-color:#f2f2f2;">' +
                        '<td colspan="4" style="font-weight:bold;text-align:center;padding:4px 8px;' +
                        'font-size:11px;letter-spacing:1px;">' + (t.TestName || '') + '</td></tr>';
                } else {


                    var thisDeptId = (t.MedDeptId || '').toString();
                    if (thisDeptId !== '' && thisDeptId !== currentDeptId) {
                        currentDeptId = thisDeptId;
                        var deptName = (t.MedDeptName || '').split('#')[0].trim();
                        if (deptName !== '') {
                            html += '<tr class="lab-dept-header" style="background-color:#f2f2f2;">' +
                                '<td colspan="4" style="font-weight:bold;text-align:center;padding:4px 8px;' +
                                'font-size:11px;letter-spacing:1px;">' + deptName + '</td></tr>';
                        }
                    }

                    var resultVal = (t.Result || '').trim();
                    var genderSymbol = '';
                    if ($("#LRD_Age").text().indexOf('Female') !== -1 || $("#LRD_Age").text().indexOf('F') !== -1) {
                        if (resultVal !== '' && !isNaN(parseFloat(resultVal))) {
                            genderSymbol = ' ♀';
                        }
                    }

                    var normalVal = (t.NormalValue || '').replace(/##/g, '<br>');
                    var stdUnit = t.StdUnit || '';

                    var isWBC = (t.TestName || '').toUpperCase().indexOf('TOTAL WBC COUNT') !== -1 ||
                        (t.TestName || '').toUpperCase().indexOf('TOTAL WBC') !== -1;

                    if (isWBC && (!normalVal || normalVal === '')) {
                        normalVal = 'Mean: -0.000 - 0.000<br>' +
                            'Minimum: -4.000 - 0.000<br>' +
                            'Maximum: 4.000 - 10.000<br>' +
                            'Child: &lt;500 - 14.600<br>' +
                            'Infants: 8,100 - 14.500';
                    }

                    var maxV = parseFloat((t.MaxValue + '').replace(/,/g, '') || 0);
                    var minV = parseFloat((t.MinValue + '').replace(/,/g, '') || 0);

                    var isAbnorm = false;
                    var arrow = '';

                    if (resultVal !== '') {
                        var resNum = parseFloat(resultVal.replace(/,/g, ''));
                        if (!isNaN(resNum)) {
                            if (maxV > 0 && resNum > maxV) {
                                isAbnorm = true;
                                arrow = ' <span style="color:#c0392b;font-size:10px;">&#9650;</span>';
                            } else if (minV > 0 && resNum < minV) {
                                isAbnorm = true;
                                arrow = ' <span style="color:#c0392b;font-size:10px;">&#9660;</span>';
                            }
                        }
                        var up = resultVal.toUpperCase();
                        if (up.indexOf('RECH') !== -1 || up.indexOf('REACT') !== -1 || up.indexOf('POSITIVE') !== -1) {
                            isAbnorm = true;
                        }
                    }

                    var resultCellStyle = 'padding:4px 8px;width:18%;' +
                        (isAbnorm ? 'font-weight:bold;color:#c0392b;' : '');

                    var testDisplay = t.TestName || '';
                    var indented = false;
                    if (testDisplay.indexOf('##') !== -1) {
                        testDisplay = testDisplay.replace('##', '');
                        indented = true;
                    }

                    html += '<tr style="border-bottom:0.5px solid #eee;">' +
                        '<td style="padding:4px 8px;width:38%;font-weight:bold;' +
                        (indented ? 'padding-left:24px;' : '') + '">' + testDisplay + '</td>' +
                        '<td style="' + resultCellStyle + '">' +
                        (resultVal !== '' ? resultVal + genderSymbol + arrow : '&mdash;') + '</td>' +
                        '<td style="padding:4px 8px;color:#555;width:12%;">' + stdUnit + '</td>' +
                        '<td style="padding:4px 8px;color:#555;width:32%;font-size:11px;">' + normalVal + '</td>' +
                        '</tr>';
                }
            }

            $("#LRD_TestBody").html(html);

            var cleaned = finalNotes.replace(/undefined/g, '').replace(/null/g, '').trim();
            if (bill && bill.TrueNotes && bill.TrueNotes.trim() !== '') {
                cleaned = bill.TrueNotes.trim();
            }
            if (cleaned !== '') {
                $("#LRD_Notes").html('<strong>' + cleaned + '</strong>');
            }


        }
