var g_botData = { verified: [], nonverified: [], approved: [], nonapproved: [] };

function storeBotData(verified, nonVerified, approved, nonApproved) {
    g_botData.verified    = verified    || [];
    g_botData.nonverified = nonVerified || [];
    g_botData.approved    = approved    || [];
    g_botData.nonapproved = nonApproved || [];
}

function filterBotTable(key, query) {
    var q    = (query || '').toLowerCase().trim();
    var list = g_botData[key] || [];

    var filtered = q === '' ? list : list.filter(function (r) {
        return (
            String(r.billNo      || '').toLowerCase().indexOf(q) !== -1 ||
            String(r.regNo       || '').toLowerCase().indexOf(q) !== -1 ||
            String(r.patientName || '').toLowerCase().indexOf(q) !== -1 ||
            String(r.doctorName  || '').toLowerCase().indexOf(q) !== -1 ||
            String(r.date        || '').toLowerCase().indexOf(q) !== -1
        );
    });

    if (key === 'nonverified') {
        document.getElementById('tbody-nonverified').innerHTML = buildNonVerifiedRows(filtered);
    } else if (key === 'nonapproved') {
        document.getElementById('tbody-nonapproved').innerHTML = buildNonApprovedRows(filtered);
    } else {
        document.getElementById('tbody-' + key).innerHTML = buildPatientRows(filtered, 6);
    }
}


var g_recentBillsHTML = [];

function buildRecentBillRowObj(sl, billNo, regNo, opNo, date, time,
    patientName, ageSex, contact, doctorName, shiftName,
    billNoFull, statusBadge, verBadge, appBadge) {
    return {
        sl: sl,
        billNo      : String(billNo      || ''),
        regNo       : String(regNo       || ''),
        opNo        : String(opNo        || ''),
        date        : String(date        || ''),
        time        : String(time        || ''),
        patientName : String(patientName || ''),
        ageSex      : String(ageSex      || ''),
        contact     : String(contact     || ''),
        doctorName  : String(doctorName  || ''),
        shiftName   : String(shiftName   || ''),
        billNoFull  : String(billNoFull  || ''),
        statusBadge : statusBadge,
        verBadge    : verBadge,
        appBadge    : appBadge
    };
}

function renderRecentBillsTable(list) {
    if (!list || !list.length) {
        document.getElementById('tbody-recent-bills').innerHTML =
            '<tr><td colspan="15" style="text-align:center;padding:20px;color:#aaa;">No records found.</td></tr>';
        return;
    }
    var h = '';
    for (var i = 0; i < list.length; i++) {
        var r = list[i];
        h += '<tr>' +
            '<td>' + (i + 1)       + '</td>' +
            '<td><a href="#">'     + r.billNo      + '</a></td>' +
            '<td>'                 + r.regNo       + '</td>' +
            '<td>'                 + r.opNo        + '</td>' +
            '<td>'                 + r.date        + '</td>' +
            '<td>'                 + r.time        + '</td>' +
            '<td>'                 + r.patientName + '</td>' +
            '<td>'                 + r.ageSex      + '</td>' +
            '<td>'                 + r.contact     + '</td>' +
            '<td>'                 + r.doctorName  + '</td>' +
            '<td>'                 + r.shiftName   + '</td>' +
            '<td>'                 + r.billNoFull  + '</td>' +
            '<td>'                 + r.statusBadge + '</td>' +
            '<td>'                 + r.verBadge    + '</td>' +
            '<td>'                 + r.appBadge    + '</td>' +
        '</tr>';
    }
    document.getElementById('tbody-recent-bills').innerHTML = h;
}

function filterRecentBills(query) {
    var q = (query || '').toLowerCase().trim();
    if (q === '') { renderRecentBillsTable(g_recentBillsHTML); return; }
    var filtered = g_recentBillsHTML.filter(function (r) {
        return (
            r.billNo.toLowerCase().indexOf(q)      !== -1 ||
            r.regNo.toLowerCase().indexOf(q)       !== -1 ||
            r.opNo.toLowerCase().indexOf(q)        !== -1 ||
            r.patientName.toLowerCase().indexOf(q) !== -1 ||
            r.doctorName.toLowerCase().indexOf(q)  !== -1 ||
            r.date.toLowerCase().indexOf(q)        !== -1 ||
            r.contact.toLowerCase().indexOf(q)     !== -1
        );
    });
    renderRecentBillsTable(filtered);
}

