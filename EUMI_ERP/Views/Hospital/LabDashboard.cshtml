<script>

    $(document).ready(function () {
        document.title = "Laboratory Dashboard";

    });

var chartVerification, chartDaily, chartStatus;
var STATUS_COLORS = ['#4F46E5', '#F59E0B'];

function initCharts() {

    var ctxV = document.getElementById('chartVerification').getContext('2d');

    chartVerification = new Chart(ctxV, {
        type: 'bar',
        data: {
            labels: ['Verified', 'Non Verified', 'Approved', 'Non Approved'],
            datasets: [{
                data: [0, 0, 0, 0],
                backgroundColor: ['#06B6D4', '#F59E0B', '#22C55E', '#EF4444'],
                borderWidth: 0,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: {
                duration: 1400,
                easing: 'easeOutQuart'
            },
            legend: { display: false },
            scales: {
                xAxes: [{ gridLines: { display: false }, ticks: { fontSize: 11 } }],
                yAxes: [{ ticks: { beginAtZero: true, fontSize: 11 }, gridLines: { color: '#F1F5F9' } }]
            }
        }
    });

    var ctxD = document.getElementById('chartDaily').getContext('2d');
    var grad = ctxD.createLinearGradient(0, 0, 0, 200);
    grad.addColorStop(0, 'rgba(79,70,229,0.35)');
    grad.addColorStop(1, 'rgba(79,70,229,0.02)');
    chartDaily = new Chart(ctxD, {
        type: 'line',
        data: {
            labels: [],
            datasets: [{
                label: 'Bills',
                data: [],
                borderColor: '#4F46E5',
                backgroundColor: grad,
                borderWidth: 2.5,
                fill: true,
                lineTension: 0.45,
                pointBackgroundColor: '#4F46E5',
                pointRadius: 4,
                pointHoverRadius: 7,
                pointBorderColor: '#fff',
                pointBorderWidth: 2
            }]
        },
        options: {
