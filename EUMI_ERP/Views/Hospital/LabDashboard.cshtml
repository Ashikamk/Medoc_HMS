            .icon-blue i {
                color: var(--info);
            }

            .icon-orange i {
                color: var(--warning);
            }

            .icon-green i {
                color: var(--success);
            }

            .icon-red i {
                color: var(--danger);
            }

        /* ══════════════════════════════════════════
           SEARCH BOX
        ══════════════════════════════════════════ */

        .tbl-search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #ffffff;
            border: 1.5px solid var(--border);
            border-radius: 999px;
            padding: 0 14px;
            height: 36px;
            transition: border-color .2s, box-shadow .2s;
        }

            .tbl-search-box:focus-within {
                border-color: var(--indigo);
                box-shadow: 0 0 0 3px rgba(79,70,229,.12);
            }

            .tbl-search-box input[type="text"] {
                background: transparent;
                border: none;
                outline: none;
                color: var(--text);
                font-size: 14px;
                font-weight: 500;
                width: 170px;
                font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

                .tbl-search-box input[type="text"]::placeholder {
                    color: #A3ADBD;
                }

        /* ══════════════════════════════════════════
           LAYOUT ROWS
        ══════════════════════════════════════════ */

        .pending-actions-row {
            display: grid;
            grid-template-columns: 9fr 1fr;
            gap: 16px;
            margin-bottom: 20px;
        }

        .bot-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        /* ══════════════════════════════════════════
           TABLE SCROLL — each table scrolls independently
        ══════════════════════════════════════════ */

        .tbl-scroll {
            margin: 4px 8px 8px 8px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .bot-row .tbl-scroll {
            margin: 4px 10px 10px 10px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .tbl-scroll::-webkit-scrollbar {
            height: 8px;
        }

        .tbl-scroll::-webkit-scrollbar-thumb {
            background: #D6DCEB;
            border-radius: 4px;
        }

        .tbl-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        /* ══════════════════════════════════════════
           DASH TABLE
        ══════════════════════════════════════════ */

        .dash-table {
            width: 100%;
            min-width: 980px;
            border-collapse: collapse;
        }

            .dash-table thead tr {
                background: #F8FAFF;
            }

            .dash-table thead th {
                padding: 12px 14px;
                text-align: left;
                font-size: 16px;
                font-weight: 800;
                letter-spacing: .5px;
                text-transform: uppercase;
                color: #475569;
                border-bottom: 1.5px solid var(--border);
                white-space: nowrap;
                position: sticky;
                top: 0;
                z-index: 2;
                background: #F8FAFF;
            }

            .dash-table tbody tr {
                border-bottom: 1px solid #EEF1F6;
                animation: slideInRow 0.3s ease both;
                transition: background 0.2s, transform 0.15s;
            }

                .dash-table tbody tr:nth-child(even) {
                    background: #FAFBFF;
                }

                .dash-table tbody tr:last-child {
                    border-bottom: none;
                }

                .dash-table tbody tr:hover {
                    transform: scale(1.003);
                    background: var(--indigo-light) !important;
                }

            .dash-table tbody td {
                padding: 11px 14px;
                color: #334155;
                white-space: nowrap;
                font-size: 17px;
            }

                .dash-table tbody td a {
                    color: var(--indigo);
                    font-weight: 700;
                    text-decoration: none;
                }

                    .dash-table tbody td a:hover {
                        text-decoration: underline;
                    }

        /* ══════════════════════════════════════════
           BADGES
        ══════════════════════════════════════════ */

        .badge-result, .badge-pending, .badge-verified,
        .badge-unverified, .badge-approved, .badge-unapproved {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-weight: 700;
            font-size: 12px;
            padding: 5px 12px;
            border-radius: 999px;
            animation: rotateBadge 0.4s ease both;
            transition: transform 0.2s;
            letter-spacing: .2px;
        }

            .badge-result::before, .badge-pending::before, .badge-verified::before,
            .badge-unverified::before, .badge-approved::before, .badge-unapproved::before {
                content: "";
                width: 6px;
                height: 6px;
                border-radius: 50%;
            }

            .badge-result:hover, .badge-pending:hover,
            .badge-verified:hover, .badge-unverified:hover,
            .badge-approved:hover, .badge-unapproved:hover {
                transform: scale(1.06);
            }

        .badge-result {
            background: var(--success-light);
            color: #15803D;
            border: 1px solid #BBF7D0;
        }

            .badge-result::before {
                background: var(--success);
            }

        .badge-pending {
            background: var(--warning-light);
            color: #B45309;
            border: 1px solid #FDE68A;
            animation: rotateBadge .4s ease both, ripple 2s ease-in-out .4s infinite;
        }

            .badge-pending::before {
                background: var(--warning);
            }

        .badge-verified {
            background: var(--info-light);
            color: #0E7490;
            border: 1px solid #A5F3FC;
        }

            .badge-verified::before {
                background: var(--info);
            }

        .badge-unverified {
            background: #FFF1E6;
            color: #C2410C;
            border: 1px solid #FED7AA;
            animation: rotateBadge .4s ease both, rippleBlue 2s ease-in-out .4s infinite;
        }

            .badge-unverified::before {
                background: #F97316;
            }

        .badge-approved {
            background: var(--success-light);
            color: #15803D;
            border: 1px solid #BBF7D0;
        }

            .badge-approved::before {
                background: var(--success);
            }

        .badge-unapproved {
            background: var(--danger-light);
            color: #B91C1C;
            border: 1px solid #FECACA;
            animation: rotateBadge .4s ease both, rippleRed 2s ease-in-out .4s infinite;
        }

            .badge-unapproved::before {
                background: var(--danger);
            }

        /* ══════════════════════════════════════════
           QUICK ACTIONS
        ══════════════════════════════════════════ */

        .qa-card {
            display: flex;
            flex-direction: column;
            align-self: stretch;
            animation-delay: 0.3s;
        }

    .qa-grid {
        padding: 24px 10px; /* was 10px — increases top/bottom space, grows card height */
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
        justify-content: space-evenly;
        align-items: center;
        min-height: 260px; /* new — sets a taller floor for the whole box */
    }
    .qa-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px; /* was 6px */
        border-radius: 5px;
        padding: 8px 10px; /* was 16px 10px */
        text-decoration: none;
        font-size: 15px; /* was 13px, optional tweak */
        font-weight: 700;
        text-align: center;
        flex: 0 1 auto;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s, border-color .2s, background .2s;
        background: #F0F3FA;
        box-shadow: 6px 6px 12px #d1d5e0, -6px -6px 12px #ffffff;
    }
    
    .qa-btn:hover {
            box-shadow: 3px 3px 8px #d1d5e0, -3px -3px 8px #ffffff;
        }

            .qa-btn:hover {
                transform: translateY(-4px) scale(1.02);
                text-decoration: none;
            }

    .qa-card.qa-horizontal .qa-grid {
        flex-direction: row;
        gap: 14px;
        padding: 24px 16px; /* was 16px */
        justify-content: center;
        min-height: 140px; /* NEW */
    }
    .qa-card.qa-horizontal .qa-btn {
        padding: 12px 14px; /* slightly more horizontal padding */
        max-width: 1000px; /* was 130px */
    }

        /* ══════════════════════════════════════════
           ACTION BUTTONS
        ══════════════════════════════════════════ */

        .btn-add-result,
        .btn-add-verification,
        .btn-add-approval {
            position: relative;
            border-radius: 999px !important;
            box-shadow: var(--shadow-sm);
            transition: transform .15s, box-shadow .15s;
        }

            .btn-add-result:hover,
            .btn-add-verification:hover,
            .btn-add-approval:hover {
                transform: translateY(-1px);
            }

        .btn-add-result {
            animation: ripple 1.8s ease-in-out infinite;
            background: linear-gradient(135deg, var(--indigo) 0%, var(--indigo-dark) 100%) !important;
        }

        .btn-add-verification {
            animation: rippleBlue 1.8s ease-in-out infinite;
            background: linear-gradient(135deg, var(--info) 0%, #0891B2 100%) !important;
        }

        .btn-add-approval {
            animation: rippleRed 1.8s ease-in-out infinite;
            background: linear-gradient(135deg, var(--success) 0%, #16A34A 100%) !important;
        }

        /* ══════════════════════════════════════════
           ROW HIGHLIGHTS (pending / non-verified / non-approved)
        ══════════════════════════════════════════ */

        #tbody-pending-queue tr {
            animation: pendingPulse 2.5s ease-in-out infinite;
            border-left: 4px solid var(--warning) !important;
            transition: all 0.3s;
        }

            #tbody-pending-queue tr:hover {
                animation: none;
                background: var(--warning-light) !important;
                border-left: 4px solid #D97706 !important;
                transform: scale(1.005) translateX(3px);
            }

        #tbody-nonverified tr {
            animation: nonVerifiedPulse 2.5s ease-in-out infinite;
            border-left: 4px solid var(--info) !important;
            transition: all 0.3s;
        }

            #tbody-nonverified tr:hover {
                animation: none;
                background: var(--info-light) !important;
                border-left: 4px solid #0891B2 !important;
                transform: scale(1.005) translateX(3px);
            }

        #tbody-nonapproved tr {
            animation: nonApprovedPulse 2.5s ease-in-out infinite;
            border-left: 4px solid var(--danger) !important;
            transition: all 0.3s;
        }

            #tbody-nonapproved tr:hover {
                animation: none;
                background: var(--danger-light) !important;
                border-left: 4px solid #DC2626 !important;
                transform: scale(1.005) translateX(3px);
            }

        #tbody-pending-queue tr:nth-child(1) {
            animation-delay: 0.0s;
        }

        #tbody-pending-queue tr:nth-child(2) {
            animation-delay: 0.2s;
        }

        #tbody-pending-queue tr:nth-child(3) {
            animation-delay: 0.4s;
        }

        #tbody-pending-queue tr:nth-child(4) {
            animation-delay: 0.6s;
        }

        #tbody-pending-queue tr:nth-child(5) {
            animation-delay: 0.8s;
        }

        #tbody-nonverified tr:nth-child(1) {
            animation-delay: 0.1s;
        }

        #tbody-nonverified tr:nth-child(2) {
            animation-delay: 0.3s;
        }

        #tbody-nonverified tr:nth-child(3) {
            animation-delay: 0.5s;
        }

        #tbody-nonverified tr:nth-child(4) {
            animation-delay: 0.7s;
        }

        #tbody-nonverified tr:nth-child(5) {
            animation-delay: 0.9s;
        }

        #tbody-nonapproved tr:nth-child(1) {
            animation-delay: 0.15s;
        }

        #tbody-nonapproved tr:nth-child(2) {
            animation-delay: 0.35s;
        }

        #tbody-nonapproved tr:nth-child(3) {
            animation-delay: 0.55s;
        }

        #tbody-nonapproved tr:nth-child(4) {
            animation-delay: 0.75s;
        }

        #tbody-nonapproved tr:nth-child(5) {
            animation-delay: 0.95s;
        }

        /* ══════════════════════════════════════════
           KEYFRAMES (only the ones in use)
        ══════════════════════════════════════════ */

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes flyUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes slideL {
            from {
                opacity: 0;
                transform: translateX(-32px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes slideR {
            from {
                opacity: 0;
                transform: translateX(32px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes rollIn {
            from {
                opacity: 0;
                transform: scale(.5);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        @@keyframes popIn {
            from {
                opacity: 0;
                transform: scale(.3);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        @@keyframes slideInRow {
            from {
                opacity: 0;
                transform: translateX(-12px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes rotateBadge {
            from {
                transform: scale(.7);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        @@keyframes ripple {
            0% {
                box-shadow: 0 0 0 0 rgba(79,70,229,.45);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(79,70,229,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(79,70,229,0);
            }
        }

        @@keyframes rippleRed {
            0% {
                box-shadow: 0 0 0 0 rgba(34,197,94,.45);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(34,197,94,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(34,197,94,0);
            }
        }

        @@keyframes rippleBlue {
            0% {
                box-shadow: 0 0 0 0 rgba(6,182,212,.45);
            }

            70% {
                box-shadow: 0 0 0 10px rgba(6,182,212,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(6,182,212,0);
            }
        }

        @@keyframes pendingPulse {
            0%, 100% {
                border-left-color: var(--warning);
                background: #fff;
            }

            50% {
                border-left-color: #D97706;
                background: #FFFBF0;
            }
        }

        @@keyframes nonVerifiedPulse {
            0%, 100% {
                border-left-color: var(--info);
                background: #fff;
            }

            50% {
                border-left-color: #0891B2;
                background: #F0FDFF;
            }
        }

        @@keyframes nonApprovedPulse {
            0%, 100% {
                border-left-color: var(--danger);
                background: #fff;
            }

            50% {
                border-left-color: #DC2626;
                background: #FFF5F5;
            }
        }

