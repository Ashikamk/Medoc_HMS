                $("#LRD_VerifiedBy").val('');
                $("#LRD_LabIncharge").val('');
                $("#LRD_VerifiedIcon").html('<span style="color:red;font-size:22px;">&#10006;</span>');
                $("#LRD_ApprovedIcon").html('<span style="color:red;font-size:22px;">&#10006;</span>');
                return;
            }

            console.log("LoadUserDropdowns BillNo = ", billNo);

            $.ajax({
                type: "POST",
                url: '@Url.Action("HMS_LabResultVerificationGet", "Revisit")',
                data: { SampleId: billNo },
                success: function (res) {

                    console.log("VerificationGet result = ", res);

                    if (res.oList && res.oList.length > 0) {
                        var saved = res.oList[0];
                        var vUser = parseInt(saved.VerifiedUser || 0);
                        var aUser = parseInt(saved.ApprovedUser || 0);

                        if (vUser > 0) {
                            $("#LRD_VerifiedBy").val(vUser);

                            console.log("Set VerifiedBy to:", vUser, "| Dropdown shows:", $("#LRD_VerifiedBy").val());
                            $("#LRD_VerifiedIcon").html('<span style="color:green;font-size:22px;">&#10004;</span>');
                        } else {
                            $("#LRD_VerifiedBy").val('');
                            $("#LRD_VerifiedIcon").html('<span style="color:red;font-size:22px;">&#10006;</span>');
                        }

                        if (aUser > 0) {
                            $("#LRD_LabIncharge").val(aUser);
                            $("#LRD_ApprovedIcon").html('<span style="color:green;font-size:22px;">&#10004;</span>');
                        } else {
                            $("#LRD_LabIncharge").val('');
                            $("#LRD_ApprovedIcon").html('<span style="color:red;font-size:22px;">&#10006;</span>');
                        }
                    } else {
                        $("#LRD_VerifiedBy").val('');
                        $("#LRD_LabIncharge").val('');
                        $("#LRD_VerifiedIcon").html('<span style="color:red;font-size:22px;">&#10006;</span>');
                        $("#LRD_ApprovedIcon").html('<span style="color:red;font-size:22px;">&#10006;</span>');
                    }
                },
                error: function (xhr) {
                    console.error("VerificationGet error:", xhr.responseText);
                    $("#LRD_VerifiedBy").val('');
                    $("#LRD_LabIncharge").val('');
                    $("#LRD_VerifiedIcon").html('<span style="color:red;font-size:22px;">&#10006;</span>');
                    $("#LRD_ApprovedIcon").html('<span style="color:red;font-size:22px;">&#10006;</span>');
                }
            });
        }
    });
    }

        function SaveApprovedBy() {
    var billNo = window._currentBill ? window._currentBill.BillNo : 0;
    var patientId = window._currentPatientId || 0;
    var regNo = window._currentRegNo || 0;
    var approvedUser = $("#LRD_LabIncharge").val();
    var verifiedUser = $("#LRD_VerifiedBy").val();
    var sampleDate = $("#LRD_CollDate").text();

    if (!billNo || billNo == 0) { swal("Please open a lab result first.", "", "warning"); return; }

