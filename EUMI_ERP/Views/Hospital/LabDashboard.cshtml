@{
    ViewBag.Title = "LabDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<style>

        /* ══════════════════════════════════════════
           MODAL — LAB RESULT DETAIL
        ══════════════════════════════════════════ */

        #LRD_TestBody tr {
            border-bottom: 1px solid #EEF1F6;
        }

        #LRD_TestBody td {
            padding: 11px 12px !important;
            font-size: 14.5px !important;
        }

            #LRD_TestBody td:first-child {
                font-weight: 600 !important;
            }

            #LRD_TestBody td:nth-child(3),
            #LRD_TestBody td:nth-child(4) {
                color: #1E293B !important;
            }

        #LRD_TestBody .lab-dept-header td {
            background: linear-gradient(135deg, #EEF2FF 0%, #ECFEFF 100%) !important;
            font-weight: 800 !important;
            font-size: 13px !important;
            letter-spacing: .6px;
            text-transform: uppercase;
            color: #4338CA !important;
            text-align: center !important;
            padding: 9px 12px !important;
        }

        /* ══════════════════════════════════════════
       PAGINATION CONTROLS (DataTable-style)
    ══════════════════════════════════════════ */
        .dt-controls {
            display: flex;
            align-items: center;
            padding: 10px 18px 4px;
            font-size: 13.5px;
            color: var(--sub);
        }

            .dt-controls select {
                margin: 0 6px;
                padding: 4px 8px;
                border: 1px solid var(--border);
                border-radius: 6px;
                font-size: 13.5px;
                background: #fff;
                cursor: pointer;
            }

        .dt-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 18px 16px;
            font-size: 13.5px;
            color: var(--sub);
            flex-wrap: wrap;
            gap: 8px;
        }

        .dt-pagination {
            display: flex;
            gap: 4px;
        }

        .dt-page-btn {
            border: 1px solid var(--border);
            background: #fff;
            color: var(--text);
            font-size: 13px;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 6px;
            cursor: pointer;
            transition: background .15s, color .15s, border-color .15s;
        }

            .dt-page-btn:hover:not(:disabled) {
                background: var(--indigo-light);
                border-color: var(--indigo);
                color: var(--indigo-dark);
            }

            .dt-page-btn.active {
                background: var(--indigo);
                border-color: var(--indigo);
                color: #fff;
            }

            .dt-page-btn:disabled {
                opacity: .4;
                cursor: not-allowed;
            }
        /* ══════════════════════════════════════════
           RESET & DESIGN TOKENS
        ══════════════════════════════════════════ */

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --indigo: #4F46E5;
            --indigo-dark: #4338CA;
            --indigo-light: #EEF2FF;
            --info: #06B6D4;
            --info-light: #ECFEFF;
            --success: #22C55E;
            --success-light: #F0FDF4;
            --warning: #F59E0B;
            --warning-light: #FFFBEB;
            --danger: #EF4444;
            --danger-light: #FEF2F2;
            --purple: #8B5CF6;
            --purple-light: #F5F3FF;
            /* legacy aliases kept so nothing else in this file breaks */
            --teal: #4F46E5;
            --teal-dark: #4338CA;
            --teal-light: #EEF2FF;
            --orange: #F59E0B;
            --orange-bg: #FFFBEB;
            --blue: #06B6D4;
            --blue-bg: #ECFEFF;
            --green: #22C55E;
            --green-bg: #F0FDF4;
            --red: #EF4444;
            --red-bg: #FEF2F2;
            --purple-bg: #F5F3FF;
            --text: #1E293B;
            --sub: #64748B;
            --border: #E7EBF3;
            --bg: #F8FAFC;
            --card: #ffffff;
            --header-h: 76px;
            --radius-lg: 18px;
            --radius-md: 12px;
            --radius-sm: 9px;
            --shadow-sm: 0 1px 3px rgba(15,23,42,.05);
            --shadow-md: 0 6px 20px rgba(15,23,42,.07);
            --shadow-lg: 0 16px 40px rgba(79,70,229,.14);
        }

        body {
            background: radial-gradient(1100px 420px at 100% -10%, #EEF2FF 0%, rgba(238,242,255,0) 60%), radial-gradient(900px 380px at -10% 0%, #ECFEFF 0%, rgba(236,254,255,0) 55%), var(--bg);
            font-family: 'Inter', 'Segoe UI Variable', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text);
            font-size: 15px;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ══════════════════════════════════════════
           TOPBAR (full-bleed, premium light header)
        ══════════════════════════════════════════ */

        .lab-topbar {
            background: rgba(255,255,255,.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            height: 76px;
            display: flex;
            align-items: center;
            padding: 0 32px;
            justify-content: space-between;
            border-radius: 0;
            border-bottom: 1px solid var(--border);
            box-shadow: 0 4px 24px rgba(79,70,229,.06);
            position: relative;
            z-index: 950;
            width: calc(100% + 40px);
            margin-left: -20px;
            margin-right: -20px;
            margin-top: -20px;
            margin-bottom: 18px;
        }

    /* Pending Queue — amber */
    
        .qa-grid .qa-btn:nth-child(4):hover {
            background: var(--warning-light);
            border-color: var(--warning);
            box-shadow: 0 10px 28px rgba(245,158,11,.22);
        }

    /* Non Verified — orange */
    

        .qa-grid .qa-btn:nth-child(5):hover {
            background: #FFF1E6;
            border-color: #F97316;
            box-shadow: 0 10px 28px rgba(249,115,22,.22);
        }

    

        .qa-grid .qa-btn:nth-child(6):hover {
            background: var(--danger-light);
            border-color: var(--danger);
            box-shadow: 0 10px 28px rgba(239,68,68,.22);
        }

    /* New Lab Bill — indigo */
    .qa-grid .qa-btn:nth-child(1) {
        border: 2px solid #C7D2FE;
        color: var(--indigo-dark);
        background: linear-gradient(180deg, #ffffff 0%, #FAFAFF 100%);
    }

    /* Lab Worksheet — info blue */
    .qa-grid .qa-btn:nth-child(2) {
        border: 2px solid #A5F3FC;
        color: #0E7490;
        background: linear-gradient(180deg, #ffffff 0%, #FAFEFF 100%);
    }

    /* Lab Result — success green */
    .qa-grid .qa-btn:nth-child(3) {
        border: 2px solid #BBF7D0;
        color: #15803D;
        background: linear-gradient(180deg, #ffffff 0%, #FAFFFC 100%);
    }

    /* Pending Queue — amber */
    .qa-grid .qa-btn:nth-child(4) {
        border: 2px solid #FDE68A;
        color: #B45309;
        background: linear-gradient(180deg, #ffffff 0%, #FFFDF7 100%);
    }

    /* Non Verified — orange */
    .qa-grid .qa-btn:nth-child(5) {
        border: 2px solid #FED7AA;
        color: #C2410C;
        background: linear-gradient(180deg, #ffffff 0%, #FFFAF5 100%);
    }

    /* Non Approved — red */
    .qa-grid .qa-btn:nth-child(6) {
        border: 2px solid #FECACA;
        color: #B91C1C;
        background: linear-gradient(180deg, #ffffff 0%, #FFF9F9 100%);
    }


        .topbar-filter {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .topbar-filter label {
                font-size: 12.5px;
                font-weight: 700;
                color: var(--sub);
                letter-spacing: .3px;
                text-transform: uppercase;
            }

            .topbar-filter input[type="text"] {
                font-size: 14px;
                font-weight: 600;
                color: var(--text);
                background: #F1F5FB;
                border: 1.5px solid transparent;
                border-radius: 10px;
                padding: 0 14px;
                height: 40px;
                outline: none;
                cursor: pointer;
                transition: border-color .15s, background .15s, box-shadow .15s;
            }

                .topbar-filter input[type="text"]:focus,
                .topbar-filter input[type="text"]:hover {
                    background: #ffffff;
                    border-color: var(--indigo);
                    box-shadow: 0 0 0 3px rgba(79,70,229,.12);
                }

            .topbar-filter .btn-dash-apply,
            .topbar-filter .btn-dash-today {
                font-size: 14px;
                font-weight: 700;
                border: none;
                border-radius: 10px;
                padding: 0 18px;
                height: 40px;
                cursor: pointer;
                transition: transform .15s, opacity .15s, box-shadow .15s;
            }

            .topbar-filter .btn-dash-apply {
                background: linear-gradient(135deg, var(--indigo) 0%, var(--indigo-dark) 100%);
                color: #ffffff;
                box-shadow: 0 8px 20px rgba(79,70,229,.28);
            }

                .topbar-filter .btn-dash-apply:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 10px 24px rgba(79,70,229,.36);
                }

            .topbar-filter .btn-dash-today {
                background: var(--warning-light);
                color: #B45309;
                border: 1px solid #FDE7B8;
            }

                .topbar-filter .btn-dash-today:hover {
                    background: var(--warning);
                    color: #fff;
                    transform: translateY(-1px);
                }

        .lab-topbar .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .lab-topbar .brand h1 {
                font-size: 20px;
                font-weight: 800;
                color: var(--text);
                letter-spacing: .3px;
                margin: 0;
            }

        /* ══════════════════════════════════════════
           SIDE NAVBAR (clean white panel)
        ══════════════════════════════════════════ */

        .lab-sidenav {
            position: fixed;
            top: 76px;
            height: calc(100vh - 76px);
            left: 0;
            width: 264px;
            background: #ffffff;
            border-right: 1px solid var(--border);
            padding: 18px 14px 20px 14px;
            z-index: 900;
            box-shadow: 2px 0 16px rgba(15,23,42,.03);
            overflow-y: auto;
        }

        .lab-page {
            margin-left: 264px;
        }

        .lab-footer {
            margin-left: 264px;
        }

        .lab-sidenav .nav-item {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 13px 16px;
            margin-bottom: 4px;
            color: var(--sub);
            font-size: 14.5px;
            font-weight: 600;
            text-decoration: none;
            border-radius: var(--radius-sm);
            border-left: 3px solid transparent;
            transition: background .18s, color .18s, transform .12s;
            white-space: nowrap;
        }

            .lab-sidenav .nav-item i {
                display: inline-block;
                width: 20px;
                text-align: center;
                font-size: 15px;
                color: #94A3B8;
                transition: color .18s;
            }

            .lab-sidenav .nav-item:hover {
                background: #F5F7FF;
                color: var(--indigo-dark);
                text-decoration: none;
                transform: translateX(2px);
            }

                .lab-sidenav .nav-item:hover i {
                    color: var(--indigo);
                }

            .lab-sidenav .nav-item.active {
                background: linear-gradient(135deg, var(--indigo-light) 0%, var(--info-light) 100%);
                color: var(--indigo-dark);
                border-left: 3px solid var(--indigo);
                box-shadow: var(--shadow-sm);
            }

                .lab-sidenav .nav-item.active i {
                    color: var(--indigo);
                }

        /* ═══════ Quick Action button border colors ═══════ */

        /* New Lab Bill — indigo */
        

            .qa-grid .qa-btn:nth-child(1):hover {
                background: var(--indigo-light);
                border-color: var(--indigo);
                box-shadow: 0 10px 28px rgba(79,70,229,.22);
            }


            .qa-grid .qa-btn:nth-child(2):hover {
                background: var(--info-light);
                border-color: var(--info);
                color: #0E7490;
                box-shadow: 0 10px 28px rgba(6,182,212,.22);
            }

     

            .qa-grid .qa-btn:nth-child(3):hover {
                background: var(--success-light);
                border-color: var(--success);
                color: #15803D;
                box-shadow: 0 10px 28px rgba(34,197,94,.22);
            }

        /* ══════════════════════════════════════════
           ICONS — shown as part of the premium redesign
        ══════════════════════════════════════════ */

        .kpi-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 45px;
            flex-shrink: 0;
        }
    .qa-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px; /* was 38px */
        margin: 0 auto 2px;
        background: none;
    }

        .tbl-title i {
            font-size: 14px;
        }

        .tbl-search-box i {
            font-size: 13px;
            color: #94A3B8;
        }

        /* ══════════════════════════════════════════
           PAGE LAYOUT + STICKY-BOTTOM FOOTER
        ══════════════════════════════════════════ */

        .lab-page {
            padding: 20px 24px 30px;
            margin-right: -20px;
            min-height: calc(100vh - 100px);
            display: flex;
            flex-direction: column;
        }

        .lab-footer {
            display: flex;
            justify-content: space-between;
            padding: 14px 24px;
            font-size: 13.5px;
            color: var(--sub);
            border-top: 1px solid var(--border);
            background: var(--card);
            margin-top: auto;
            animation: fadeInUp 0.5s ease both;
            animation-delay: 0.6s;
            position: relative;
            width: calc(100% + 40px);
            margin-left: -20px;
            margin-right: -20px;
            z-index: 901;
        }

        /* ══════════════════════════════════════════
           KPI CARDS
        ══════════════════════════════════════════ */

        .kpi-row {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 14px;
            margin-bottom: 20px;
        }

    .kpi-card {
        border-radius: var(--radius-lg);
        border: none;
        padding: 20px 20px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 13px;
        box-shadow: 0 8px 20px rgba(15,23,42,.15);
        transition: transform .18s, box-shadow .18s;
        opacity: 0;
        animation: flyUp 0.55s cubic-bezier(.22,.9,.4,1) both;
        position: relative;
        overflow: hidden;
        color: #ffffff;
    }

        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(15,23,42,.22);
        }

        .kpi-card .kpi-icon {
            order: 2;
            background: rgba(255,255,255,.18) !important;
            color: #ffffff !important;
        }

        .kpi-card .kpi-body {
            order: 1;
        }

            .kpi-card:nth-child(1) {
                animation-delay: 0.05s;
            }

            .kpi-card:nth-child(2) {
                animation-delay: 0.12s;
            }

            .kpi-card:nth-child(3) {
                animation-delay: 0.19s;
            }

            .kpi-card:nth-child(4) {
                animation-delay: 0.26s;
            }

            .kpi-card:nth-child(5) {
                animation-delay: 0.33s;
            }

            .kpi-card:nth-child(6) {
                animation-delay: 0.40s;
            }

            .kpi-card:nth-child(7) {
                animation-delay: 0.47s;
            }

        .kpi-body {
            flex: 1;
            min-width: 0;
        }

        .kpi-label {
            font-size: 17px;
            font-weight: 700;
            letter-spacing: .6px;
            text-transform: uppercase;
            color: var(--sub);
            margin-bottom: 4px;
        }

        .kpi-value {
            font-size: 32px;
            font-weight: 800;
            line-height: 1;
            color: var(--text);
            letter-spacing: -.5px;
            animation: rollIn 0.8s cubic-bezier(.23,1.12,.4,1) both;
            animation-delay: 0.4s;
        }

        .kpi-sub {
            font-size: 12.5px;
            font-weight: 600;
            margin-top: 6px;
        }

    .kpi-teal {
        background: linear-gradient(135deg, #DB2777 0%, #831843 100%); /* Magenta/Pink - Total Bills */
    }

        .kpi-teal .kpi-label, .kpi-teal .kpi-value, .kpi-teal .kpi-sub {
            color: #ffffff;
        }

        .kpi-teal .kpi-sub {
            opacity: .85;
        }

    .kpi-orange {
        background: linear-gradient(135deg, #7C3AED 0%, #4C1D95 100%); /* Purple - Pending Tests */
    }

        .kpi-orange .kpi-label, .kpi-orange .kpi-value, .kpi-orange .kpi-sub {
            color: #ffffff;
        }

        .kpi-orange .kpi-sub {
            opacity: .85;
        }

    .kpi-green {
        background: linear-gradient(135deg, #1E1B3A 0%, #0F0D24 100%); /* Dark Navy - Completed Tests */
    }

        .kpi-green .kpi-label, .kpi-green .kpi-value, .kpi-green .kpi-sub {
            color: #ffffff;
        }

        .kpi-green .kpi-sub {
            opacity: .85;
        }

    .kpi-blue {
        background: linear-gradient(135deg, #6366F1 0%, #4338CA 100%); /* Blue-Indigo - Verified Reports */
    }

        .kpi-blue .kpi-label, .kpi-blue .kpi-value, .kpi-blue .kpi-sub {
            color: #ffffff;
        }

        .kpi-blue .kpi-sub {
            opacity: .85;
        }

    .kpi-rose {
        background: linear-gradient(135deg, #F97316 0%, #C2410C 100%); /* Orange-Red - Non Verified (NEW) */
    }

        .kpi-rose .kpi-label, .kpi-rose .kpi-value, .kpi-rose .kpi-sub {
            color: #ffffff;
        }

        .kpi-rose .kpi-sub {
            opacity: .85;
        }

    .kpi-purple {
        background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%); /* Red - Approved Reports */
    }

        .kpi-purple .kpi-label, .kpi-purple .kpi-value, .kpi-purple .kpi-sub {
            color: #ffffff;
        }

        .kpi-purple .kpi-sub {
            opacity: .85;
        }

    .kpi-crimson {
        background: linear-gradient(135deg, #16A34A 0%, #065F46 100%); /* Green - Non Approved */
    }

        .kpi-crimson .kpi-label, .kpi-crimson .kpi-value, .kpi-crimson .kpi-sub {
            color: #ffffff;
        }

        .kpi-crimson .kpi-sub {
            opacity: .85;
        }
        .kpi-teal::before {
            background: linear-gradient(180deg, var(--indigo), var(--indigo-dark));
        }

        .kpi-teal .kpi-icon {
            background: var(--indigo-light);
            color: var(--indigo);
        }

        .kpi-teal .kpi-sub {
            color: var(--sub);
        }

        .kpi-orange::before {
            background: linear-gradient(180deg, var(--warning), #D97706);
        }

        .kpi-orange .kpi-icon {
            background: var(--warning-light);
            color: var(--warning);
        }

        .kpi-orange .kpi-sub {
            color: #B45309;
        }

        .kpi-green::before {
            background: linear-gradient(180deg, var(--success), #16A34A);
        }

        .kpi-green .kpi-icon {
            background: var(--success-light);
            color: var(--success);
        }

        .kpi-green .kpi-sub {
            color: #15803D;
        }

        .kpi-blue::before {
            background: linear-gradient(180deg, var(--info), #0891B2);
        }

        .kpi-blue .kpi-icon {
            background: var(--info-light);
            color: var(--info);
        }

        .kpi-blue .kpi-sub {
            color: #0E7490;
        }

        .kpi-purple::before {
            background: linear-gradient(180deg, var(--purple), #7C3AED);
        }

        .kpi-purple .kpi-icon {
            background: var(--purple-light);
            color: var(--purple);
        }

        .kpi-purple .kpi-sub {
            color: #6D28D9;
        }

        .kpi-crimson::before {
            background: linear-gradient(180deg, var(--danger), #DC2626);
        }

        .kpi-crimson .kpi-icon {
            background: var(--danger-light);
            color: var(--danger);
        }

        .kpi-crimson .kpi-sub {
            color: #B91C1C;
        }

        /* ══════════════════════════════════════════
           CHARTS ROW
        ══════════════════════════════════════════ */

        .charts-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 16px;
            margin-bottom: 20px;
        }

        .chart-card {
            background: var(--card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 18px 18px 16px;
            box-shadow: var(--shadow-sm);
            opacity: 0;
            transition: box-shadow .2s, transform .2s;
        }

            .chart-card:hover {
                box-shadow: var(--shadow-md);
            }

            .chart-card:nth-child(1) {
                animation: slideL .6s .3s cubic-bezier(.22,.9,.4,1) both;
            }

            .chart-card:nth-child(2) {
                animation: flyUp .6s .45s cubic-bezier(.22,.9,.4,1) both;
            }

            .chart-card:nth-child(3) {
                animation: slideR .6s .6s cubic-bezier(.22,.9,.4,1) both;
            }

        .chart-card-title {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: .7px;
            text-transform: uppercase;
            color: var(--indigo-dark);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .chart-wrap {
            position: relative;
            height: 300px;
        }

        .donut-layout {
            display: flex;
            align-items: center;
            gap: 16px;
            height: 300px;
        }

        .donut-wrap {
            position: relative;
            width: 200px;
            flex-shrink: 0;
        }

            .donut-wrap canvas {
                display: block;
                margin: 0 auto;
            }

        .donut-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
            text-align: center;
            pointer-events: none;
        }

            .donut-center .dc-val {
                font-size: 30px;
                font-weight: 800;
                color: var(--text);
                letter-spacing: -.5px;
                animation: popIn .6s .8s cubic-bezier(.34,1.56,.64,1) both;
