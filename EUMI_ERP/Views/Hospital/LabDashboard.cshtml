            border-radius: var(--radius-lg);
            padding: 0;
            animation-delay: 0.2s;
        }

            .recent-bills-row .tbl-card {
                border: none;
                border-radius: 0;
                box-shadow: none;
                background: transparent;
                margin: 0;
                animation: none;
            }

        .tbl-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 18px;
