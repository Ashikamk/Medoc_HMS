                });
            },
            error: function () {
                best.TrueNotes = '';
                $.ajax({
                    type: 'POST',
                    url: '../Revisit/HMS_LabBillTestGets',
                    data: { BillNo: best.BillNo, BillYear: best.BillYear, Flag: 0, DeptId: deptId },
                    success: function (r2) {
                        LoadUserDropdowns(best.BillNo);
