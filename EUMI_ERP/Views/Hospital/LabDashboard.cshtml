    /* ================================================================
       SIDE NAVBAR — SHOW/HIDE SECTIONS LIKE TABS
    ================================================================ */
    function showSection(target) {
        var kpiRow = document.querySelector('.kpi-row');
        var chartsRow = document.querySelector('.charts-row');
        var recentRow = document.querySelector('.recent-bills-row');
        var pendingRow = document.querySelector('.pending-actions-row');
        var pendingTbl = pendingRow.querySelector('.tbl-card');
        var qaCard = document.querySelector('.qa-card');
        var botRow = document.querySelector('.bot-row');
        var botCards = botRow.querySelectorAll('.tbl-card');

        /* hide everything first */
        kpiRow.style.display = 'none';
        chartsRow.style.display = 'none';
        recentRow.style.display = 'none';
        pendingRow.style.display = 'none';
        botRow.style.display = 'none';
        for (var i = 0; i < botCards.length; i++) botCards[i].style.display = 'none';

        if (target === 'top') {
            /* HOME: counts + graphs + quick actions only */
            kpiRow.style.display = 'grid';
            chartsRow.style.display = 'grid';
            pendingRow.style.display = 'grid';
            pendingRow.style.gridTemplateColumns = '1fr';
            pendingTbl.style.display = 'none';
            qaCard.style.display = 'flex';
            qaCard.classList.add('qa-horizontal');
        }
        else if (target === 'sec-recent-bills') {
            recentRow.style.display = 'block';
        }
        else if (target === 'sec-pending-queue') {
            pendingRow.style.display = 'grid';
            pendingRow.style.gridTemplateColumns = '1fr';
            pendingTbl.style.display = 'block';
            qaCard.style.display = 'none';
            qaCard.classList.remove('qa-horizontal');
        }
        else {
            /* one of the four bottom tables */
            botRow.style.display = 'grid';
            botRow.style.gridTemplateColumns = '1fr';
            var card = document.getElementById(target);
            if (card) card.style.display = 'block';
        }

        window.scrollTo({ top: 0 });
    }

    document.querySelectorAll('.lab-sidenav .nav-item').forEach(function (item) {
        item.addEventListener('click', function (e) {
            e.preventDefault();
            document.querySelectorAll('.lab-sidenav .nav-item').forEach(function (n) {
                n.classList.remove('active');
            });
            this.classList.add('active');
            showSection(this.dataset.target);
        });
    });

    /* start on Home view */
    showSection('top');
</script>
