function ProcessWorksheetData(list) {
    var total = 0, pending = 0, completed = 0;
    var pendingIdx = 0;
    g_pendingQueueHTML = [];

    for (var i = 0; i < list.length; i++) {
        var r         = list[i];
        total++;
        var isPending = (r.Status === 'PENDING');

        if (isPending) {
            pending++;
            pendingIdx++;

            var bloodGroupRaw   = r.BloodGroup || '';
            var bloodGroupParts = bloodGroupRaw.split(' ##');
            var ageWithY        = bloodGroupParts[0] || '';
            var age             = ageWithY.replace(' Y', '').replace(' M', '').trim();
            var actualBloodGroup = bloodGroupParts[1] || '0';
            if (actualBloodGroup === '0') actualBloodGroup = '';

            var actionHTML =
                '<button class="btn-add-result" ' +
                'data-ov="' + escAttr(r.RevisitId)   + '" ' +
                'data-rs="' + escAttr(r.OPSerName)   + '" ' +
                'data-rn="' + escAttr(r.OPNumber)    + '" ' +
                'data-pi="' + escAttr(r.PatientId)   + '" ' +
                'data-age="' + escAttr(age)           + '" ' +
                'data-bg="' + escAttr(actualBloodGroup) + '" ' +
                'data-pn="' + escAttr(r.PatientName) + '" ' +
                'data-ge="' + escAttr(r.Gender)      + '" ' +
                'data-ip="' + escAttr(r.IPNumber)    + '" ' +
                'style="background:#4F46E5;color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;">' +
                '<i class="fa fa-flask"></i> Add Result' +
                '</button>';

            g_pendingQueueHTML.push(buildPendingRowObj(
                pendingIdx,
                (r.OPSerName || '') + '-' + (r.OPNumber || ''),
                r.RevisitId   || '',
                r.PatientName || '',
                r.TestNames   || '—',
                r.RevisitDate || '',
                r.DOB         || '',
                r.Contact     || '',
                r.DoctorName  || '',
                actionHTML
            ));
        } else {
            completed++;
        }
    }

    setKPI('kpi-total',     total);
    setKPI('kpi-pending',   pending);
    setKPI('kpi-completed', completed);
   
    document.getElementById('status-total').textContent  = total;
    chartStatus.data.datasets[0].data = [completed, pending];
    chartStatus.update();
    document.getElementById('status-legend').innerHTML =
        buildLegend(['Result Completed', 'Pending'], [completed, pending], STATUS_COLORS, total);

    g_tablePaging.pendingqueue.data = g_pendingQueueHTML;
    g_tablePaging.pendingqueue.page = 1;
    rerenderTable('pendingqueue');


    g_recentBillsHTML = [];
    var skeletonRows  = '';
    for (var j = 0; j < list.length; j++) {
        var rr     = list[j];
        var isPend = (rr.Status === 'PENDING');
        var sBadge = isPend ? '<span class="badge-pending">PENDING</span>' : '<span class="badge-result">RESULT</span>';
        if (rr.IPNumber != 0) {
            sBadge = rr.DelFlag == 0 ? '<span class="badge-pending">Admitted</span>' : '<span class="badge-result">Discharged</span>';
        }
        skeletonRows +=
            '<tr><td>' + (j + 1) + '</td><td>—</td>' +
            '<td>' + (rr.OPSerName || '') + '-' + (rr.OPNumber || '') + '</td>' +
            '<td>' + (rr.RevisitId || '') + '</td>' +
            '<td>' + (rr.RevisitDate || '') + '</td>' +
            '<td>' + (rr.DOB || '') + '</td>' +
            '<td>' + (rr.PatientName || '') + '</td>' +
            '<td>' + ((rr.BloodGroup || '').split('##')[0].trim()) + '/' + ((rr.Gender || '').substring(0, 1)) + '</td>' +
            '<td>' + (rr.Contact || '') + '</td>' +
            '<td>' + (rr.DoctorName || '') + '</td>' +
            '<td>' + (rr.ShiftName || '—') + '</td>' +
            '<td>—</td><td>' + sBadge + '</td>' +
            '<td><span style="color:#bbb;font-size:11px;">loading…</span></td>' +
            '<td><span style="color:#bbb;font-size:11px;">loading…</span></td>' +
            '</tr>';
    }
    document.getElementById('tbody-recent-bills').innerHTML =
