var g_worksheetRows = [];
var g_verifyMap     = {};
var g_billRows      = [];


function LoadDashboard() {
    var today  = getTodayFormatted();
    var d30    = getDateBefore(7);
    var deptId = typeof ERPDeptId !== 'undefined' ? ERPDeptId : 0;
    var userId = typeof ERPUserId !== 'undefined' ? ERPUserId : 0;

    $.ajax({
        type    : 'POST',
        url     : '../Revisit/HMS_OPLabDashboard',
        data    : { FromDate: today, ToDate: today, DoctorId: 0, PatientId: 0, DeptId: deptId, UserId: userId },
        success : function (result) {
            g_worksheetRows = result || [];
            ProcessWorksheetData(g_worksheetRows);
            FetchBillsForVerification(today);
        },
        error   : function () { ProcessWorksheetData([]); }
    });

    $.ajax({
        type    : 'POST',
        url     : '../Revisit/HMS_OPLabDashboard',
        data    : { FromDate: d30, ToDate: today, DoctorId: 0, PatientId: 0, DeptId: deptId, UserId: userId },
        success : function (result) { BuildDailyChart(result || []); },
        error   : function ()       { BuildDailyChart(g_worksheetRows); }
    });
}

function FetchBillsForVerification(today) {
    var data = {
        OPNumber  : '',
        PatientId : 0,
        DeptId    : typeof ERPDeptId !== 'undefined' ? ERPDeptId : 0,
        Flag      : 1
    };
    $.ajax({
        type    : 'POST',
        url     : '../Revisit/HMS_LabBillGets',
        data    : data,
        success : function (res) {
            var allRows = [];
            if      (res && res.oList  && res.oList.length  > 0) allRows = res.oList;
            else if (res && res.data   && res.data.length   > 0) allRows = res.data;
            else if (res && res.Data   && res.Data.length   > 0) allRows = res.Data;
            else if (res && res.list   && res.list.length   > 0) allRows = res.list;
            else if (res && res.List   && res.List.length   > 0) allRows = res.List;
            else if (res && res.result && res.result.length > 0) allRows = res.result;
            else if (Array.isArray(res) && res.length > 0)       allRows = res;

            g_billRows = allRows;

            var todayBills = [];
            for (var i = 0; i < g_billRows.length; i++) {
                if (isDateToday(g_billRows[i].Date || g_billRows[i].BillDate || g_billRows[i].RevisitDate || "")) {
                    todayBills.push(g_billRows[i]);
                }
            }
            if (todayBills.length === 0) todayBills = g_billRows;
            FetchVerificationForBills(todayBills, 0);
        },
        error : function () {
            var fakeBills = [];
            for (var i = 0; i < g_worksheetRows.length; i++) {
                var tn = parseInt(g_worksheetRows[i].TokenNumber || 0);
                if (tn > 0) {
                    fakeBills.push({
                        BillNo      : tn,
                        BillYear    : 0,
                        OPNumber    : g_worksheetRows[i].RevisitId,
                        PatientId   : g_worksheetRows[i].PatientId,
                        PatientName : g_worksheetRows[i].PatientName,
                        OPSerName   : g_worksheetRows[i].OPSerName,
                        Date        : g_worksheetRows[i].RevisitDate,
                        DoctorName  : g_worksheetRows[i].DoctorName
                    });
                }
            }
            FetchVerificationForBills(fakeBills, 0);
        }
    });
}


function BuildDailyChart(bills) {
    var days   = [];
    var counts = {};
    var now    = new Date();
    for (var d = 6; d >= 0; d--) {
        var dt  = new Date(now);
        dt.setDate(now.getDate() - d);
        var key = pad2(dt.getDate()) + '/' + pad2(dt.getMonth() + 1) + '/' + dt.getFullYear();
        var lbl = pad2(dt.getDate()) + '/' + pad2(dt.getMonth() + 1);
        days.push({ key: key, label: lbl });
        counts[key] = 0;
    }

    for (var i = 0; i < bills.length; i++) {
        var b   = bills[i];
        var raw = String(b.RevisitDate || b.Date || b.BillDate || b.CreatedDate || b.EntryDate || b.TransDate || b.LabDate || b.OrderDate || b.DateOfBill || b.Dated || b.TDate || '').trim();
        if (raw.indexOf(' ') !== -1) raw = raw.split(' ')[0];
        var key2 = normaliseDateKey(raw);
        if (key2 && counts.hasOwnProperty(key2)) counts[key2]++;
    }

    var labels = [], data = [], total = 0;
    for (var j = 0; j < days.length; j++) {
        labels.push(days[j].label);
        var c = counts[days[j].key] || 0;
        data.push(c);
        total += c;
    }

    chartDaily.data.labels           = labels;
    chartDaily.data.datasets[0].data = data;
    chartDaily.update();

    var badge = document.getElementById('daily-range-badge');
    if (badge) badge.textContent = total + ' Bill' + (total !== 1 ? 's' : '') + ' (7 days)';
}

function pad2(n) { return n < 10 ? '0' + n : '' + n; }

function normaliseDateKey(raw) {
    if (!raw) return null;
    var s = raw.split(' ')[0];
    var parts;
    if (s.indexOf('/') !== -1) {
        parts = s.split('/');
        if (parts.length === 3) {
            if (parts[0].length === 4) return pad2(parseInt(parts[2])) + '/' + pad2(parseInt(parts[1])) + '/' + parts[0];
            return pad2(parseInt(parts[0])) + '/' + pad2(parseInt(parts[1])) + '/' + parts[2];
        }
    } else if (s.indexOf('-') !== -1) {
        parts = s.split('-');
        if (parts.length === 3) {
            if (parts[0].length === 4) return pad2(parseInt(parts[2])) + '/' + pad2(parseInt(parts[1])) + '/' + parts[0];
            return pad2(parseInt(parts[0])) + '/' + pad2(parseInt(parts[1])) + '/' + parts[2];
        }
    }
    return null;
}


function FetchVerificationForBills(bills, idx) {
    if (idx === 0) {
        var today = getTodayFormatted();
        $.ajax({
            type    : 'GET',
            url     : '@Url.Action("GetVerificationLists", "Revisit")',
            data    : { fromDate: today, toDate: today },
            success : function (response) {
                if (response.success) {
                    ProcessVerificationData(response, bills);
                } else {
                    RebuildWithVerification(bills, {}, {}, {});
                }
            },
            error : function () { RebuildWithVerification(bills, {}, {}, {}); }
        });
    }
}

function ProcessVerificationData(response, bills) {
    var verifiedSet = {};
    var approvedSet = {};
    var i;

    var spVerified = response.verifiedList || [];
    var spApproved = response.approvedList || [];

    for (i = 0; i < spVerified.length; i++) {
        var vKey = parseInt(spVerified[i].BillNo || 0);
        if (vKey > 0) verifiedSet[vKey] = true;
    }
    for (i = 0; i < spApproved.length; i++) {
        var aKey = parseInt(spApproved[i].BillNo || 0);
        if (aKey > 0) approvedSet[aKey] = true;
    }

    g_verifyMap = {};
    for (i = 0; i < g_worksheetRows.length; i++) {
        var r        = g_worksheetRows[i];
        var tokenNum = parseInt(r.TokenNumber || 0);
        if (tokenNum > 0) {
            g_verifyMap[tokenNum] = {
                billNo       : tokenNum,
                verifiedUser : verifiedSet[tokenNum] ? 1 : 0,
                approvedUser : approvedSet[tokenNum] ? 1 : 0
            };
        }
    }
    RebuildWithVerification(bills, verifiedSet, approvedSet, response);
}

function spToEntry(item) {
    return {
        billNo      : item.BillNo      || '—',
        regNo       : item.RegNo       || '',
        patientName : item.PatientName || '',
        doctorName  : item.DoctorName  || '',
        date        : item.RevisitDate || item.Date || item.BillDate || ''
    };
}

function RebuildWithVerification(bills, verifiedSet, approvedSet, response) {
    verifiedSet = verifiedSet || {};
    approvedSet = approvedSet || {};
    response    = response    || {};

    var verifiedList    = [];
    var nonVerifiedList = [];
    var approvedList    = [];
    var nonApprovedList = [];
    var i;

    g_verifyMap = {};
    for (i = 0; i < g_worksheetRows.length; i++) {
        var r        = g_worksheetRows[i];
        var tokenNum = parseInt(r.TokenNumber || 0);
        if (tokenNum > 0) {
            g_verifyMap[tokenNum] = {
                billNo       : tokenNum,
                verifiedUser : verifiedSet[tokenNum] ? 1 : 0,
                approvedUser : approvedSet[tokenNum] ? 1 : 0
            };
        }
    }

    for (i = 0; i < g_worksheetRows.length; i++) {
        var rw     = g_worksheetRows[i];
        var tn     = parseInt(rw.TokenNumber || 0);
        var billNo = 0;
        var isVer  = false;
        var isApp  = false;

        if (tn > 0 && g_verifyMap[tn]) {
            billNo = g_verifyMap[tn].billNo || 0;
            isVer  = g_verifyMap[tn].verifiedUser > 0;
            isApp  = g_verifyMap[tn].approvedUser > 0;
        }

        if (rw.IPNumber == 0 && rw.Status !== 'PENDING') {
            var entry = {
                billNo      : billNo || rw.TokenNumber || '—',
                regNo       : (rw.OPSerName || '') + '-' + (rw.OPNumber || ''),
                patientName : rw.PatientName || '',
                doctorName  : rw.DoctorName  || '',
                date        : rw.RevisitDate || ''
            };
            if (isVer) verifiedList.push(entry); else nonVerifiedList.push(entry);
            if (isApp) approvedList.push(entry); else nonApprovedList.push(entry);
        }
    }

    var spVerifiedList  = response.verifiedList    || [];
    var spNonVerified   = response.nonVerifiedList  || [];
    var spApprovedList  = response.approvedList     || [];
    var spNonApproved   = response.nonApprovedList  || [];

    function dedupeByBillNo(list) {
        var seen = {};
        var result = [];
        for (var i = list.length - 1; i >= 0; i--) {
            var key = String(list[i].billNo || '');
            if (!seen[key]) { seen[key] = true; result.unshift(list[i]); }
        }
        return result;
    }

    if (spVerifiedList.length > 0) { verifiedList = []; for (var a = 0; a < spVerifiedList.length; a++) verifiedList.push(spToEntry(spVerifiedList[a])); verifiedList = dedupeByBillNo(verifiedList); }
    if (spNonVerified.length > 0) { nonVerifiedList = []; for (var b = 0; b < spNonVerified.length; b++) nonVerifiedList.push(spToEntry(spNonVerified[b])); nonVerifiedList = dedupeByBillNo(nonVerifiedList); }
    if (spApprovedList.length > 0) { approvedList = []; for (var c = 0; c < spApprovedList.length; c++) approvedList.push(spToEntry(spApprovedList[c])); approvedList = dedupeByBillNo(approvedList); }
    if (spNonApproved.length > 0) { nonApprovedList = []; for (var d = 0; d < spNonApproved.length; d++) nonApprovedList.push(spToEntry(spNonApproved[d])); nonApprovedList = dedupeByBillNo(nonApprovedList); }

    function hasResultForBill(billNo) {
        var bn = String(billNo || '');
        for (var i = 0; i < g_worksheetRows.length; i++) {
            if (String(g_worksheetRows[i].TokenNumber) === bn) {
                return g_worksheetRows[i].Status !== 'PENDING';
            }
        }
        return true;
    }

    function keepOnlyResulted(list) {
        return list.filter(function (entry) {
            return hasResultForBill(entry.billNo);
        });
    }

    verifiedList = keepOnlyResulted(verifiedList);
    nonVerifiedList = keepOnlyResulted(nonVerifiedList);
    approvedList = keepOnlyResulted(approvedList);
    nonApprovedList = keepOnlyResulted(nonApprovedList);

    setKPI('kpi-verified',    verifiedList.length);
    setKPI('kpi-nonverified', nonVerifiedList.length);
    setKPI('kpi-approved',    approvedList.length);
    setKPI('kpi-nonapproved', nonApprovedList.length);

    chartVerification.data.datasets[0].data = [
        verifiedList.length, nonVerifiedList.length,
        approvedList.length, nonApprovedList.length
    ];
    chartVerification.update();

    g_recentBillsHTML = [];
    for (var k = 0; k < g_worksheetRows.length; k++) {
        var row   = g_worksheetRows[k];
        var tn2   = parseInt(row.TokenNumber || 0);
        var billNo2 = 0;
        var isVer2  = false;
        var isApp2  = false;

        if (tn2 > 0 && g_verifyMap[tn2]) {
            billNo2 = g_verifyMap[tn2].billNo || 0;
            isVer2  = g_verifyMap[tn2].verifiedUser > 0;
            isApp2  = g_verifyMap[tn2].approvedUser > 0;
        }

        var isPend2  = (row.Status === 'PENDING');
        var sBadge2  = isPend2 ? '<span class="badge-pending">PENDING</span>' : '<span class="badge-result">RESULT</span>';
        if (row.IPNumber != 0) {
            sBadge2 = row.DelFlag == 0 ? '<span class="badge-pending">Admitted</span>' : '<span class="badge-result">Discharged</span>';
        }

        var verBadge2 = isVer2 ? '<span class="badge-verified">Verified</span>'   : '<span class="badge-unverified">Not Verified</span>';
        var appBadge2 = isApp2 ? '<span class="badge-approved">Approved</span>'   : '<span class="badge-unapproved">Not Approved</span>';

        g_recentBillsHTML.push(buildRecentBillRowObj(
            k + 1,
            billNo2 || row.TokenNumber || '—',
            (row.OPSerName || '') + '-' + (row.OPNumber || ''),
            row.RevisitId  || '',
            row.RevisitDate || '',
            row.DOB         || '',
            row.PatientName || '',
            ((row.BloodGroup || '').split('##')[0].trim()) + '/' + ((row.Gender || '').substring(0, 1)),
            row.Contact     || '',
            row.DoctorName  || '',
            row.ShiftName   || '—',
            billNo2 || '—',
            sBadge2,
            verBadge2,
            appBadge2
        ));
    }
    renderRecentBillsTable(g_recentBillsHTML);

    document.getElementById('tbody-verified').innerHTML    = buildPatientRows(verifiedList, 6);
    document.getElementById('tbody-nonverified').innerHTML = buildNonVerifiedRows(nonVerifiedList);
    document.getElementById('tbody-approved').innerHTML    = buildPatientRows(approvedList, 6);
    document.getElementById('tbody-nonapproved').innerHTML = buildNonApprovedRows(nonApprovedList);
    storeBotData(verifiedList, nonVerifiedList, approvedList, nonApprovedList);
}


function ProcessWorksheetData(list) {
    var total = 0, pending = 0, completed = 0;
    var pendingIdx = 0;
    g_pendingQueueHTML = [];

    for (var i = 0; i < list.length; i++) {
        var r         = list[i];
        total++;
        var isPending = (r.Status === 'PENDING');

        if (isPending) {
            pending++;
            pendingIdx++;

            var bloodGroupRaw   = r.BloodGroup || '';
            var bloodGroupParts = bloodGroupRaw.split(' ##');
            var ageWithY        = bloodGroupParts[0] || '';
            var age             = ageWithY.replace(' Y', '').replace(' M', '').trim();
            var actualBloodGroup = bloodGroupParts[1] || '0';
            if (actualBloodGroup === '0') actualBloodGroup = '';

            var actionHTML =
                '<button class="btn-add-result" ' +
                'data-ov="' + escAttr(r.RevisitId)   + '" ' +
                'data-rs="' + escAttr(r.OPSerName)   + '" ' +
                'data-rn="' + escAttr(r.OPNumber)    + '" ' +
                'data-pi="' + escAttr(r.PatientId)   + '" ' +
