var g_worksheetRows = [];
var g_verifyMap     = {};
    var g_billRows = [];

    var g_tablePaging = {
        recentbills: { page: 1, size: 10, data: [] },
        pendingqueue: { page: 1, size: 10, data: [] },
        verified: { page: 1, size: 10, data: [] },
        nonverified: { page: 1, size: 10, data: [] },
        approved: { page: 1, size: 10, data: [] },
        nonapproved: { page: 1, size: 10, data: [] }
    };

    function paginateList(list, page, size) {
        var start = (page - 1) * size;
        return list.slice(start, start + size);
    }

    function rerenderTable(key) {
        var st = g_tablePaging[key];
        var pageList = paginateList(st.data, st.page, st.size);

        switch (key) {
            case 'recentbills': renderRecentBillsTable(pageList); break;
            case 'pendingqueue': renderPendingQueueTable(pageList); break;
            case 'verified': document.getElementById('tbody-verified').innerHTML = buildPatientRows(pageList, 6); break;
            case 'nonverified': document.getElementById('tbody-nonverified').innerHTML = buildNonVerifiedRows(pageList); break;
            case 'approved': document.getElementById('tbody-approved').innerHTML = buildPatientRows(pageList, 6); break;
            case 'nonapproved': document.getElementById('tbody-nonapproved').innerHTML = buildNonApprovedRows(pageList); break;
        }
        renderPaginationFooter(key, st.data.length);
    }

    function renderPaginationFooter(key, total) {
        var st = g_tablePaging[key];
        var infoEl = document.getElementById('info-' + key);
        var pagEl = document.getElementById('pagination-' + key);
        if (!infoEl || !pagEl) return;

        if (total === 0) {
            infoEl.textContent = 'Showing 0 to 0 of 0 entries';
            pagEl.innerHTML = '';
            return;
        }

        var totalPages = Math.max(1, Math.ceil(total / st.size));
        if (st.page > totalPages) st.page = totalPages;

        var start = (st.page - 1) * st.size + 1;
        var end = Math.min(st.page * st.size, total);
        infoEl.textContent = 'Showing ' + start + ' to ' + end + ' of ' + total + ' entries';

        var html = '<button class="dt-page-btn" ' + (st.page === 1 ? 'disabled' : '') +
            ' onclick="changeTablePage(\'' + key + '\',' + (st.page - 1) + ')">Previous</button>';

        var maxBtns = 5;
        var startPage = Math.max(1, st.page - Math.floor(maxBtns / 2));
        var endPage = Math.min(totalPages, startPage + maxBtns - 1);
        startPage = Math.max(1, endPage - maxBtns + 1);

        for (var p = startPage; p <= endPage; p++) {
            html += '<button class="dt-page-btn ' + (p === st.page ? 'active' : '') +
                '" onclick="changeTablePage(\'' + key + '\',' + p + ')">' + p + '</button>';
        }

        html += '<button class="dt-page-btn" ' + (st.page === totalPages ? 'disabled' : '') +
            ' onclick="changeTablePage(\'' + key + '\',' + (st.page + 1) + ')">Next</button>';

        pagEl.innerHTML = html;
    }

    function changeTablePage(key, page) {
        g_tablePaging[key].page = page;
        rerenderTable(key);
    }

    function changePageSize(key, size) {
        g_tablePaging[key].size = parseInt(size, 10) || 10;
        g_tablePaging[key].page = 1;
        rerenderTable(key);
    }


