        /* ══════════════════════════════════════════
           TABLE CARDS — LIGHT PREMIUM THEME
        ══════════════════════════════════════════ */

        .tbl-card,
        .recent-bills-row,
        .qa-card {
            background: var(--card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            margin: 0 0 8px 0;
            animation: fadeInUp 0.5s ease both;
            transition: box-shadow .2s;
        }

