function getTodayFormatted() {
    var now = new Date();
    var d   = (now.getDate()        < 10 ? '0' : '') + now.getDate();
    var m   = ((now.getMonth() + 1) < 10 ? '0' : '') + (now.getMonth() + 1);
    return d + '/' + m + '/' + now.getFullYear();
}

function getDateBefore(days) {
    var d = new Date();
    d.setDate(d.getDate() - days);
    var dd = (d.getDate()        < 10 ? '0' : '') + d.getDate();
    var mm = ((d.getMonth() + 1) < 10 ? '0' : '') + (d.getMonth() + 1);
    return dd + '/' + mm + '/' + d.getFullYear();
}

function isDateToday(dateStr) {
    if (!dateStr) return false;
    var today = new Date();
    var s = String(dateStr);
    var d = String(today.getDate()).padStart(2, '0');
    var m = String(today.getMonth() + 1).padStart(2, '0');
    var y = String(today.getFullYear());
    return s.indexOf(d + '/' + m + '/' + y) !== -1 ||
           s.indexOf(y + '-' + m + '-' + d) !== -1 ||
           s.indexOf(d + '-' + m + '-' + y) !== -1;
}

function buildLegend(labels, vals, colors, total) {
    var h = '';
    for (var i = 0; i < labels.length; i++) {
        var pct = total > 0 ? Math.round((vals[i] / total) * 100) : 0;
        h += '<div class="legend-item">' +
             '<div class="legend-dot" style="background:' + (colors[i] || '#ccc') + '"></div>' +
             '<span class="legend-name">' + labels[i] + '</span>' +
             '<span class="legend-val">'  + vals[i]   + '</span>&nbsp;' +
             '<span class="legend-pct">(' + pct + '%)</span>' +
             '</div>';
    }
    return h;
}

function escAttr(val) {
    return String(val || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
}


