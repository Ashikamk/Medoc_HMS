    function buildQueue(data) {
        var total = data.length, done = 0, pending = 0, newPt = 0, revisit = 0;
        var today = new Date(), yyyy = today.getFullYear();
        var qRows = [], pendRows = [], compRows = [];
        var pendCnt = 0, compCnt = 0;

        for (var i = 0; i < data.length; i++) {
            var r = data[i];
            var badge = '';
            if (r.IPNumber && r.IPNumber != 0) {
                badge = r.DelFlag == 0
                    ? '<span class="badge-admit">Admitted</span>'
                    : '<span class="badge-discharge">Discharged</span>';
            } else if (r.Status == 'New') {
                badge = '<span class="badge-new">New-Reg</span>'; newPt++;
            } else {
                badge = '<span class="badge-revisit">Re-Visit</span>'; revisit++;
            }

            var age = '—';
            try { age = yyyy - parseInt((r.DOB || '').substring(6, 15) || 0); } catch (e) { }

            var isDone = r.CSFlag && r.CSFlag != 0;
            if (isDone) done++; else pending++;

            var labdot = labReadyMap[r.RevisitId] ? '<span class="lab-dot" title="Lab Result Ready"></span>' : '';
            var rowCls = isDone ? ' class="done-row"' : '';

            qRows.push('<tr' + rowCls + ' ondblclick="goCS(' + r.PatientId + ',' + r.RevisitId + ')">'
                + '<td data-label="SL#">' + (i + 1) + '</td>'
                + '<td data-label="Reg#">' + (r.OPNumber || '') + '</td>'
                + '<td data-label="Visit#">' + (r.RevisitId || '') + '</td>'
                + '<td data-label="Date">' + (r.RevisitDate || '') + '</td>'
                + '<td data-label="Patient" style="font-weight:600">' + (r.PatientName || '') + '</td>'
                + '<td data-label="Gender">' + labdot + (r.Gender || '') + '</td>'
                + '<td data-label="Contact">' + (r.Contact || '') + '</td>'
                + '<td data-label="Shift">' + ((r.ShiftName || '').substring(0, 4)) + '</td>'
                + '<td data-label="Token"><span class="token-num">' + (r.TokenNumber || '') + '</span></td>'
                + '<td data-label="Status">' + badge + '</td>'
                + '<td data-label="Action">'
                + (isDone
                    ? '<span class="badge-result">Done</span>'
                    : '<span class="badge-pending">Pending</span>')
                + '</td>'
                + '</tr>');

            if (!isDone) {
                pendCnt++;
                pendRows.push('<tr ondblclick="goCS(' + r.PatientId + ',' + r.RevisitId + ')">'
                    + '<td data-label="Sl No">' + pendCnt + '</td>'
                    + '<td data-label="Reg No">' + (r.PatientId || '') + '</td>'
                    + '<td data-label="OP No">' + (r.OPNumber || '') + '</td>'
                    + '<td data-label="Date">' + (r.RevisitDate || '') + '</td>'
                    + '<td data-label="Patient" style="font-weight:600">' + (r.PatientName || '') + '</td>'
                    + '<td data-label="Age/Sex">' + age + ' / ' + (r.Gender || '') + '</td>'
                    + '<td data-label="Contact">' + (r.Contact || '') + '</td>'
                    + '<td data-label="Doctor">' + (r.DoctorName || '') + '</td>'
                    + '<td data-label="Status"><span class="badge-pending">Pending</span></td>'
                    + '</tr>');
            }

            if (isDone) {
                compCnt++;
                compRows.push('<tr ondblclick="goCS(' + r.PatientId + ',' + r.RevisitId + ')">'
                    + '<td data-label="Sl No">' + compCnt + '</td>'
                    + '<td data-label="Reg No">' + (r.PatientId || '') + '</td>'
                    + '<td data-label="OP No">' + (r.OPNumber || '') + '</td>'
                    + '<td data-label="Date">' + (r.RevisitDate || '') + '</td>'
                    + '<td data-label="Patient" style="font-weight:600">' + (r.PatientName || '') + '</td>'
                    + '<td data-label="Age/Sex">' + age + ' / ' + (r.Gender || '') + '</td>'
                    + '<td data-label="Contact">' + (r.Contact || '') + '</td>'
                    + '<td data-label="Doctor">' + (r.DoctorName || '') + '</td>'
                    + '<td data-label="Status"><span class="badge-result">Completed</span></td>'
                    + '</tr>');
            }
        }

        setPaginatorRows('queue-tbody', qRows, 'No patients.');
        setPaginatorRows('tb-pendcs', pendRows, 'No pending cases.');
        setPaginatorRows('tb-compcs', compRows, 'No completed cases.');

        $('#qp-total').text('cases: ' + total);
        $('#qp-done').text('Done: ' + done);
        $('#qp-pending').text('Pending: ' + pending);
        $('#sc-total').text(total);
        $('#sc-pending').text(pending);
        $('#sc-done').text(done);
        $('#sc-new').text(newPt);
        $('#sc-revisit').text(revisit);
        drawCaseChart(done, pending, total);
        drawFlowChart(newPt, revisit);

        $('#dd-loader').hide();
    }

