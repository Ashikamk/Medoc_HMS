<script>
    $(document).ready(function () {
        document.title = "Doctor Dashboard";
        document.getElementById('footerYear').textContent = new Date().getFullYear();
        showSection('top');
    });

    
    function isMobileNav() {
        return window.matchMedia('(max-width: 768px)').matches;
    }

    function toggleSidenav() {
        var nav = document.getElementById('docSidenav');
        var backdrop = document.getElementById('sidenavBackdrop');
        var isOpen = nav.classList.toggle('open');
        backdrop.classList.toggle('show', isOpen);
    }

    function closeSidenav() {
        document.getElementById('docSidenav').classList.remove('open');
        document.getElementById('sidenavBackdrop').classList.remove('show');
    }

  
    window.addEventListener('resize', function () {
        if (!isMobileNav()) closeSidenav();
    });

    
    function showSection(target) {
        var sections = {
            kpi: document.querySelector('.kpi-row'),
            charts: document.querySelector('.charts-row'),
            queue: document.querySelector('.queue-actions-row'),
            qaCard: document.querySelector('.qa-card'),
            twoColRows: document.querySelectorAll('.two-col-row'),
            allTables: document.querySelectorAll('.tbl-card')
        };

        sections.allTables.forEach(function(tbl) {
            tbl.style.display = 'none';
        });
        sections.twoColRows.forEach(function(row) {
            row.style.display = 'none';
        });
        sections.queue.style.display = 'none';

        if (target === 'top') {
            sections.kpi.style.display = 'grid';
            sections.charts.style.display = 'grid';
            sections.qaCard.style.display = 'block';
        } else {
            sections.kpi.style.display = 'none';
            sections.charts.style.display = 'none';
            sections.qaCard.style.display = 'none';

            var targetEl = document.getElementById(target);
            if (!targetEl) return;

            if (target === 'sec-patient-queue') {
                sections.queue.style.display = 'grid';
                sections.queue.style.gridTemplateColumns = '1fr';
                var queueTbl = sections.queue.querySelector('.tbl-card');
                if (queueTbl) queueTbl.style.display = 'block';
            } else {
                var parentRow = targetEl.closest('.two-col-row');
                if (parentRow) {
                    parentRow.style.display = 'grid';
                    parentRow.style.gridTemplateColumns = '1fr';
                    targetEl.style.display = 'block';
                } else {
                    targetEl.style.display = 'block';
                }
            }
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    document.querySelectorAll('.doc-sidenav .nav-item').forEach(function(item) {
        item.addEventListener('click', function(e) {
            e.preventDefault();
            document.querySelectorAll('.doc-sidenav .nav-item').forEach(function(n) {
                n.classList.remove('active');
            });
            this.classList.add('active');
            showSection(this.dataset.target);
            if (isMobileNav()) closeSidenav();
        });
    });

    
    var paginators = {};

    
    function pgKey(tbodyId) {
        return tbodyId.replace('-tbody', '').replace('tb-', '');
    }

    function initPaginator(tbodyId, colspan) {
        paginators[tbodyId] = {
            allRows: [],
            rows: [],
            pageSize: 10,
            currentPage: 1,
            colspan: colspan,
            emptyMsg: 'No data.'
        };
    }

    
    function setPaginatorRows(tbodyId, rowsArray, emptyMsg) {
        var p = paginators[tbodyId];
        if (!p) return;
        p.allRows = rowsArray || [];
        p.rows = p.allRows.slice();
        if (emptyMsg) p.emptyMsg = emptyMsg;
        p.currentPage = 1;
        renderPage(tbodyId);
    }

    function renderPage(tbodyId) {
        var p = paginators[tbodyId];
        if (!p) return;

        var total = p.rows.length;
        var totalPages = Math.max(1, Math.ceil(total / p.pageSize));
        if (p.currentPage > totalPages) p.currentPage = totalPages;
        if (p.currentPage < 1) p.currentPage = 1;

        var start = (p.currentPage - 1) * p.pageSize;
        var end = Math.min(start + p.pageSize, total);
        var pageRows = p.rows.slice(start, end);

        var tbodyEl = document.getElementById(tbodyId);
        if (tbodyEl) {
            tbodyEl.innerHTML = pageRows.length
                ? pageRows.join('')
                : '<tr><td colspan="' + p.colspan + '" class="empty-msg">' + p.emptyMsg + '</td></tr>';
        }

        var key = pgKey(tbodyId);
        var infoEl = document.getElementById('info-' + key);
        var pagesEl = document.getElementById('pages-' + key);
        var prevEl = document.getElementById('prev-' + key);
        var nextEl = document.getElementById('next-' + key);

        if (infoEl) {
            infoEl.textContent = total
                ? ('Showing ' + (start + 1) + ' to ' + end + ' of ' + total + ' entries')
                : 'Showing 0 entries';
        }
        if (pagesEl) renderPageNumbers(pagesEl, tbodyId, p.currentPage, totalPages);
        if (prevEl) prevEl.disabled = p.currentPage <= 1;
        if (nextEl) nextEl.disabled = p.currentPage >= totalPages;
    }

    
    function renderPageNumbers(container, tbodyId, current, totalPages) {
        var pagesToShow = [];
        var maxButtons = window.matchMedia('(max-width: 480px)').matches ? 3 : 7;

        if (totalPages <= maxButtons) {
            for (var i = 1; i <= totalPages; i++) pagesToShow.push(i);
        } else {
            pagesToShow.push(1);
            var start = Math.max(2, current - 1);
            var end = Math.min(totalPages - 1, current + 1);

            if (start > 2) pagesToShow.push('...');
            for (var j = start; j <= end; j++) pagesToShow.push(j);
            if (end < totalPages - 1) pagesToShow.push('...');

            pagesToShow.push(totalPages);
        }

        var html = '';
        for (var k = 0; k < pagesToShow.length; k++) {
            var item = pagesToShow[k];
            if (item === '...') {
                html += '<span class="pg-num-ellipsis">…</span>';
            } else {
                var activeCls = (item === current) ? ' pg-num-active' : '';
                html += '<button type="button" class="pg-num' + activeCls + '" onclick="goToPage(\'' + tbodyId + '\',' + item + ')">' + item + '</button>';
            }
        }
        container.innerHTML = html;
    }

    function goToPage(tbodyId, pageNum) {
        var p = paginators[tbodyId];
        if (!p) return;
        p.currentPage = pageNum;
        renderPage(tbodyId);
    }

    function changePageSize(tbodyId, selectEl) {
        var p = paginators[tbodyId];
        if (!p) return;
        p.pageSize = parseInt(selectEl.value) || 10;
        p.currentPage = 1;
        renderPage(tbodyId);
    }

    function goToPrevPage(tbodyId) {
        var p = paginators[tbodyId];
        if (p && p.currentPage > 1) { p.currentPage--; renderPage(tbodyId); }
    }

    function goToNextPage(tbodyId) {
        var p = paginators[tbodyId];
        if (!p) return;
        var totalPages = Math.max(1, Math.ceil(p.rows.length / p.pageSize));
        if (p.currentPage < totalPages) { p.currentPage++; renderPage(tbodyId); }
    }

    initPaginator('queue-tbody', 11);
    initPaginator('tb-pendcs', 9);
    initPaginator('tb-compcs', 9);
    initPaginator('tb-med', 9);
    initPaginator('tb-lab', 9);
    initPaginator('tb-lready', 12);
    initPaginator('tb-lpending', 11);

    
    var FromDate = '';      
    var ToDate = '';        
    var labReadyMap = {};
    var pollTimerAdvice = null;
    var pollTimerQueue = null;

    function fmtDMY(d) {
        var dd = String(d.getDate()).padStart(2, '0');
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        return dd + '/' + mm + '/' + d.getFullYear();
    }

    function dmyToDate(dmy) {
        if (!dmy) return null;
        var p = dmy.split('/');
        if (p.length !== 3) return null;
        return new Date(p[2], p[1] - 1, p[0]);
    }

    function warningshow(message) {
        $('#topAlert').text(message);
        $('#topAlert').stop(true, true).fadeIn();
        clearTimeout(window._docWarningTimer);
        window._docWarningTimer = setTimeout(function () {
            $('#topAlert').fadeOut();
        }, 3000);
    }

    (function initDates() {
        var today = new Date();
        var todayStr = fmtDMY(today);
        FromDate = todayStr;
        ToDate = todayStr;

        document.getElementById('FromDateInput').value = todayStr;
        document.getElementById('ToDateInput').value = todayStr;
        setActiveQuickLabel('today');
    })();

   
    function toggleQuickFilter() {
        document.getElementById('quickFilterMenu').classList.toggle('show');
    }
    document.addEventListener('click', function (e) {
        if (!e.target.closest('.filter-dropdown-wrap')) {
            document.getElementById('quickFilterMenu').classList.remove('show');
        }
    });

    function setActiveQuickLabel(range) {
        document.querySelectorAll('.quick-filter-menu a').forEach(function (a) {
            a.classList.toggle('active-range', a.dataset.range === range);
        });
    }

    
    function applyQuickRange(range) {
        var today = new Date();
        var from = new Date(today), to = new Date(today);

        if (range === 'yesterday') {
            from.setDate(from.getDate() - 1);
            to.setDate(to.getDate() - 1);
        } else if (range === 'week') {
            from.setDate(today.getDate() - today.getDay());
        } else if (range === 'month') {
            from = new Date(today.getFullYear(), today.getMonth(), 1);
        } else if (range === 'lastmonth') {
            from = new Date(today.getFullYear(), today.getMonth() - 1, 1);
            to = new Date(today.getFullYear(), today.getMonth(), 0);
        }
       

        var fromStr = fmtDMY(from);
        var toStr = fmtDMY(to);

        var $from = $('#FromDateInput');
        var $to = $('#ToDateInput');

        $from.val(fromStr);
        $to.val(toStr);

        if ($from.data('daterangepicker')) {
            $from.data('daterangepicker').setStartDate(fromStr);
            $from.data('daterangepicker').setEndDate(fromStr);
        }
        if ($to.data('daterangepicker')) {
            $to.data('daterangepicker').setStartDate(toStr);
            $to.data('daterangepicker').setEndDate(toStr);
        }

        document.getElementById('quickFilterMenu').classList.remove('show');
        setActiveQuickLabel(range);

        FromDate = fromStr;
        ToDate = toStr;
        
    }

    function applyDateFilter() {
        var fromVal = document.getElementById('FromDateInput').value;
        var toVal = document.getElementById('ToDateInput').value;
        if (!fromVal || !toVal) { warningshow('Please select both From and To dates.'); return; }

        var fromD = dmyToDate(fromVal), toD = dmyToDate(toVal);
        if (fromD && toD && fromD > toD) {
            warningshow('From date cannot be later than To date.');
            return;
        }

        FromDate = fromVal;
        ToDate = toVal;
        setActiveQuickLabel('custom');

        runFilteredRefresh();
    }

    function runFilteredRefresh() {
        refreshAll();
        managePolling();
    }

   
    function managePolling() {
