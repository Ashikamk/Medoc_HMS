    function escAttr(val) {
        return String(val || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');
    }
    function viewLabReport(billNo, opNumber) {
        if (!billNo) { alert('No bill number found for this report.'); return; }

        var reqData = {
            OPNumber: opNumber,
            PatientId: 0,
            DeptId: (typeof ERPDeptId !== 'undefined' ? ERPDeptId : 0),
            Flag: 1
        };

        $.ajax({
            type: 'POST',
            url: '../Revisit/HMS_LabBillGets',
            data: reqData,
            success: function (res) {
                var rows = [];
                if (res && res.oList && res.oList.length > 0) rows = res.oList;
                else if (Array.isArray(res) && res.length > 0) rows = res;

                var matchedBill = null;
                for (var i = 0; i < rows.length; i++) {
                    if (String(rows[i].BillNo) === String(billNo)) { matchedBill = rows[i]; break; }
                }

                if (matchedBill) {
                    window.open('../Revisit/LabResult?flag=bill&billno=' + matchedBill.BillNo + '&billyear=' + matchedBill.BillYear, '_blank');
                } else {
                    window.open('../Revisit/LabResult?flag=bill&billno=' + billNo, '_blank');
                }
            },
            error: function () {
                window.open('../Revisit/LabResult?flag=bill&billno=' + billNo, '_blank');
            }
        });
    }

    function goToLabResult(index) {
        var p = window.labPendingGrouped[index];

        var revisitId = p.RevisitId || '';
        var opSerName = p.OPSerName || '';
        var opNumber = p.OPNumber || '';
        var patientId = p.PatientId || 0;
        var patientName = p.PatientName || '';
        var ipNumber = p.IPNumber || '0';

        function doRedirect(dob, bloodGroup, gender, contact, email) {
            sessionStorage.setItem('SOP_OV', revisitId);
            sessionStorage.setItem('SOP_RS', opSerName);
            sessionStorage.setItem('SOP_RN', opNumber);
            sessionStorage.setItem('SOP_PI', patientId);
            sessionStorage.setItem('SOP_DO', dob);
            sessionStorage.setItem('SOP_BG', bloodGroup);
            sessionStorage.setItem('SOP_PN', patientName);
            sessionStorage.setItem('SOP_GE', gender);
            sessionStorage.setItem('SOP_IP', ipNumber);
            sessionStorage.setItem('SOP_PH', (contact || '') + '##' + (email || ''));
            window.open('../Revisit/LabResult?from=SOPWorkSheet', '_blank');
        }

        $.ajax({
            type: 'POST',
            url: '../Revisit/HMS_RevisitIdSearch',
            data: {
                Status: revisitId,
                DeptId: (typeof ERPDeptId !== 'undefined' ? ERPDeptId : 0)
            },
            success: function (data) {
                var pat = null;
                if (Array.isArray(data) && data.length > 0) pat = data[0];
                if (pat) {
                    doRedirect(pat.DOB || '', pat.BloodGroup || '', pat.Gender || (p.Gender || ''), pat.Contact || (p.Contact || ''), pat.Add3 || '');
                } else {
                    doRedirect('', '', p.Gender || '', p.Contact || '', '');
                }
            },
            error: function () {
                doRedirect('', '', p.Gender || '', p.Contact || '', '');
            }
        });
    }

    
    function filterTable(input, tbodyId) {
        var p = paginators[tbodyId];
        if (!p) return;

        var term = input.value.toLowerCase().trim();
        if (!term) {
            p.rows = p.allRows.slice();
        } else {
            p.rows = p.allRows.filter(function (rowHtml) {
                var tmp = document.createElement('div');
                tmp.innerHTML = rowHtml;
                return tmp.textContent.toLowerCase().indexOf(term) > -1;
            });
        }
        p.currentPage = 1;
        renderPage(tbodyId);
    }

  function goCS(pid, vid) {
    sessionStorage.setItem('PatientId', pid);
    sessionStorage.setItem('VisitId', vid);
    window.open('@Url.Action("CaseSheet","Hospital", new { from = "OPWorkSheet_D" })', '_blank');
}

    $(function () {
        $('#FromDateInput, #ToDateInput').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            locale: { format: 'DD/MM/YYYY' }
        });

        var today = fmtDMY(new Date());
        $('#FromDateInput').data('daterangepicker').setStartDate(today);
        $('#FromDateInput').data('daterangepicker').setEndDate(today);
        $('#ToDateInput').data('daterangepicker').setStartDate(today);
        $('#ToDateInput').data('daterangepicker').setEndDate(today);

        refreshAll();
        managePolling();
    });
</script>
