@{
    ViewBag.Title = "DoctorDashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/app_demo/assets/js/Chart.js"></script>

<style>
   
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --indigo: #4F46E5;
        --indigo-dark: #4338CA;
        --indigo-light: #EEF2FF;
        --info: #06B6D4;
        --info-light: #ECFEFF;
        --success: #22C55E;
        --success-light: #F0FDF4;
        --warning: #F59E0B;
        --warning-light: #FFFBEB;
        --danger: #EF4444;
        --danger-light: #FEF2F2;
        --purple: #8B5CF6;
        --purple-light: #F5F3FF;
        --text: #1E293B;
        --sub: #64748B;
        --border: #E7EBF3;
        --bg: #F8FAFC;
        --card: #ffffff;
        --header-h: 76px;
        --radius-lg: 18px;
        --radius-md: 12px;
        --radius-sm: 9px;
        --shadow-sm: 0 1px 3px rgba(15,23,42,.05);
        --shadow-md: 0 6px 20px rgba(15,23,42,.07);
        --shadow-lg: 0 16px 40px rgba(79,70,229,.14);
        --sidenav-w: 264px;
        --sidenav-w-collapsed: 68px;
    }

    html {
        -webkit-text-size-adjust: 100%;
    }

    body {
        background: radial-gradient(1100px 420px at 100% -10%, #EEF2FF 0%, rgba(238,242,255,0) 60%), radial-gradient(900px 380px at -10% 0%, #ECFEFF 0%, rgba(236,254,255,0) 55%), var(--bg);
        font-family: "Rubik", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: var(--text);
        font-size: 15px;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }

    img, svg, canvas {
        max-width: 100%;
    }

 
    .doc-topbar {
        background: #0d9488;
        min-height: 100px;
        display: flex;
        align-items: center;
        padding: 0 32px;
        justify-content: space-between;
        box-shadow: 0 4px 24px rgba(13,148,136,.18);
        position: sticky;
        top: 60px;
        z-index: 950;
        width: calc(100% + 60px);
        margin-left: -30px;
        margin-right: -30px;
        margin-top: -20px;
        margin-bottom: 18px;
        flex-wrap: wrap;
        row-gap: 10px;
    }

        .doc-topbar .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .doc-topbar .brand h1 {
                font-size: 25px;
                font-weight: 800;
                color: #fff;
                letter-spacing: .3px;
                margin: 0;
                text-transform: uppercase;
            }

        .doc-topbar .brand-sub {
            font-size: 13px;
            color: rgba(255,255,255,.85);
            font-weight: 600;
            margin-top: 2px;
        }

    .sidenav-toggle-btn {
        display: none;
        width: 42px;
        height: 42px;
        border-radius: 10px;
        border: 1.5px solid rgba(255,255,255,.4);
        background: rgba(255,255,255,.16);
        color: #fff;
        font-size: 18px;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
    }

        .sidenav-toggle-btn:hover {
            background: rgba(255,255,255,.28);
        }

    .doc-refresh-btn {
        height: 42px;
        padding: 0 20px;
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        background: #e0691f;
        border: 1.5px solid rgba(255,255,255,.4);
        border-radius: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background .15s;
        white-space: nowrap;
    }

        .doc-refresh-btn:hover {
            background: #e0691f;
        }

    
    .doc-filter-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        row-gap: 10px;
    }

    .filter-dropdown-wrap {
        position: relative;
    }

    .doc-filter-btn {
        height: 42px;
        padding: 0 16px;
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        background: rgba(255,255,255,.16);
        border: 1.5px solid rgba(255,255,255,.4);
        border-radius: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background .15s;
        white-space: nowrap;
    }

        .doc-filter-btn:hover {
            background: rgba(255,255,255,.28);
        }

    .quick-filter-menu {
        display: none;
        position: absolute;
        top: 48px;
        left: 0;
        background: #fff;
        border-radius: 10px;
        box-shadow: var(--shadow-lg);
        min-width: 170px;
        z-index: 1000;
        overflow: hidden;
    }

        .quick-filter-menu.show {
            display: block;
        }

        .quick-filter-menu a {
            display: block;
            padding: 10px 16px;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--text);
            text-decoration: none;
        }

            .quick-filter-menu a:hover {
                background: #F5F7FF;
                color: teal;
                text-decoration: none;
            }

            .quick-filter-menu a.active-range {
                background: #F5F7FF;
                color: teal;
            }

    .filter-date-group {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .doc-filter-btn,
    .doc-refresh-btn {
        outline: none;
    }

        .doc-filter-btn:focus,
        .doc-refresh-btn:focus,
        .doc-filter-btn:focus-visible,
        .doc-refresh-btn:focus-visible {
            outline: none;
            box-shadow: none;
        }

        .filter-date-group label {
            font-size: 17px;
            color: #fff;
            font-weight: 700;
            letter-spacing: .04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .filter-date-group input[type="text"] {
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
            background: #F1F5FB;
            border: 2px solid teal;
            border-radius: 10px;
            padding: 0 14px;
            height: 40px;
            outline: none;
            cursor: pointer;
            transition: border-color .15s, background .15s, box-shadow .15s;
        }

            .filter-date-group input[type="text"]:focus {
                background: #ffffff;
                border-color: teal;
                box-shadow: 0 0 0 3px rgba(0,128,128,.15);
            }

    .top-alert {
        position: fixed;
        top: 90px;
        left: 50%;
        transform: translateX(-50%);
        background: #ff5c70;
        color: white;
        padding: 14px 35px;
        font-weight: 100;
        font-size: 25px;
        border-radius: 6px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.2);
        display: none;
        z-index: 999999;
    }

    
    .doc-sidenav-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        top: 100px;
        background: rgba(15,23,42,.35);
        z-index: 899;
    }

    .doc-sidenav {
        position: fixed;
        top: 100px;
        height: calc(100vh - 100px);
        left: 0;
        width: 300px;
        background: #ffffff;
        border-right: 1px solid var(--border);
        padding: 18px 14px 20px 14px;
        z-index: 900;
        box-shadow: 2px 0 16px rgba(15,23,42,.03);
        overflow-y: auto;
        border-radius: 0 18px 18px 0;
        transition: transform .25s ease;
    }

    .doc-page {
        margin-left: var(--sidenav-w);
        padding: 20px 24px 30px;
        margin-right: -20px;
        min-height: calc(100vh - 100px);
        max-width: 100%;
        overflow-x: hidden;
    }

    .doc-footer {
        margin-left: var(--sidenav-w);
        display: flex;
        justify-content: space-between;
        padding: 14px 24px;
        font-size: 13.5px;
        color: var(--sub);
        border-top: 1px solid var(--border);
        background: var(--card);
        margin-top: 20px;
        position: relative;
        width: calc(100% + 40px);
        margin-right: -20px;
        flex-wrap: wrap;
        gap: 6px;
    }

    .doc-sidenav .nav-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 13px 16px;
        margin-bottom: 30px;
        color: var(--sub);
        font-size: 20px;
        font-weight: 600;
        text-decoration: none;
        border-radius: var(--radius-sm);
        border-left: 3px solid transparent;
        transition: background .18s, color .18s, transform .12s;
        white-space: nowrap;
    }

        .doc-sidenav .nav-item i {
            display: inline-block;
            width: 20px;
            text-align: center;
            font-size: 15px;
            color: #94A3B8;
            transition: color .18s;
        }

        .doc-sidenav .nav-item:hover {
            background: #F5F7FF;
            color: teal;
            text-decoration: none;
            transform: translateX(2px);
        }

            .doc-sidenav .nav-item:hover i {
                color: teal;
            }

        .doc-sidenav .nav-item.active {
            background: linear-gradient(135deg, var(--indigo-light) 0%, var(--info-light) 100%);
            color: teal;
            border-left: 3px solid teal;
            box-shadow: var(--shadow-sm);
        }

            .doc-sidenav .nav-item.active i {
                color: teal;
            }

   
    .kpi-row {
        display: grid;
        grid-template-columns: repeat(9, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

    .kpi-card {
        border-radius: var(--radius-lg);
        border: none;
        padding: 16px 16px;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: space-between;
        gap: 14px;
        text-align: left;
        box-shadow: 0 8px 20px rgba(15,23,42,.15);
        transition: transform .18s, box-shadow .18s;
        color: #fff;
        opacity: 0;
        animation: flyUp .55s cubic-bezier(.22,.9,.4,1) both;
        min-width: 0;
        cursor: pointer;
    }

    .kpi-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
    }

    .kpi-card:nth-child(1) {
        animation-delay: .03s;
    }

    .kpi-card:nth-child(2) {
        animation-delay: .07s;
    }

    .kpi-card:nth-child(3) {
        animation-delay: .11s;
    }

    .kpi-card:nth-child(4) {
        animation-delay: .15s;
    }

    .kpi-card:nth-child(5) {
        animation-delay: .19s;
    }

    .kpi-card:nth-child(6) {
        animation-delay: .23s;
    }

    .kpi-card:nth-child(7) {
        animation-delay: .27s;
    }

    .kpi-card:nth-child(8) {
        animation-delay: .31s;
    }

    .kpi-card:nth-child(9) {
        animation-delay: .35s;
    }

    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(15,23,42,.22);
    }

    .kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        padding-top: 50px;
        line-height: 1;
        flex-shrink: 0;
    }

    .kpi-label {
        font-size: 16px;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        opacity: .9;
        padding-top: 4px;
        overflow-wrap: break-word;
    }

    .kpi-value {
        font-size: 28px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -.5px;
        font-family: Consolas, "Courier New", monospace;
        text-align: left;
        animation: rollIn .8s cubic-bezier(.23,1.12,.4,1) both;
        animation-delay: .4s;
    }

    .kpi-blue {
        background: linear-gradient(135deg,#212857,#212857);
    }

    .kpi-orange {
        background: linear-gradient(135deg,#D97706,#B45309);
    }

    .kpi-green {
        background: linear-gradient(135deg,#158209,#158209);
    }

    .kpi-purple {
        background: linear-gradient(135deg,#4a1970,#4a1970);
    }

    .kpi-info {
        background: linear-gradient(135deg,#113340,#113340);
    }

    .kpi-amber {
        background: linear-gradient(135deg,#571040, #571040);
    }

    .kpi-pink {
        background: linear-gradient(135deg,#DB2777,#BE185D);
    }

    .kpi-emerald {
        background: linear-gradient(135deg,#195e23,#195e23);
    }

    .kpi-red {
        background: linear-gradient(135deg,#DC2626,#B91C1C);
    }

  
    .charts-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }

    .chart-card {
        background: var(--card);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        padding: 18px 18px 16px;
        box-shadow: var(--shadow-sm);
        transition: box-shadow .2s;
        height: 350px;
        min-width: 0;
    }

        .chart-card:hover {
            box-shadow: var(--shadow-md);
        }

    .chart-card-title {
        font-size: 16px;
        font-weight: 800;
        letter-spacing: .5px;
        text-transform: uppercase;
        color: teal;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chart-wrap {
        position: relative;
        height: 250px;
    }

    .donut-layout {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        height: 300px;
        flex-wrap: wrap;
    }

    .donut-wrap {
        position: relative;
        width: 220px;
        height: 220px;
        flex-shrink: 0;
    }

        .donut-wrap canvas {
            display: block;
            margin: 0 auto;
        }

    .donut-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        text-align: center;
        pointer-events: none;
    }

        .donut-center .dc-val {
            font-size: 28px;
            font-weight: 800;
            color: var(--text);
            letter-spacing: -.5px;
        }

        .donut-center .dc-lbl {
            font-size: 12px;
            color: var(--sub);
            font-weight: 600;
        }

    .legend-list {
        flex: 1;
        display: block;
        min-width: 150px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 10px;
        font-size: 13px;
        padding: 7px 10px;
        border-radius: 10px;
        background: #F8FAFF;
    }

    .legend-dot {
        width: 11px;
        height: 11px;
        border-radius: 4px;
        flex-shrink: 0;
    }

    .legend-name {
        flex: 1;
        color: var(--text);
        font-weight: 600;
    }

    .legend-val {
        font-weight: 800;
        color: var(--text);
    }

    .legend-pct {
        color: var(--sub);
        font-size: 12px;
    }

   
    .tbl-card, .qa-card {
        background: var(--card);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        margin: 0 0 20px 0;
        transition: box-shadow .2s;
        min-width: 0;
    }

        .tbl-card:hover {
            box-shadow: var(--shadow-md);
        }

    .tbl-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 18px;
        background: linear-gradient(135deg, #FAFBFF 0%, #F5F7FF 100%);
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
        gap: 10px;
        position: relative;
    }

    .tbl-title {
        font-size: 20px;
        font-weight: 800;
        letter-spacing: .5px;
        text-transform: uppercase;
        color: #334155;
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
    }

        .tbl-title .cnt-pill {
            font-size: 13.5px;
            font-weight: 800;
            padding: 5px 14px;
            border-radius: 99px;
            background: var(--indigo-light);
            color: var(--indigo-dark);
            margin-left: 6px;
        }

    .pill-group-center {
        display: flex;
        align-items: center;
        gap: 8px;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
    }

    .icon-blue i,
    .icon-orange i,
    .icon-green i,
    .icon-red i,
    .icon-purple i {
        color: teal;
    }

    .tbl-title i {
        font-size: 25px;
    }

    .tbl-search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        border: 1.5px solid var(--border);
        border-radius: 999px;
        padding: 0 14px;
        height: 36px;
        transition: border-color .2s, box-shadow .2s;
        flex: 1 1 170px;
        max-width: 260px;
    }

        .tbl-search-box:focus-within {
            border-color: var(--indigo);
            box-shadow: 0 0 0 3px rgba(79,70,229,.12);
        }

        .tbl-search-box i {
            font-size: 13px;
            color: #A3ADBD;
        }

        .tbl-search-box input[type="text"] {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text);
            font-size: 13.5px;
            font-weight: 500;
            width: 100%;
            min-width: 0;
        }

        .tbl-search-box input::placeholder {
            color: #A3ADBD;
        }

    .tbl-scroll {
        margin: 4px 8px 8px 8px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .tbl-scroll::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }

        .tbl-scroll::-webkit-scrollbar-thumb {
            background: #D6DCEB;
            border-radius: 4px;
        }

        .tbl-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

    .dash-table {
        width: 100%;
        min-width: 700px;
        border-collapse: collapse;
    }

        .dash-table thead th {
            padding: 12px 14px;
            text-align: left;
            font-size: 14.5px;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
            color: #475569;
            border-bottom: 1.5px solid var(--border);
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 2;
            background: #F8FAFF;
        }

        .dash-table tbody tr {
            border-bottom: 1px solid #EEF1F6;
            transition: background .2s, transform .15s;
        }

            .dash-table tbody tr:nth-child(even) {
                background: #FAFBFF;
            }

            .dash-table tbody tr:last-child {
                border-bottom: none;
            }

            .dash-table tbody tr:hover {
                background: var(--indigo-light) !important;
                cursor: pointer;
            }

            .dash-table tbody tr.done-row {
                background: var(--success-light);
            }

                .dash-table tbody tr.done-row:hover {
                    background: #DCFCE7 !important;
                }

        .dash-table tbody td {
            padding: 10px 14px;
            color: #334155;
            white-space: nowrap;
            font-size: 15px;
        }

    #tb-med td {
        padding: 16px 14px;
    }

    .empty-msg {
        text-align: center;
        padding: 20px;
        color: #aaa;
        font-size: 13px;
    }

    .tbl-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px 0;
        font-size: 13px;
        color: var(--sub);
        font-weight: 600;
        flex-wrap: wrap;
    }

        .tbl-toolbar select {
            height: 30px;
            border-radius: 8px;
            border: 1.5px solid var(--border);
            padding: 0 8px;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            background: #fff;
        }

    .tbl-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 18px 14px;
        font-size: 13px;
        color: var(--sub);
        font-weight: 600;
        flex-wrap: wrap;
        gap: 10px;
    }

    .tbl-pagination {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .pg-numbers {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
    }

    .pg-btn, .pg-num {
        height: 32px;
        min-width: 32px;
        padding: 0 10px;
        border-radius: 8px;
        border: 1.5px solid var(--border);
        background: #fff;
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: background .15s, color .15s, border-color .15s;
    }

        .pg-btn:hover:not(:disabled), .pg-num:hover:not(.pg-num-active) {
            background: var(--indigo-light);
            border-color: var(--indigo);
            color: var(--indigo-dark);
        }

        .pg-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    .pg-num-active {
        background: teal;
        border-color: teal;
        color: #fff;
        cursor: default;
    }

    .pg-num-ellipsis {
        height: 32px;
        min-width: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--sub);
        font-size: 13px;
        font-weight: 700;
    }

   
    .badge-new, .badge-revisit, .badge-admit, .badge-discharge,
    .badge-result, .badge-pending, .badge-ready {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 700;
        font-size: 11.5px;
        padding: 5px 12px;
        border-radius: 999px;
        letter-spacing: .2px;
        transition: transform .2s;
    }

        .badge-new::before, .badge-revisit::before, .badge-admit::before, .badge-discharge::before,
        .badge-result::before, .badge-pending::before, .badge-ready::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .badge-new:hover, .badge-revisit:hover, .badge-admit:hover, .badge-discharge:hover,
