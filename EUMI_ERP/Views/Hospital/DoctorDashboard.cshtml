    function drawCaseChart(done, pending, total) {
        var ctx = document.getElementById('c-case').getContext('2d');
        if (chartCase) chartCase.destroy();

        var t = done + pending;
        var donePct = t ? Math.round((done / t) * 100) : 0;
        var pendPct = t ? Math.round((pending / t) * 100) : 0;

        chartCase = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Done Cases', 'Pending Cases'],
                datasets: [{
                    data: t ? [done, pending] : [1],
                    backgroundColor: t ? ['#22C55E', '#EF4444'] : ['#e5e7eb'],
                    borderWidth: 3,
                    borderColor: '#fff',
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                legend: { display: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#fff', borderColor: '#e5e7eb', borderWidth: 1, titleColor: '#111827', bodyColor: '#374151', padding: 12,
                        callbacks: {
                            label: function (ctx) {
                                var tt = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                var p = tt ? Math.round((ctx.raw / tt) * 100) : 0;
                                return ' ' + ctx.label + ': ' + ctx.raw + ' (' + p + '%)';
                            }
                        }
                    }
                },
                animation: { animateRotate: true, duration: 800 }
            }
        });

        var legendHtml = '';
        var labels = ['Done Cases', 'Pending Cases'];
        var colors = ['#22C55E', '#EF4444'];
        var values = [done, pending];
        var pcts = [donePct, pendPct];
        for (var i = 0; i < labels.length; i++) {
            legendHtml += '<div class="legend-item">'
                + '<span class="legend-dot" style="background:' + colors[i] + '"></span>'
                + '<span class="legend-name">' + labels[i] + '</span>'
                + '<span class="legend-val">' + values[i] + '</span>'
                + '<span class="legend-pct">(' + pcts[i] + '%)</span>'
                + '</div>';
        }
        document.getElementById('case-legend-list').innerHTML = legendHtml;
    }

