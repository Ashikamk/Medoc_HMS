    function buildMedAdvice(data) {
        var medRows = [], grouped = {}, order = [];
        for (var i = 0; i < data.length; i++) {
            var d = data[i];
            var key = d.RevisitId ? String(d.RevisitId) : d.PatientName;
            if (!grouped[key]) {
                grouped[key] = {
                    PatientName: d.PatientName || '', RegNo: d.OPNumber || d.RegNo || '—',
                    OPNo: d.RevisitId || d.OPNo || '—', VisitDate: d.RevisitDate || d.VisitDate || '—',
                    Age: d.Age || '—', Sex: d.Gender || d.Sex || '—',
                    Contact: d.Contact || d.Mobile || '—', Doctor: d.DoctorName || d.Doctor || '—',
                    PatientId: d.PatientId || 0, OPSerName: d.OPSerName || '',
                    Medicines: [], TotalCount: 0
                };
                order.push(key);
            }
            grouped[key].TotalCount += parseInt(d.Count || d.Qty || 1);
            var medName = (d.MedicineName || '').trim();
            if (medName) grouped[key].Medicines.push(medName);
        }
        for (var j = 0; j < order.length; j++) {
            var g = grouped[order[j]];
            var uniqueMeds = g.Medicines.filter(function (v, i, a) { return a.indexOf(v) === i; });
            medRows.push('<tr ondblclick="goToInvoice(' + j + ')" style="cursor:pointer">'
                + '<td data-label="Sl No">' + (j + 1) + '</td>'
                + '<td data-label="Reg#">' + g.RegNo + '</td>'
                + '<td data-label="OP#">' + g.OPNo + '</td>'
                + '<td data-label="Date">' + g.VisitDate + '</td>'
                + '<td data-label="Patient" style="font-weight:600">' + g.PatientName + '</td>'
                + '<td data-label="Age/Sex">' + g.Age + ' / ' + g.Sex + '</td>'
                + '<td data-label="Contact">' + g.Contact + '</td>'
                + '<td data-label="Doctor">' + g.Doctor + '</td>'
                + '<td data-label="Medicine">' + (uniqueMeds.length ? uniqueMeds.join(', ') : '—') + '</td>'
                + '</tr>');
        }
        window.medAdviceGrouped = grouped;
        window.medAdviceOrder = order;
        setPaginatorRows('tb-med', medRows, 'No records.');
        $('#sc-medadvice').text(order.length);
    }

