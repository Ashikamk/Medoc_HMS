    function LoadDashboardData(fromDate, toDate) {
        updateChartTitles(fromDate, toDate);
        $.ajax({
            url: '/Hospital/GetPharmacyDashboardData',
            type: 'POST',
            dataType: 'json',
            data: {
                FromDate: fromDate || '',
                ToDate: toDate || ''
            },
            success: function (response) {
                if (response.success && response.oList && response.oList.length > 0) {
                    var d = response.oList[0];

                    $('#totalSales').text(d.TotalSalesInvoices || 0);
                    $('#totalPurchase').text(d.TotalPurchaseInvoices || 0);
                    $('#totalMedicines').text(d.TotalMedicines || 0);
                    $('#shortStock').text(d.ShortStockCount || 0);
                    $('#expiryCount').text(d.ExpiryCount || 0);
                    $('#outOfStock').text(d.OutOfStockCount || 0);
                    $('#fastMoving').text(d.FastMovingCount || 0);
                    $('#nonMoving').text(d.NonMovingCount || 0);

                    var inStock = parseInt(d.InStock) || 0;
                    var shortSt = parseInt(d.ShortStock) || 0;
                    var outOfSt = parseInt(d.OutOfStock) || 0;

                    if (d.SalesInvoicesData) LoadInvoiceTable('#salesInvoiceList', d.SalesInvoicesData, 'sales');
                    else $('#salesInvoiceList').html('<tr><td colspan="7" class="text-center">No data</td></tr>');
                    initTablePaging('salesInvoiceList', 10);

                    if (d.PurchaseInvoicesData) LoadInvoiceTable('#purchaseInvoiceList', d.PurchaseInvoicesData, 'purchase');
                    else $('#purchaseInvoiceList').html('<tr><td colspan="7" class="text-center">No data</td></tr>');
                    initTablePaging('purchaseInvoiceList', 10);

                    BuildChartFromInvoiceData(d.SalesInvoicesData, 'sales');
                    BuildChartFromInvoiceData(d.PurchaseInvoicesData, 'purchase');

                    LoadMedicinesStatusChart([inStock, shortSt, outOfSt]);

                    LoadShortStockTable('#shortStockList', d.ShortStockData);
                    initTablePaging('shortStockList', 10);

                    LoadFastMovingTable('#fastMovingList', d.FastMovingData);
                    initTablePaging('fastMovingList', 10);

                    LoadNonMovingTable('#nonMovingList', d.NonMovingData);
                    initTablePaging('nonMovingList', 10);

                    LoadExpiryTable('#expiryReportList', d.ExpiryData);
                    initTablePaging('expiryReportList', 10);

                    LoadOutOfStockTable('#outOfStockList', d.OutOfStockData);
                    initTablePaging('outOfStockList', 10);

                } else {
                    SetAllError('No data received');
                    LoadEmptyChart('salesTrendChart', 'No data');
                    LoadEmptyChart('purchaseTrendChart', 'No data');
                }
            },
            error: function (xhr) {
                SetAllError('Error: ' + xhr.status);
                LoadEmptyChart('salesTrendChart', 'Error loading data');
                LoadEmptyChart('purchaseTrendChart', 'Error loading data');
            }
        });
    }

    function SetAllError(msg) {
        var ids = ['#salesInvoiceList', '#purchaseInvoiceList', '#shortStockList',
            '#fastMovingList', '#nonMovingList', '#expiryReportList', '#outOfStockList'];
        $.each(ids, function (i, id) {
            $(id).html('<tr><td colspan="8" class="text-center">' + msg + '</td></tr>');
        });
    }

    function BuildChartFromInvoiceData(dataString, type) {
        var dateCounts = {};
        if (dataString && dataString !== '') {
            dataString.split(',').forEach(function (row) {
                var cols = row.split('|');
                var date = (cols[1] || '').trim();
                if (date && date !== '-') {
                    dateCounts[date] = (dateCounts[date] || 0) + 1;
                }
            });
        }

        var labels = Object.keys(dateCounts).sort(function (a, b) {
            return new Date(a) - new Date(b);
        });
        var counts = labels.map(function (d) { return dateCounts[d]; });

        if (type === 'sales') {
            var ctx = document.getElementById('salesTrendChart').getContext('2d');
            if (salesChart) salesChart.destroy();
            if (labels.length === 0) { LoadEmptyChart('salesTrendChart', 'No sales data'); return; }

            salesChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Sales Invoices',
                        data: counts,
                        borderColor: '#4F46E5',
                        backgroundColor: 'rgba(79,70,229,0.15)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#4F46E5',
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 } },
                        x: { ticks: { maxRotation: 45, minRotation: 45, font: { size: 10 } } }
                    },
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return 'Invoices: ' + ctx.parsed.y;
                                }
                            }
                        }
                    }
                }
            });
        } else {
            var ctx2 = document.getElementById('purchaseTrendChart').getContext('2d');
            if (purchaseChart) purchaseChart.destroy();
            if (labels.length === 0) { LoadEmptyChart('purchaseTrendChart', 'No purchase data'); return; }
            purchaseChart = new Chart(ctx2, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Purchase Invoices',
                        data: counts,
                        borderColor: '#DB2777',
                        backgroundColor: 'rgba(219,39,119,0.15)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#DB2777',
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 } },
                        x: { ticks: { maxRotation: 45, minRotation: 45, font: { size: 10 } } }
                    },
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return 'Invoices: ' + ctx.parsed.y;
                                }
                            }
                        }
                    }
                }
            });
        }
    }

    function LoadMedicinesStatusChart(data) {
        var ctx = document.getElementById('medicinesStatusChart').getContext('2d');
        if (medicinesChart) medicinesChart.destroy();
        var parsed = data.map(function (v) { return parseInt(v) || 0; });
        var total = parsed.reduce(function (a, b) { return a + b; }, 0);
        if (total === 0) parsed = [1, 0, 0];
        medicinesChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['In Stock', 'Short Stock', 'Out of Stock'],
                datasets: [{
                    data: parsed,
                    backgroundColor: ['#22C55E', '#F59E0B', '#EF4444'],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { size: 10 } } },
                    tooltip: {
                        callbacks: {
                            label: function (ctx) {
                                var val = ctx.parsed;
                                var sum = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                var pct = sum > 0 ? Math.round(val / sum * 100) : 0;
                                return ctx.label + ': ' + val + ' (' + pct + '%)';
                            }
                        }
                    }
                }
            }
        });
    }

    function LoadEmptyChart(canvasId, message) {
        var ctx = document.getElementById(canvasId).getContext('2d');
        if (canvasId === 'salesTrendChart' && salesChart) { salesChart.destroy(); salesChart = null; }
        if (canvasId === 'purchaseTrendChart' && purchaseChart) { purchaseChart.destroy(); purchaseChart = null; }
        var chart = new Chart(ctx, {
            type: canvasId === 'salesTrendChart' ? 'bar' : 'line',
            data: {
                labels: ['No Data'],
                datasets: [{
                    label: message, data: [0], borderColor: '#ccc',
                    backgroundColor: 'rgba(200,200,200,0.1)', borderWidth: 1
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: true,
                plugins: { legend: { position: 'top' }, tooltip: { enabled: false } }
            }
        });
        if (canvasId === 'salesTrendChart') salesChart = chart;
        if (canvasId === 'purchaseTrendChart') purchaseChart = chart;
    }

    function LoadInvoiceTable(elementId, dataString, type) {
        var html = '';
        if (dataString) {
            splitRowsSmart(dataString, 7).forEach(function (row, i) {
                row = row.trim();
                if (!row) return;
                var c = row.split('|');
                var invoiceNo = (c[0] || '-').trim(),
                    date = (c[1] || '-').trim(),
                    party = (c[2] || '-').trim(),
                    payType = (c[3] || '-').trim(),
                    user = (c[4] || '-').trim(),
                    seriesId = (c[5] || '1').trim(),
                    billSlNo = (c[6] || '').trim();

                var badge = payType === 'CASH'
                    ? '<span class="status-badge status-good">CASH</span>'
                    : payType === 'UPI'
                        ? '<span class="status-badge status-info">UPI</span>'
                        : '<span class="status-badge status-warning">' + payType + '</span>';

                var btn = type === 'sales'
                    ? '<button class="btn btn-sm" style="background:#4F46E5;color:#fff;" onclick="ViewSalesInvoice(\'' + invoiceNo + '\',\'' + seriesId + '\',\'' + billSlNo + '\')"><i class="fa fa-eye"></i></button>'
                    : '<button class="btn btn-sm" style="background:#0D9488;color:#fff;" onclick="ViewPurchaseInvoice(\'' + invoiceNo + '\',\'' + (c[5] || '0').trim() + '\',\'' + (c[6] || '1').trim() + '\')"><i class="fa fa-eye"></i></button>';

                html += '<tr><td>' + (i + 1) + '</td><td><strong>' + invoiceNo + '</strong></td><td>' + date +
                    '</td><td>' + party + '</td><td>' + badge + '</td><td>' + user +
                    '</td><td style="text-align:center">' + btn + '</td></tr>';
            });
        }
        $(elementId).html(html || '<tr><td colspan="7" class="text-center">No data available</td></tr>');
    }

