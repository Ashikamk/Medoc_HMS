@{
    ViewBag.Title = "Pharmacy Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/app_demo/assets/js/Chart.js"></script>

<style>

    *, *::before, *::after {
        box-sizing: border-box;
    }

    :root {
        --indigo: #4F46E5;
        --indigo-dark: #4338CA;
        --indigo-light: #EEF2FF;
        --info: #06B6D4;
        --info-light: #ECFEFF;
        --success: #22C55E;
        --success-light: #F0FDF4;
        --warning: #F59E0B;
        --warning-light: #FFFBEB;
        --danger: #EF4444;
        --danger-light: #FEF2F2;
        --purple: #8B5CF6;
        --purple-light: #F5F3FF;
        --text: #1E293B;
        --sub: #64748B;
        --border: #E7EBF3;
        --bg: #F8FAFC;
        --card: #ffffff;
        --radius-lg: 18px;
        --radius-md: 12px;
        --radius-sm: 9px;
        --shadow-sm: 0 1px 3px rgba(15,23,42,.05);
        --shadow-md: 0 6px 20px rgba(15,23,42,.07);
        --shadow-lg: 0 16px 40px rgba(79,70,229,.14);
    }

    .top-alert {
        position: fixed;
        top: 90px;
        left: 50%;
        transform: translateX(-50%);
        background: #ff5c70;
        color: white;
        padding: 14px 35px;
        font-weight: 100;
        font-size: 25px;
        border-radius: 6px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.2);
        display: none;
        z-index: 999999;
    }

    .pharm-wrap {
        background: none;
        font-family: "Rubik", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color: var(--text);
        font-size: 15px;
        -webkit-font-smoothing: antialiased;
        margin: -20px -30px -20px -30px;
        padding: 0 30px 30px 0;
    }


    body.modal-open .pharm-wrap,
    body.modal-open .pharm-topbar,
    body.modal-open .pharm-body-flex {
        filter: blur(6px);
        -webkit-filter: blur(6px);
        pointer-events: none;
        user-select: none;
        transition: filter 0.3s ease;
    }

    #SimpleMedModal.show {
        display: flex !important;
        align-items: center;
        justify-content: center;
        filter: none !important;
        -webkit-filter: none !important;
        pointer-events: auto !important;
    }

        #SimpleMedModal.show .modal-dialog,
        #SimpleMedModal.show .modal-content,
        #SimpleMedModal.show * {
            filter: none !important;
            -webkit-filter: none !important;
            pointer-events: auto !important;
        }

    .modal-backdrop.show {
        opacity: 0.7;
        background-color: #000;
    }


    .pharm-topbar {
        background: #008080;
        height: 100px;
        display: flex;
        align-items: center;
        padding: 0 32px;
        position: sticky;
        top: 0;
        box-shadow: 0 4px 24px rgba(79,70,229,.10);
        z-index: 950;
        width: calc(100% + 60px);
        margin: 0 -30px 18px -30px;
        justify-content: space-between;
    }

        .pharm-topbar h1 {
            font-size: 25px;
            font-weight: 800;
            padding-left: 30px;
            color: #ffffff;
            letter-spacing: 2px;
            margin: 0;
        }

    .tbl-controls-top {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        font-size: 13.5px;
        color: var(--sub);
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

        .tbl-controls-top select {
            border: 1.5px solid var(--border);
            border-radius: 6px;
            padding: 3px 8px;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--text);
            outline: none;
        }

    .tbl-controls-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 18px;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
        font-size: 13px;
        color: var(--sub);
    }

    .tbl-pagination {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .tbl-page-btn {
        border: 1px solid var(--border);
        background: #fff;
        color: var(--text);
        font-size: 13px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 6px;
        cursor: pointer;
        transition: background .15s, color .15s;
    }

        .tbl-page-btn:hover:not(:disabled) {
            background: #008080;
            color: white;
        }

        .tbl-page-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

        .tbl-page-btn.active {
            background: #008080;
            color: #fff;
            border-color: #008080;
        }


    .pharm-body-flex {
        display: flex;
        align-items: flex-start;
        width: 100%;
        gap: 20px;
    }

    .pharm-sidenav {
        position: sticky;
        top: 116px;
        align-self: flex-start;
        flex: 0 0 230px;
        width: 230px;
        height: 800px;
        background: #ffffff;
        border-right: 1px solid var(--border);
        padding: 16px 12px 20px 12px;
        z-index: 10;
        box-shadow: 2px 0 16px rgba(15,23,42,.03);
        overflow-y: auto;
        border-radius: 0 18px 18px 0;
    }

        .pharm-sidenav .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 16px;
            margin-bottom: 20px;
            color: #64748B !important;
            font-size: 19px !important;
            font-weight: 600;
            text-decoration: none;
            border-radius: var(--radius-sm);
            border-left: 3px solid transparent;
            transition: background .18s, color .18s, transform .12s;
            white-space: nowrap;
        }

            .pharm-sidenav .nav-item i {
                display: inline-block;
                width: 18px;
                text-align: center;
                font-size: 14px;
                color: #94A3B8;
                transition: color .18s;
            }

            .pharm-sidenav .nav-item:hover {
                background: #F0FDFA;
                color: #0D9488;
                text-decoration: none;
                transform: translateX(2px);
            }

                .pharm-sidenav .nav-item:hover i {
                    color: teal;
                }

            .pharm-sidenav .nav-item.active {
                background: linear-gradient(135deg, #E6FFFA 0%, #CCFBF1 100%);
                color: teal !important;
                border-left: 3px solid #008080;
                box-shadow: var(--shadow-sm);
            }

                .pharm-sidenav .nav-item.active i {
                    color: #008080;
                }

    .pharm-page {
        flex: 1 1 0%;
        min-width: 0;
        width: auto;
        scroll-behavior: smooth;
    }

    .pharm-wrap {
        overflow-x: hidden;
    }

    .pharm-page [id^="sec-"], #pharm-top {
        scroll-margin-top: 110px;
    }

    @@media (max-width:1300px) {
        .pharm-sidenav {
            flex-basis: 64px;
            width: 64px;
            padding: 16px 6px;
        }

            .pharm-sidenav .nav-item {
                justify-content: center;
                padding: 12px 0;
            }

                .pharm-sidenav .nav-item span {
                    display: none;
                }
    }

    @@media (max-width:768px) {
        .pharm-body-flex {
            flex-direction: column;
        }

        .pharm-sidenav {
            display: none;
        }
    }



    .kpi-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .kpi-card {
        border-radius: var(--radius-lg);
        border: none;
        padding: 18px 16px;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        text-align: left;
        gap: 4px;
        box-shadow: 0 8px 20px rgba(15,23,42,.15);
        transition: transform .18s, box-shadow .18s;
        opacity: 0;
        animation: flyUp .55s cubic-bezier(.22,.9,.4,1) both;
        position: relative;
        overflow: hidden;
        color: #ffffff;
        cursor: pointer;
        min-height: 118px;
    }

    .kpi-text {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .kpi-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        color: #ffffff;
        flex-shrink: 0;
    }

    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(15,23,42,.22);
    }

    .kpi-card:nth-child(1) {
        animation-delay: .05s;
    }

    .kpi-card:nth-child(2) {
        animation-delay: .12s;
    }

    .kpi-card:nth-child(3) {
        animation-delay: .19s;
    }

    .kpi-card:nth-child(4) {
        animation-delay: .26s;
    }

    .kpi-card:nth-child(5) {
        animation-delay: .33s;
    }

    .kpi-card:nth-child(6) {
        animation-delay: .40s;
    }

    .kpi-card:nth-child(7) {
        animation-delay: .47s;
    }

    .kpi-card:nth-child(8) {
        animation-delay: .54s;
    }

    .kpi-card:nth-child(9) {
        animation-delay: .61s;
    }

    .kpi-label {
        font-size: 16px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        opacity: .92;
    }

    .kpi-value {
        font-size: 30px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -.5px;
        animation: rollIn .8s cubic-bezier(.23,1.12,.4,1) both;
        animation-delay: .4s;
    }

    .kpi-blue {
        background: linear-gradient(135deg, #6366F1 0%, #4338CA 100%);
    }

    .kpi-teal {
        background: linear-gradient(135deg, #DB2777 0%, #831843 100%);
    }

    .kpi-cyan {
        background: linear-gradient(135deg, #06B6D4 0%, #0E7490 100%);
    }

    .kpi-rose {
        background: linear-gradient(135deg, #F97316 0%, #C2410C 100%);
    }

    .kpi-purple {
        background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%);
    }

    .kpi-orange {
        background: linear-gradient(135deg, #7C3AED 0%, #4C1D95 100%);
    }

    .kpi-crimson {
        background: linear-gradient(135deg, #16A34A 0%, #065F46 100%);
    }

    .kpi-green {
        background: linear-gradient(135deg, #1E1B3A 0%, #0F0D24 100%);
    }

    .kpi-indigo {
        background: linear-gradient(135deg, #A21CAF 0%, #581C5C 100%);
    }

    @@keyframes flyUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes rollIn {
        from {
            opacity: 0;
            transform: scale(.5);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }



    .charts-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }

    .chart-card {
        background: var(--card);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        padding: 18px 18px 16px;
        box-shadow: var(--shadow-sm);
        transition: box-shadow .2s;
    }

        .chart-card:hover {
            box-shadow: var(--shadow-md);
        }

    .chart-card-title {
        font-size: 16px;
        font-weight: 800;
        letter-spacing: .7px;
        text-transform: uppercase;
        color: #0F766E;
        margin-bottom: 14px;
        border-left: 4px solid #008080;
        padding-left: 10px;
    }

    .chart-wrap {
        position: relative;
        height: 260px;
    }


    .tbl-card {
        background: var(--card);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
        height: auto;
        max-height: 900px;
        transition: box-shadow .2s;
        animation: fadeInUp .5s ease both;
    }

        .tbl-card:hover {
            box-shadow: var(--shadow-md);
        }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .tbl-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        background: linear-gradient(135deg, #FAFBFF 0%, #F5F7FF 100%);
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .tbl-title {
        font-size: 20px;
        font-weight: 800;
        letter-spacing: .5px;
        text-transform: uppercase;
        color: #334155;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .tbl-title i {
            font-size: 30px;
            color: #008080;
        }



    .tbl-search-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        border: 1.5px solid var(--border);
        border-radius: 999px;
        padding: 0 14px;
        height: 34px;
        transition: border-color .2s, box-shadow .2s;
    }

        .tbl-search-box:focus-within {
            border-color: var(--indigo);
            box-shadow: 0 0 0 3px rgba(79,70,229,.12);
        }

        .tbl-search-box i {
            font-size: 12.5px;
            color: #A3ADBD;
        }

        .tbl-search-box input[type="text"] {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text);
            font-size: 13.5px;
            font-weight: 500;
            width: 150px;
            font-family: "Rubik", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

            .tbl-search-box input[type="text"]::placeholder {
                color: #A3ADBD;
            }

    .tbl-scroll {
        flex: 1;
        overflow: auto;
        -webkit-overflow-scrolling: touch;
    }

        .tbl-scroll::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .tbl-scroll::-webkit-scrollbar-thumb {
            background: #D6DCEB;
            border-radius: 4px;
        }

        .tbl-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

    .dash-table {
        width: 100%;
        border-collapse: collapse;
    }

        .dash-table thead th {
            padding: 8px 14px;
            text-align: left;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: .4px;
            text-transform: uppercase;
            color: #475569;
            border-bottom: 1.5px solid var(--border);
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 2;
            background: #F8FAFF;
        }

        .dash-table tbody tr {
            border-bottom: 1px solid #EEF1F6;
            transition: background .2s, transform .15s;
            height: 32px;
        }

            .dash-table tbody tr:nth-child(even) {
                background: #FAFBFF;
            }

            .dash-table tbody tr:last-child {
                border-bottom: none;
            }

            .dash-table tbody tr:hover {
                background: var(--indigo-light) !important;
            }

        .dash-table tbody td {
            padding: 4px 14px;
            color: #334155;
            font-size: 16px;
            vertical-align: middle;
        }

    .tbl-card.tbl-alert .tbl-header {
        background: linear-gradient(135deg, #FFF7ED 0%, #FEF2F2 100%);
    }

    .tbl-alert-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--danger);
        display: inline-block;
        margin-right: 2px;
        animation: dotPulse 1.2s ease-in-out infinite;
        box-shadow: 0 0 0 0 rgba(239,68,68,.6);
    }

    @@keyframes dotPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(239,68,68,.55);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(239,68,68,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(239,68,68,0);
        }
    }


    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .2px;
    }

        .status-badge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

    .status-critical {
        background: var(--danger-light);
        color: #B91C1C;
        border: 1px solid #FECACA;
    }

        .status-critical::before {
            background: var(--danger);
        }

    .status-warning {
        background: var(--warning-light);
        color: #B45309;
        border: 1px solid #FDE68A;
    }

        .status-warning::before {
            background: var(--warning);
        }

    .status-good {
        background: var(--success-light);
        color: #15803D;
        border: 1px solid #BBF7D0;
    }

        .status-good::before {
            background: var(--success);
        }

    .status-info {
        background: var(--info-light);
        color: #0E7490;
        border: 1px solid #A5F3FC;
    }

        .status-info::before {
            background: var(--info);
        }


    .qa-card {
        background: var(--card);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 180px;
        animation: fadeInUp .5s ease both;
        animation-delay: .3s;
    }

        .qa-card.qa-horizontal {
            height: auto;
        }

    .qa-grid {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
        justify-content: center;
    }

    #sec-quickactions .tbl-title {
        color: #0F766E;
        border-left: 4px solid #008080;
        padding-left: 10px;
    }

        #sec-quickactions .tbl-title i {
            color: #008080;
        }

    .qa-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        border-radius: var(--radius-md);
        padding: 14px 16px;
        text-decoration: none;
        font-weight: 700;
        font-size: 14.5px;
        color: var(--text);
        background: #F8FAFF;
        border: 3px solid var(--border);
        transition: transform .18s, box-shadow .18s, border-color .18s, background .18s;
    }

        .qa-btn:hover {
            transform: translateY(-3px);
            text-decoration: none;
        }

    .qa-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

    .qa-btn.qa-indigo {
        border-color: #C7D2FE;
        color: var(--indigo);
    }

        .qa-btn.qa-indigo:hover {
            background: var(--indigo-light);
            border-color: var(--indigo);
            box-shadow: 0 10px 28px rgba(79,70,229,.22);
        }

        .qa-btn.qa-indigo .qa-icon {
            background: var(--indigo-light);
            color: var(--indigo);
        }

    .qa-btn.qa-success {
        border-color: #BBF7D0;
        color: #15803D;
    }

        .qa-btn.qa-success:hover {
            background: var(--success-light);
            border-color: var(--success);
            box-shadow: 0 10px 28px rgba(34,197,94,.22);
        }

        .qa-btn.qa-success .qa-icon {
            background: var(--success-light);
            color: #15803D;
        }

    .qa-btn.qa-warning {
        border-color: #FDE68A;
        color: #B45309;
    }

        .qa-btn.qa-warning:hover {
            background: var(--warning-light);
            border-color: var(--warning);
            box-shadow: 0 10px 28px rgba(245,158,11,.22);
        }

        .qa-btn.qa-warning .qa-icon {
            background: var(--warning-light);
            color: #B45309;
        }

    .qa-card.qa-horizontal .qa-grid {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        align-items: flex-start;
        gap: 10px;
        padding: 14px 16px;
    }

    .qa-card.qa-horizontal .qa-btn {
        flex: 1 1 220px;
        max-width: 260px;
        min-height: 60px;
        flex-direction: column;
        text-align: center;
        gap: 6px;
        padding: 10px 16px;
    }

        .qa-card.qa-horizontal .qa-btn .qa-icon {
            width: 26px;
            height: 26px;
            font-size: 22px;
        }

        .qa-card.qa-horizontal .qa-btn span {
            font-size: 12.5px;
        }

    .qa-btn.qa-rose {
        border-color: #FECDD3;
        color: #E11D48;
    }

        .qa-btn.qa-rose:hover {
            background: #FFF1F2;
            border-color: #E11D48;
            box-shadow: 0 10px 28px rgba(225,29,72,.22);
        }

    .qa-btn.qa-danger {
        border-color: #FECACA;
        color: var(--danger);
    }

        .qa-btn.qa-danger:hover {
            background: var(--danger-light);
            border-color: var(--danger);
            box-shadow: 0 10px 28px rgba(239,68,68,.22);
        }

    .qa-btn.qa-orange {
        border-color: #FED7AA;
        color: #C2410C;
    }

        .qa-btn.qa-orange:hover {
            background: #FFF7ED;
            border-color: #C2410C;
            box-shadow: 0 10px 28px rgba(194,65,12,.22);
        }

    .qa-btn.qa-cyan {
        border-color: #A5F3FC;
        color: var(--info);
    }

        .qa-btn.qa-cyan:hover {
            background: var(--info-light);
            border-color: var(--info);
            box-shadow: 0 10px 28px rgba(6,182,212,.22);
        }

    .qa-btn.qa-purple {
        border-color: #DDD6FE;
        color: var(--purple);
    }

        .qa-btn.qa-purple:hover {
            background: var(--purple-light);
            border-color: var(--purple);
            box-shadow: 0 10px 28px rgba(139,92,246,.22);
        }


    .row-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .row-9-3 {
        display: grid;
        grid-template-columns: 9fr 3fr;
        gap: 16px;
    }

