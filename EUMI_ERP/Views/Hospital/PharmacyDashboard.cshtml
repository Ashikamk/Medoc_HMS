    function ViewMedicineAdvice(index) {
        var data = window.medicineQueueData[index];
        if (!data) {
            alert('No data available for this entry.');
            return;
        }

        window.currentModalData = data;


        $("#MM_Patient").text(data.PatientName || '-');
        var ageSex = (data.BloodGroup || '').split('##')[0] + ' Yrs / ' + (data.Gender || '-');
        $("#MM_AgeSex").text(ageSex);
        $("#MM_Phone").text(data.Contact || '-');
        $("#MM_RegNo").text((data.OPSerName || '-') + '-' + (data.OPNumber || '-'));
        $("#MM_OPNo").text(data.RevisitId || '-');
        $("#MM_Date").text(data.RevisitDate || '-');
        $("#MM_Time").text(data.DOB || '-');
        $("#MM_Doctor").text(data.DoctorName || '-');


        var medicines = data.MedicineAdvice ? data.MedicineAdvice.split(',') : [];

        var listHtml = '<table style="width:100%; border-collapse:collapse; font-family:Segoe UI,sans-serif;">' +
            '<thead>' +
            '<tr style="background:#EDE9FF; color:#3A2D9A; font-size:14px;">' +
            '<th style="padding:10px 14px; text-align:left; border-bottom:2px solid #C4B8F8;">Medicine</th>' +
            '<th style="padding:10px 14px; text-align:center; border-bottom:2px solid #C4B8F8;">No. of Days</th>' +
            '<th style="padding:10px 14px; text-align:center; border-bottom:2px solid #C4B8F8;">Frequency</th>' +
            '<th style="padding:10px 14px; text-align:center; border-bottom:2px solid #C4B8F8;">Total Tablets</th>' +
            '</tr>' +
            '</thead><tbody>';

        if (medicines.length > 0) {
            medicines.forEach(function (med, idx) {
                var parts = med.trim().split(' | ');
                var medName = parts[0] || med.trim();
                var medDetail = parts[1] || '';

                var tabs = '-', freq = '-', days = '-';
                if (medDetail) {
                    var detailParts = medDetail.split(' - ');
                    tabs = detailParts[0] ? detailParts[0].replace('Tab(s)', '').trim() : '-';
                    if (detailParts[1]) {
                        var freqDays = detailParts[1].split(' x ');
                        freq = freqDays[0] ? freqDays[0].trim() : '-';
                        days = freqDays[1] ? freqDays[1].replace('Day(s)', '').trim() : '-';
                    }
                }

                var rowBg = idx % 2 === 0 ? '#F0EEFF' : '#fff';
                listHtml += '<tr style="background:' + rowBg + '; font-size:16px;">' +
                    '<td style="padding:12px 14px; font-weight:700; color:#3A2D9A;">' + medName + '</td>' +
                    '<td style="padding:12px 14px; text-align:center; font-weight:600; color:#854F0B;">' + days + '</td>' +
                    '<td style="padding:12px 14px; text-align:center; font-weight:600; color:#3B6D11;">' + freq + '</td>' +
                    '<td style="padding:12px 14px; text-align:center; font-weight:600; color:#185FA5;">' + tabs + '</td>' +
                    '</tr>';
            });
        } else {
            listHtml += '<tr><td colspan="4" style="padding:20px; text-align:center; color:#718096;">No medicines advised.</td></tr>';
        }

        listHtml += '</tbody></table>';

        $("#MM_MedicineList").html(listHtml);
        $("#MM_MedCount").text('Total: ' + medicines.length + ' medicines');


        if ($('#SimpleMedModal').data('bs.modal')) {
            $('#SimpleMedModal').modal('dispose');
        }


        $('.modal-backdrop').remove();
        $('body').removeClass('modal-open').css('padding-right', '');


        $('#SimpleMedModal').modal({
            backdrop: true,
            keyboard: true,
            show: true
        });


        setTimeout(function () {
            $('body').addClass('modal-open');
        }, 100);
    }

    function GoToBillFromQueue(index) {
        var data = window.medicineQueueData[index];
        if (!data) {
            alert('No data available for this entry.');
            return;
        }

        var token = 'ws_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);

        sessionStorage.clear();

        sessionStorage.setItem("SI_Token", token);
        sessionStorage.setItem("SI_FromWorksheet", "1");
        sessionStorage.setItem("SI_PatientId", data.PatientId);
        sessionStorage.setItem("SI_OPNumber", data.OPNumber);
        sessionStorage.setItem("SI_OPSeries", data.OPSerName);
        sessionStorage.setItem("SI_RevisitId", data.RevisitId);
        sessionStorage.setItem("SI_PatientName", data.PatientName);
        sessionStorage.setItem("SI_Gender", data.Gender);
        sessionStorage.setItem("SI_Contact", data.Contact);
        sessionStorage.setItem("SI_DoctorId", data.Doctor_Id);
        sessionStorage.setItem("SI_MedAdvice", data.MedicineAdvice);

        window.open("/Hospital/SaleInvoiceHospital?token=" + token, "_blank");
