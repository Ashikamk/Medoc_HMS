<script>
    var salesChart, purchaseChart, medicinesChart;
    var medicineQueueData = [];

    $(document).ready(function () {
        document.title = "Pharmacy Dashboard";
        initSideNav();

        $('#pharm-from-date, #pharm-to-date').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            locale: { format: 'DD/MM/YYYY' }
        });

        var today = getPharmTodayFormatted();
        $('#pharm-from-date').data('daterangepicker').setStartDate(today);
        $('#pharm-from-date').data('daterangepicker').setEndDate(today);
        $('#pharm-to-date').data('daterangepicker').setStartDate(today);
        $('#pharm-to-date').data('daterangepicker').setEndDate(today);

        LoadDashboardData(today, today);
        LoadMedicineQueue();

        setInterval(function () {
            var fromVal = $('#pharm-from-date').val();
            var toVal = $('#pharm-to-date').val();
            if (fromVal && toVal) {
                LoadDashboardData(fromVal, toVal);
            }
            LoadMedicineQueue();
        }, 120000);
    });

    function initSideNav() {
        var navItems = document.querySelectorAll('.pharm-sidenav .nav-item');

        navItems.forEach(function (item) {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                navItems.forEach(function (n) { n.classList.remove('active'); });
                item.classList.add('active');
                showSection(item.getAttribute('data-target'));
            });
        });

        showSection('pharm-top');
    }

    function togglePharmQuickRange(e) {
        e.stopPropagation();
        document.getElementById('pharmQuickRangeMenu').classList.toggle('open');
    }

    document.addEventListener('click', function () {
        var menu = document.getElementById('pharmQuickRangeMenu');
        if (menu) menu.classList.remove('open');
    });

    function formatPharmDMY(d) {
        var dd = (d.getDate() < 10 ? '0' : '') + d.getDate();
        var mm = ((d.getMonth() + 1) < 10 ? '0' : '') + (d.getMonth() + 1);
        return dd + '/' + mm + '/' + d.getFullYear();
    }

    function applyPharmQuickRange(type, e) {
        if (e) e.preventDefault();

        var today = new Date();
        var from, to;

        switch (type) {
            case 'today':
                from = new Date(today); to = new Date(today);
                break;
            case 'yesterday':
                from = new Date(today); from.setDate(today.getDate() - 1);
                to = new Date(from);
                break;
            case 'weekly':
                from = new Date(today); from.setDate(today.getDate() - today.getDay());
                to = new Date(today);
                break;
            case 'monthly':
                from = new Date(today.getFullYear(), today.getMonth(), 1);
                to = new Date(today);
                break;
            case 'lastmonth':
                from = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                to = new Date(today.getFullYear(), today.getMonth(), 0);
                break;
        }

        var fromStr = formatPharmDMY(from);
        var toStr = formatPharmDMY(to);

        var $from = $('#pharm-from-date');
        var $to = $('#pharm-to-date');

        $from.val(fromStr);
        $to.val(toStr);

        if ($from.data('daterangepicker')) {
            $from.data('daterangepicker').setStartDate(fromStr);
            $from.data('daterangepicker').setEndDate(fromStr);
        }
        if ($to.data('daterangepicker')) {
            $to.data('daterangepicker').setStartDate(toStr);
            $to.data('daterangepicker').setEndDate(toStr);
        }

        document.getElementById('pharmQuickRangeMenu').classList.remove('open');
    }

    function pharmDmyToDate(dmy) {
        if (!dmy) return null;
        var p = dmy.split('/');
        if (p.length !== 3) return null;
        return new Date(p[2], p[1] - 1, p[0]);
    }

    function ApplyPharmDateFilter() {
        var f = document.getElementById('pharm-from-date');
        var t = document.getElementById('pharm-to-date');
        if (!f.value || !t.value) { warningshow('Please select both From and To dates.'); return; }
        var fd = pharmDmyToDate(f.value), td = pharmDmyToDate(t.value);
        if (fd && td && fd > td) { warningshow('From date cannot be greater than To date.'); return; }
        LoadDashboardData(f.value, t.value);
        LoadMedicineQueue();
    }

    function warningshow(message, Id) {
        $('#popupmessage').text(message);
        $('#Warningpopup').stop(true, true).show();
        if (Id) { $('#' + Id).focus().select(); }
        clearTimeout(window._warningTimer);
        window._warningTimer = setTimeout(function () {
            $('#Warningpopup').fadeOut();
        }, 3000);
    }

    function getPharmTodayFormatted() {
        var now = new Date();
        var d = (now.getDate() < 10 ? '0' : '') + now.getDate();
        var m = ((now.getMonth() + 1) < 10 ? '0' : '') + (now.getMonth() + 1);
        return d + '/' + m + '/' + now.getFullYear();
    }

    var tablePagers = {};

    function initTablePaging(tbodyId, defaultSize) {
        var tbody = document.getElementById(tbodyId);
        var rows = Array.prototype.filter.call(tbody.getElementsByTagName('tr'), function (r) {
            return r.cells.length > 1;
        });
        tablePagers[tbodyId] = { rows: rows, pageSize: defaultSize || 10, currentPage: 1 };
        renderPage(tbodyId);
    }

    function setPageSize(tbodyId, size) {
        if (!tablePagers[tbodyId]) return;
        tablePagers[tbodyId].pageSize = parseInt(size);
        tablePagers[tbodyId].currentPage = 1;
        renderPage(tbodyId);
    }

    function goToPage(tbodyId, page) {
        tablePagers[tbodyId].currentPage = page;
        renderPage(tbodyId);
    }

    function renderPage(tbodyId) {
        var pager = tablePagers[tbodyId];
        if (!pager) return;
        var tbody = document.getElementById(tbodyId);
        var total = pager.rows.length;
        var pageSize = pager.pageSize;
        var totalPages = Math.max(1, Math.ceil(total / pageSize));
        if (pager.currentPage > totalPages) pager.currentPage = totalPages;

        var start = (pager.currentPage - 1) * pageSize;
        var end = Math.min(start + pageSize, total);

        tbody.innerHTML = '';
        if (total === 0) {
            var colspan = tbody.closest('table').querySelectorAll('thead th').length;
            tbody.innerHTML = '<tr><td colspan="' + colspan + '" class="text-center">No data available</td></tr>';
        } else {
            for (var i = start; i < end; i++) tbody.appendChild(pager.rows[i]);
        }

        var infoEl = document.getElementById(tbodyId + '_info');
        if (infoEl) {
            infoEl.textContent = total === 0
                ? 'Showing 0 to 0 of 0 entries'
                : 'Showing ' + (start + 1) + ' to ' + end + ' of ' + total + ' entries';
        }

        var pagEl = document.getElementById(tbodyId + '_pagination');
        if (pagEl) {
            var html = '<button class="tbl-page-btn" ' + (pager.currentPage === 1 ? 'disabled' : '') +
                ' onclick="goToPage(\'' + tbodyId + '\',' + (pager.currentPage - 1) + ')">Previous</button>';
            for (var p = 1; p <= totalPages; p++) {
                html += '<button class="tbl-page-btn' + (p === pager.currentPage ? ' active' : '') +
                    '" onclick="goToPage(\'' + tbodyId + '\',' + p + ')">' + p + '</button>';
            }
            html += '<button class="tbl-page-btn" ' + (pager.currentPage === totalPages ? 'disabled' : '') +
                ' onclick="goToPage(\'' + tbodyId + '\',' + (pager.currentPage + 1) + ')">Next</button>';
            pagEl.innerHTML = html;
        }
    }

    function showSection(target) {
        var kpiRow = document.querySelector('.kpi-row');
        var chartsRow = document.querySelector('.charts-row');
        var rowSalesPurchase = document.getElementById('row-sales-purchase');
        var rowShortFast = document.getElementById('row-short-fast');
        var rowNonExpiry = document.getElementById('row-non-expiry');
        var rowOutQa = document.getElementById('row-out-qa');
        var secTotalMedicines = document.getElementById('sec-totalmedicines');

        var secSales = document.getElementById('sec-sales');
        var secPurchase = document.getElementById('sec-purchase');
        var secShortStock = document.getElementById('sec-shortstock');
        var secFastMoving = document.getElementById('sec-fastmoving');
        var secNonMoving = document.getElementById('sec-nonmoving');
        var secExpiry = document.getElementById('sec-expiry');
        var secOutOfStock = document.getElementById('sec-outofstock');
        var secQuickActions = document.getElementById('sec-quickactions');
        var secMedicineQueue = document.getElementById('sec-medicinequeue');

        kpiRow.style.display = 'none';
        chartsRow.style.display = 'none';
        rowSalesPurchase.style.display = 'none';
        secTotalMedicines.style.display = 'none';
        rowShortFast.style.display = 'none';
        rowNonExpiry.style.display = 'none';
        rowOutQa.style.display = 'none';
        secMedicineQueue.style.display = 'none';

        [secSales, secPurchase, secShortStock, secFastMoving, secNonMoving, secExpiry, secOutOfStock, secQuickActions]
            .forEach(function (el) { el.style.display = ''; });
        rowSalesPurchase.style.gridTemplateColumns = '';
        rowShortFast.style.gridTemplateColumns = '';
        rowNonExpiry.style.gridTemplateColumns = '';
        rowOutQa.style.gridTemplateColumns = '';
        secQuickActions.classList.remove('qa-horizontal');

        if (target === 'pharm-top') {
            kpiRow.style.display = 'grid';
            chartsRow.style.display = 'grid';
            rowOutQa.style.display = 'grid';
            rowOutQa.style.gridTemplateColumns = '1fr';
            secOutOfStock.style.display = 'none';
            secQuickActions.classList.add('qa-horizontal');
            LoadMedicineQueue();
        } else if (target === 'sec-medicinequeue') {
            secMedicineQueue.style.display = 'block';
            secMedicineQueue.style.width = '100%';
            LoadMedicineQueue();
        } else if (target === 'sec-sales') {
            rowSalesPurchase.style.display = 'grid';
            rowSalesPurchase.style.gridTemplateColumns = '1fr';
            secPurchase.style.display = 'none';
        } else if (target === 'sec-purchase') {
            rowSalesPurchase.style.display = 'grid';
            rowSalesPurchase.style.gridTemplateColumns = '1fr';
            secSales.style.display = 'none';
        } else if (target === 'sec-shortstock') {
            rowShortFast.style.display = 'grid';
            rowShortFast.style.gridTemplateColumns = '1fr';
            secFastMoving.style.display = 'none';
        } else if (target === 'sec-fastmoving') {
            rowShortFast.style.display = 'grid';
            rowShortFast.style.gridTemplateColumns = '1fr';
            secShortStock.style.display = 'none';
        } else if (target === 'sec-nonmoving') {
            rowNonExpiry.style.display = 'grid';
            rowNonExpiry.style.gridTemplateColumns = '1fr';
            secExpiry.style.display = 'none';
        } else if (target === 'sec-expiry') {
            rowNonExpiry.style.display = 'grid';
            rowNonExpiry.style.gridTemplateColumns = '1fr';
            secNonMoving.style.display = 'none';
        } else if (target === 'sec-outofstock') {
            rowOutQa.style.display = 'grid';
            rowOutQa.style.gridTemplateColumns = '1fr';
            secQuickActions.style.display = 'none';
        } else if (target === 'sec-totalmedicines') {
            secTotalMedicines.style.display = 'block';
            secTotalMedicines.style.width = '100%';
            LoadTotalMedicines();
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function LoadTotalMedicines() {
        $.ajax({
            type: "POST",
            url: "../Master/ItemGetAll",
            data: { dummy: 1 },
            success: function (result) {
                LoadTotalMedicinesTable(result);
            },
            error: function (xhr) {
                $('#totalMedicinesList').html('<tr><td colspan="9" class="text-center">Error loading medicines: ' + xhr.status + '</td></tr>');
            }
        });
    }

    function LoadTotalMedicinesTable(result) {
        var html = '';
        if (result && result.length > 0) {
            result.forEach(function (r, i) {
                var statusBadge = (r.Status === 'Active' || r.Status === 1)
                    ? '<span class="status-badge status-good">Active</span>'
                    : '<span class="status-badge status-critical">Inactive</span>';

                var actionBtns =
                    '<button class="btn btn-sm btn-info" onclick="EditMedicineFromDashboard(' + r.ItemId + ',' + (r.GroupId || r.GrpId || 0) + ',' + (r.CategoryId || 0) + ')"><i class="fa fa-edit"></i></button>';

                html += '<tr>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + (r.ItemCode || '-') + '</td>' +
                    '<td>' + (r.Description || '-') + '</td>' +
                    '<td>' + (r.CategoryName || '-') + '</td>' +
                    '<td>' + (r.UnitName || '-') + '</td>' +
                    '<td>' + (r.GrpName || '-') + '</td>' +
                    '<td>' + (r.TaxName || '-') + '</td>' +

                    '<td>' + statusBadge + '</td>' +
                    '<td style="text-align:center;">' + actionBtns + '</td>' +
                    '</tr>';
            });
        } else {
            html = '<tr><td colspan="9" class="text-center">No medicines available</td></tr>';
        }
        $('#totalMedicinesList').html(html);
        initTablePaging('totalMedicinesList', 10);
    }

    function EditMedicineFromDashboard(itemId, groupId, categoryId) {
        if (!itemId) { warningshow('Invalid medicine record'); return; }

        var newTab = window.open('/Pharmacy/Medicine', '_blank');

        var attempts = 0;
        var timer = setInterval(function () {
            attempts++;
            try {
                if (newTab && !newTab.closed &&
                    newTab.document.readyState === 'complete' &&
                    typeof newTab.GetItem === 'function') {
                    clearInterval(timer);
                    setTimeout(function () {
                        newTab.GetItem(itemId, groupId || 0, categoryId || 0);
                    }, 800);
                }
            } catch (e) {
                clearInterval(timer);
            }
            if (attempts > 40) clearInterval(timer);
        }, 500);
    }



    function updateChartTitles(fromDate, toDate) {
