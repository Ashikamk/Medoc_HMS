    function LoadMedicineQueueTable(data) {
        var html = '';
        var pendingCount = 0;

        if (data && data.length > 0) {
            data.forEach(function (r, i) {
                if (r.Status !== 'BILLED') pendingCount++;

                var statusBadge = r.Status === 'BILLED'
                    ? '<span class="status-badge status-good">BILLED</span>'
                    : '<span class="status-badge status-warning">PENDING</span>';

                var ageSex = (r.BloodGroup || '').split('##')[0] + '/' + (r.Gender || '').substring(0, 1);
                if (ageSex === '/') ageSex = '-/-';

                var actionButtons = '<button class="btn btn-sm" style="background:#5B4FCF;color:#fff;" onclick="ViewMedicineAdvice(' + i + ')">' +
                    '<i class="fa fa-eye"></i> View</button>';

                var billButton = '<button class="btn btn-sm btn-info" onclick="GoToBillFromQueue(' + i + ')">' +
                    '<i class="fa fa-file-text"></i> Go to Bill</button>';

                html += '<tr>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + (r.OPSerName || '-') + '-' + (r.OPNumber || '-') + '</td>' +
                    '<td>' + (r.RevisitId || '-') + '</td>' +
                    '<td>' + (r.RevisitDate || '-') + '</td>' +
                    '<td>' + (r.DOB || '-') + '</td>' +
                    '<td>' + (r.PatientName || '-') + '</td>' +
                    '<td>' + ageSex + '</td>' +
                    '<td>' + (r.Contact || '-') + '</td>' +
                    '<td>' + (r.DoctorName || '-') + '</td>' +
                    '<td style="text-align:center;">' + actionButtons + '</td>' +
                    '<td style="text-align:center;">' + billButton + '</td>' +
                    '<td style="text-align:center;">' + statusBadge + '</td>' +
                    '</tr>';
            });

            window.medicineQueueData = data;
            $('#medicineQueueCount').text(pendingCount);
        } else {
            html = '<tr><td colspan="12" class="text-center">No patients in medicine queue</td></tr>';
            $('#medicineQueueCount').text('0');
            window.medicineQueueData = [];
        }

        $('#medicineQueueList').html(html);
        initTablePaging('medicineQueueList', 10);
    }

