    function PrintMedAdvice() {
        var data = window.currentModalData;
        if (!data) return;

        var myWindow = window.open("", "", "width=1500,height=1500");

        var ComapnydivToPrint = document.getElementById("ComapnyImage");
        if (ComapnydivToPrint) {
            $(ComapnydivToPrint).css('height', 100);
            $(ComapnydivToPrint).css('width', 700);
            myWindow.document.write('<table width=100%><tr><td width=100% align=center style=color:#008000;font-weight:bold>' + (ComapnydivToPrint.outerHTML) + '</td></tr></table>');
        }

        myWindow.document.write('<table width=100%><tr><td style="font-family:tahoma;font-size:13px;font-weight:normal;" align=center>PATIENT SUMMARY</td></tr></table>');

        myWindow.document.write('<div style="border:1px solid black;border-radius:10px"><table style="" width=90%><tr><td width=60%><table style="font-family:tahoma;font-size:13px;font-weight:normal;">' +
            '<tr><td>MR-No#</td><td> : </td><td>' + $("#MM_RegNo").text() + '</td></tr>' +
            '<tr><td>Name</td><td> : </td><td>' + $("#MM_Patient").text() + '</td></tr>' +
            '<tr><td>Doctor</td><td> : </td><td>' + $("#MM_Doctor").text() + '</td></tr></table></td>');
        myWindow.document.write('<td width=40% align="right"><table style="font-family:tahoma;font-size:13px;font-weight:normal;">' +
            '<tr><td>OP-No#</td><td> : </td><td>' + $("#MM_OPNo").text() + '</td></tr>' +
            '<tr><td>Age/Sex</td><td> : </td><td>' + $("#MM_AgeSex").text() + '</td></tr>' +
            '<tr><td>Date</td><td> : </td><td>' + $("#MM_Date").text() + '</td></tr></table></td></tr></table></div>');

        var row = '<table style="font-family:tahoma;font-size:13px;font-weight:normal;" width=100%>';
        row += '<tr><td height=10px>&#160;</td></tr><tr style="background-color:#D3D3D3"><td><b>Medicine Details</b></td></tr>';

        var medicines = data.MedicineAdvice ? data.MedicineAdvice.split(',') : [];
        var count = 0;
        medicines.forEach(function (med) {
            var line = med.replace(/\|/g, '').replace(/\s+/g, ' ').trim();
            if (line !== '') {
                count++;
                row += '<tr><td>' + count + '. ' + line + '</td></tr>';
            }
        });
        if (count === 0) {
            row += '<tr><td style="color:#aaa;">No medicines advised.</td></tr>';
        }

        myWindow.document.write(row);
        myWindow.document.write('</table>');

        myWindow.document.write('<table width=100% style="font-family:tahoma;font-size:13px;font-weight:normal;margin-top:60px;">' +
            '<tr><td align="right" style="padding-right:80px;">' + $("#MM_Doctor").text() + '</td></tr></table>');

        if (typeof printFooter === 'function') {
            printFooter(myWindow);
        }
        myWindow.print();
    }

    function splitRowsSmart(dataString, expectedFieldCount) {
        if (!dataString) return [];
        var rawParts = dataString.split(',');
        var rows = [];
        var buffer = '';

        for (var i = 0; i < rawParts.length; i++) {
            buffer = buffer === '' ? rawParts[i] : buffer + ',' + rawParts[i];
            var fieldCount = buffer.split('|').length;

            if (fieldCount >= expectedFieldCount) {
                rows.push(buffer);
                buffer = '';
            }
        }
        if (buffer !== '') rows.push(buffer);

        return rows;
    }

    function ViewSalesInvoice(inv, seriesId, billSlNo) {
        inv = inv.trim();
        seriesId = (seriesId || '1').trim();
        billSlNo = (billSlNo || '').trim();
        window.open('/Hospital/SaleInvoiceHospital?flag=bill&billser=' + seriesId + '&billno=' + billSlNo, '_blank');
    }

    function ViewPurchaseInvoice(inv, slNo, deptId) {
        inv = inv.trim();
        slNo = (slNo || '0').trim();
        deptId = (deptId || '1').trim();

        $.ajax({
            type: "POST",
            url: '/Pharmacy/HMS_PurchaseGetandGets',
            data: { SlNo: slNo, DeptId: deptId },
            success: function (result) {
                if (result && result.length > 0) {
                    var newTab = window.open('/Pharmacy/PharmaPurchase', '_blank');

                    var attempts = 0;
                    var timer = setInterval(function () {
                        attempts++;
                        try {
                            if (newTab && !newTab.closed &&
                                newTab.document.readyState === 'complete') {
                                clearInterval(timer);
                                setTimeout(function () {
                                    newTab.formrefresh(1);
                                    newTab.PurchaseGets(result);
                                }, 1500);
                            }
                        } catch (e) {
                            clearInterval(timer);
                        }
                        if (attempts > 40) clearInterval(timer);
                    }, 500);

                    $.ajax({
                        type: "POST",
                        url: '/Purchase/PurchaseOtherCostGetandGets',
                        data: { SlNo: slNo, DeptId: deptId },
                        success: function (costResult) {
                            if (costResult.dList && costResult.dList.length > 0) {
                                var costTimer = setInterval(function () {
                                    try {
                                        if (newTab && !newTab.closed &&
                                            newTab.document.readyState === 'complete' &&
                                            typeof newTab.ShowOtherCost === 'function') {
                                            clearInterval(costTimer);
                                            setTimeout(function () {
                                                newTab.ShowOtherCost(costResult.dList);
                                            }, 2000);
                                        }
                                    } catch (e) { clearInterval(costTimer); }
                                }, 500);
                            }
                        }
                    });
                }
            },
            error: function (xhr) {
                alert('Failed to load purchase invoice: ' + xhr.status);
            }
        });
    }

    function filterTable(input, tbodyId) {
        var filter = input.value.toLowerCase().trim();
        var rows = document.getElementById(tbodyId).getElementsByTagName('tr');
        var visibleCount = 0;

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            if (row.cells.length === 1) {
                row.style.display = filter === '' ? '' : 'none';
                continue;
            }
            var text = (row.textContent || row.innerText).toLowerCase();
            if (text.indexOf(filter) > -1) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        }

        var tbody = document.getElementById(tbodyId);
        var noResultId = tbodyId + '_noResult';
        var existing = document.getElementById(noResultId);
        if (filter !== '' && visibleCount === 0) {
            if (!existing) {
                var colspan = tbody.closest('table').querySelectorAll('thead th').length;
                var tr = document.createElement('tr');
                tr.id = noResultId;
                tr.innerHTML = '<td colspan="' + colspan + '" class="text-center text-muted" style="padding:12px;">🔍 No matching records found</td>';
                tbody.appendChild(tr);
            }
        } else {
            if (existing) existing.remove();
        }
    }

    function goToSection(target) {
        var navItems = document.querySelectorAll('.pharm-sidenav .nav-item');
        navItems.forEach(function (n) { n.classList.remove('active'); });
        var matchingNav = document.querySelector('.pharm-sidenav .nav-item[data-target="' + target + '"]');
        if (matchingNav) matchingNav.classList.add('active');
        showSection(target);
    }
</script>